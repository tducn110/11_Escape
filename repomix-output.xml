 27:   const renderBackdrop = () => {
 28:     const scene = sceneRef.current;
 29:     const app = appRef.current;
 30:     if (!scene || !app?.renderer) return;
 31: 
 32:     try {
 33:       const currentLayout = layoutRef.current;
 34:       const currentRows = boardRowsRef.current;
 35:       const currentCols = boardColsRef.current;
 36: 
 37:       const totalTiles = currentRows * currentCols;
 38: 
 39:       // Hide all tiles in the pool
 40:       for (const tile of tilePoolRef.current) {
 41:         tile.visible = false;
 42:       }
 43: 
 44:       // The opaque panel keeps the board readable against the bright jungle scene.
 45:       let boardPanel = scene.getChildByLabel("boardPanel") as Graphics | null;
 46:       if (!boardPanel) {
 47:         boardPanel = new Graphics();
 48:         boardPanel.label = "boardPanel";
 49:         boardPanel.zIndex = 0;
 50:         scene.addChild(boardPanel);
 51:       }
 52:       const frameInset = Math.max(2, currentLayout.cellSize * 0.1);
 53:       const frameX = frameInset;
 54:       const frameY = frameInset;
 55:       const frameWidth = currentLayout.stageWidth - frameInset * 2;
 56:       const frameHeight = currentLayout.stageHeight - frameInset * 2;
 57:       const radius = Math.max(8, currentLayout.cellSize * 0.3);
 58: 
 59:       boardPanel.clear();
 60:       boardPanel
 61:         .roundRect(frameX, frameY + Math.max(2, currentLayout.cellSize * 0.08), frameWidth, frameHeight, radius)
 62:         .fill({ color: 0x102f22, alpha: 0.36 });
 63:       boardPanel
 64:         .roundRect(frameX, frameY, frameWidth, frameHeight, radius)
 65:         .fill({ color: 0x315f36, alpha: 0.98 })
 66:         .stroke({ color: 0xb9d36a, width: Math.max(2, currentLayout.cellSize * 0.055), alpha: 0.88 });
 67:       boardPanel
 68:         .roundRect(
 69:           frameX + frameInset,
 70:           frameY + frameInset,
 71:           frameWidth - frameInset * 2,
 72:           frameHeight - frameInset * 2,
 73:           Math.max(5, radius - frameInset),
 74:         )
 75:         .fill({ color: 0x183f29, alpha: 0.82 })
 76:         .stroke({ color: 0x6f9d48, width: Math.max(1, currentLayout.cellSize * 0.03), alpha: 0.8 });
 77: 
 78:       // Keep each generated tile proportional so its leaf relief is never stretched.
 79:       while (tilePoolRef.current.length < totalTiles) {
 80:         tilePoolRef.current.push(new Graphics());
 81:       }
 82:       
 83:       for (let i = 0; i < totalTiles; i++) {
 84:         let tile = tilePoolRef.current[i];
 85:         if (textureRef.current && tile instanceof Graphics) {
 86:           const sprite = new Sprite(textureRef.current);
 87:           sprite.anchor.set(0.5);
 88:           scene.addChild(sprite);
 89:           scene.removeChild(tile);
 90:           tile.destroy();
 91:           tilePoolRef.current[i] = sprite;
 92:         } else if (!textureRef.current && tile instanceof Sprite) {
 93:           const gfx = new Graphics();
 94:           scene.addChild(gfx);
 95:           scene.removeChild(tile);
 96:           tile.destroy();
 97:           tilePoolRef.current[i] = gfx;
 98:         } else if (!tile.parent) {
 99:           scene.addChild(tile);
100:         }
101:       }
102: 
103:       // Generate grid and sort by depth
104:       const grid: Array<{ row: number; col: number }> = [];
105:       for (let row = 0; row < currentRows; row += 1) {
106:         for (let col = 0; col < currentCols; col += 1) {
107:           grid.push({ row, col });
108:         }
109:       }
110: 
111:       grid
112:         .sort((a, b) => a.row + a.col - (b.row + b.col) || a.row - b.row || a.col - b.col)
113:         .forEach(({ row, col }, index) => {
114:           const point = projectIsoPoint(currentLayout, row, col);
115:           const tile = tilePoolRef.current[index];
116: 
117:           if (tile instanceof Graphics) {
118:             tile.clear();
119:             const halfW = currentLayout.tileWidth / 2;
120:             const halfH = currentLayout.tileHeight / 2;
121:             tile
122:               .roundRect(-halfW + 2, -halfH + 2, currentLayout.tileWidth - 4, currentLayout.tileHeight - 4, Math.max(4, currentLayout.cellSize * 0.16))
123:               .fill({ color: 0x6eaf3b, alpha: 0.96 })
124:               .stroke({ color: 0x284a2e, width: 2 });
125:             tile.position.set(point.x, point.y);
126:           } else if (tile instanceof Sprite) {
127:             const tileSize = Math.max(18, currentLayout.cellSize - Math.max(3, currentLayout.cellSize * 0.08));
128:             tile.width = tileSize;
129:             tile.height = tileSize;
130:             tile.position.set(point.x, point.y);
131:           }
132: 
133:           tile.zIndex = 10 + row + col;
134:           tile.visible = true;
135:         });
136: 
137:       app.render();
138:     } catch (err) {
139:       console.error("Failed to render 2D board", err);
140:     }
141:   };
142: 
143:   useEffect(() => {
144:     let disposed = false;
145:     let initCompleted = false;
146:     const host = hostRef.current;
147:     if (!host) return;
148: 
149:     const app = new Application();
150:     appRef.current = app;
151: 
152:     const mount = async () => {
153:       await app.init({
154:         width: layoutRef.current.stageWidth,
155:         height: layoutRef.current.stageHeight,
156:         backgroundAlpha: 0,
157:         antialias: true,
158:         autoDensity: true,
159:         resolution: Math.min(window.devicePixelRatio || 1, 2),
160:         preference: "webgl",
161:         autoStart: false,
162:       });
163:       initCompleted = true;
164: 
165:       if (disposed) {
166:         appRef.current = null;
167:         app.destroy({ removeView: true, releaseGlobalResources: true }, { children: true });
168:         return;
169:       }
170: 
171:       host.appendChild(app.canvas);
172:       app.canvas.style.position = "absolute";
173:       app.canvas.style.inset = "0";
174:       app.canvas.style.width = "100%";
175:       app.canvas.style.height = "100%";
176:       app.canvas.style.pointerEvents = "none";
177:       app.canvas.style.display = "block";
178: 
179:       const scene = new Container();
180:       scene.sortableChildren = true;
181:       sceneRef.current = scene;
182:       app.stage.addChild(scene);
183:       app.renderer.resize(
184:         layoutRef.current.stageWidth,
185:         layoutRef.current.stageHeight
186:       );
187:       
188:       try {
189:         const tex = await Assets.load("/assets/tribe-out/board/leaf-tile.png");
190:         textureRef.current = tex;
191:       } catch (err) {
192:         console.warn("Could not load the leaf tile texture", err);
193:       }
194:       
195:       renderBackdrop();
196:     };
197: 
198:     void mount();
199: 
200:     return () => {
201:       disposed = true;
202:       sceneRef.current = null;
203:       if (initCompleted && appRef.current) {
204:         appRef.current.destroy(
205:           { removeView: true, releaseGlobalResources: true },
206:           { children: true }
207:         );
208:         appRef.current = null;
209:       }
210:     };
211:   }, []);
212: 
213:   useEffect(() => {
214:     const app = appRef.current;
215:     if (!sceneRef.current || !app?.renderer) return;
216: 
217:     app.renderer.resize(layout.stageWidth, layout.stageHeight);
218:     renderBackdrop();
219:   }, [
220:     boardCols,
221:     boardRows,
222:     layout.cellSize,
223:     layout.originX,
224:     layout.originY,
225:     layout.stageHeight,
226:     layout.stageWidth,
227:     layout.stepX,
228:     layout.stepY,
229:     layout.tileHeight,
230:     layout.tileWidth,
231:   ]);
232: 
233:   return (
