 2504: <file path="scripts/solver.ts">
 2505: import { LEVELS } from "../src/features/tribe-out/levels";
 2506: import { canExit } from "../src/features/tribe-out/gameLogic";
 2507: import type { TribeOutEntity } from "../src/features/tribe-out/types";
 2508: 
 2509: function solveLevel(level: typeof LEVELS[0]) {
 2510:   const { boardRows, boardCols, entities } = level;
 2511:   
 2512:   let stateEntities = JSON.parse(JSON.stringify(entities)) as TribeOutEntity[];
 2513:   let solved = false;
 2514:   let steps = 0;
 2515:   
 2516:   while (true) {
 2517:     let movedAny = false;
 2518:     
 2519:     // Simplistic solver without rotate for now, just finds any unit that can escape and escapes it
 2520:     for (const unit of stateEntities) {
 2521:       if (unit.type === "unit" && !unit.escaped) {
 2522:         if (canExit(unit, stateEntities, boardRows, boardCols)) {
 2523:           unit.escaped = true;
 2524:           movedAny = true;
 2525:           steps++;
 2526:           break; // break loop to restart check with updated occupancy
 2527:         }
 2528:       }
 2529:     }
 2530:     
 2531:     const remainingUnits = stateEntities.filter(e => e.type === "unit" && !e.escaped);
 2532:     if (remainingUnits.length === 0) {
 2533:       solved = true;
 2534:       break;
 2535:     }
 2536:     
 2537:     if (!movedAny) {
 2538:       break; // Stuck
 2539:     }
 2540:   }
 2541:   
 2542:   return {
 2543:     id: level.id,
 2544:     solved,
 2545:     units: entities.filter(e => e.type === "unit").length,
 2546:     steps,
 2547:   };
 2548: }
 2549: 
 2550: let unsolvable = 0;
 2551: for (const level of LEVELS) {
 2552:   if (level.id !== 22) continue; // JUST debug level 22
 2553:   const res = solveLevel(level);
 2554:   if (!res.solved) {
 2555:     if (level.id > 5) {
 2556:       console.log(`Level ${level.id} is NOT solvable!`);
 2557:       console.dir(level.entities, { depth: null });
 2558:       unsolvable++;
 2559:     }
 2560:   }
 2561: }
 2562: 
 2563: console.log(`Validation complete. Unsolvable auto-generated levels: ${unsolvable}`);
 2564: </file>
