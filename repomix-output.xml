 69: function compareNode(left: SearchNode, right: SearchNode): number {
 70:   if (left.rotateCount !== right.rotateCount) {
 71:     return left.rotateCount - right.rotateCount;
 72:   }
 73:   if (left.totalActionCount !== right.totalActionCount) {
 74:     return left.totalActionCount - right.totalActionCount;
 75:   }
 76:   return left.stateKey.localeCompare(right.stateKey);
 77: }
