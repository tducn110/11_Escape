 4428:   unlockFromGesture({ removeFallbackListeners = false }: { removeFallbackListeners?: boolean } = {}) {
 4429:     const context = this.ensureContext();
 4430:     if (context?.state === "suspended") {
 4431:       context.resume().catch(() => {});
 4432:     }
 4433: 
 4434:     if (removeFallbackListeners && (!context || context.state === "running")) {
 4435:       this.removeUnlockListeners();
 4436:     }
 4437:   }
