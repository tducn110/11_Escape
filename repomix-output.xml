30: export function getForwardCellsUntilExit(
31:   unit: OrientedEntity,
32:   boardRows: number,
33:   boardCols: number,
34: ): Cell[] {
35:   const cells: Cell[] = [];
36: 
37:   if (unit.direction === "up") {
38:     for (let row = unit.row - 1; row >= 0; row -= 1) {
39:       for (let col = unit.col; col < unit.col + unit.width; col += 1) {
40:         cells.push({ row, col });
41:       }
42:     }
43:   } else if (unit.direction === "down") {
44:     for (let row = unit.row + unit.height; row < boardRows; row += 1) {
45:       for (let col = unit.col; col < unit.col + unit.width; col += 1) {
46:         cells.push({ row, col });
47:       }
48:     }
49:   } else if (unit.direction === "left") {
50:     for (let col = unit.col - 1; col >= 0; col -= 1) {
51:       for (let row = unit.row; row < unit.row + unit.height; row += 1) {
52:         cells.push({ row, col });
53:       }
54:     }
55:   } else if (unit.direction === "right") {
56:     for (let col = unit.col + unit.width; col < boardCols; col += 1) {
57:       for (let row = unit.row; row < unit.row + unit.height; row += 1) {
58:         cells.push({ row, col });
59:       }
60:     }
61:   }
62: 
63:   return cells;
64: }
