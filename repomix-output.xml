 4406:   private readonly handleVisibilityChange = () => {
 4407:     if (typeof document === "undefined") return;
 4408: 
 4409:     if (document.hidden) {
 4410:       if (this.masterBgmGain) this.masterBgmGain.gain.value = 0;
 4411:       if (this.masterSfxGain) this.masterSfxGain.gain.value = 0;
 4412:       if (this.context && this.context.state === "running") {
 4413:         this.context.suspend?.()?.catch(() => {});
 4414:       }
 4415:     } else {
 4416:       if (this.masterBgmGain) this.masterBgmGain.gain.value = this.musicEnabled ? 1 : 0;
 4417:       if (this.masterSfxGain) this.masterSfxGain.gain.value = this.sfxEnabled ? 1 : 0;
 4418:       if (this.context && this.context.state === "suspended") {
 4419:         this.context.resume?.()?.catch(() => {});
 4420:       }
 4421:     }
 4422:   };
