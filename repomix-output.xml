44795: import { useEffect, useRef, useState, type CSSProperties } from "react";
44796: import { GameShell } from "../../components/game/GameShell";
44797: import { Button } from "../../components/shared/Button";
44798: import { useMeasuredElementSize } from "../../components/game/useMeasuredElementSize";
44799: import { TribeOutHUD } from "./TribeOutHUD";
44800: import { TribeOutBoard } from "./TribeOutBoard";
44801: import { WinOverlay, LoseOverlay } from "./TribeOutOverlay";
44802: import {
44803:   buildInitialGameState,
44804:   buildNextLevelState,
44805:   resetLevel,
44806:   applyTapUnit,
44807:   getAvailableUnits,
44808:   applyRotateUnit,
44809: } from "./gameLogic";
44810: import { LEVELS } from "./levels";
44811: import { loadTribeOutProgress, persistTribeOutProgress } from "./tribeOutStorage";
44812: import { tribeOutAudio } from "./audio/tribeOutAudio";
44813: import { IconButton } from "../../components/shared/IconButton";
44814: import { Trophy, Settings, RotateCcw } from "lucide-react";
44815: import { getIsoBoardLayout } from "./isometric";
44816: import "./tribeOut.css";
44817: 
44818: const HUD_ACTION_STYLE: CSSProperties = {
44819:   borderRadius: 8,
44820:   border: "1px solid rgba(255,255,255,0.2)",
44821:   background: "rgba(25, 77, 65, 0.86)",
44822:   color: "#ffffff",
44823:   boxShadow: "0 8px 18px rgba(20, 86, 58, 0.24)",
44824:   backdropFilter: "blur(8px)",
44825: };
44826: 
44827: interface Props {
44828:   isActive?: boolean;
44829:   onBoom?: () => void;
44830:   onDashboard?: () => void;
44831:   onSettings?: () => void;
44832: }
44833: 
44834: export function TribeOutGame({ isActive = true, onBoom, onDashboard, onSettings }: Props = {}) {
44835:   const [gameState, setGameState] = useState(() => {
44836:     const savedProgress = loadTribeOutProgress();
44837:     const savedLevel = savedProgress.currentLevelIndex !== undefined ? savedProgress.currentLevelIndex : savedProgress.highestUnlockedLevel;
44838:     const startLevel = Math.max(0, Math.min(savedLevel, LEVELS.length - 1));
44839:     return buildInitialGameState(startLevel, savedProgress.coins);
44840:   });
44841:   const [bumpingId, setBumpingId] = useState<string | null>(null);
44842:   const [bumpNonce, setBumpNonce] = useState(0);
44843:   const [hintedId, setHintedId] = useState<string | null>(null);
44844:   const bumpTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
44845:   const gameStateRef = useRef(gameState);
44846:   const { ref: boardAreaRef, size: boardAreaSize } = useMeasuredElementSize<HTMLDivElement>();
44847: 
44848:   const level = LEVELS[gameState.currentLevelIndex];
44849:   const layout = getIsoBoardLayout(level.boardRows, level.boardCols, boardAreaSize.width, boardAreaSize.height);
44850: 
44851:   const [isVisible, setIsVisible] = useState(() => typeof document !== 'undefined' ? !document.hidden : true);
44852: 
44853:   useEffect(() => {
44854:     const handleVisibilityChange = () => setIsVisible(!document.hidden);
44855:     document.addEventListener("visibilitychange", handleVisibilityChange);
44856:     return () => document.removeEventListener("visibilitychange", handleVisibilityChange);
44857:   }, []);
44858: 
44859:   useEffect(() => {
44860:     if (gameState.status !== "playing" || gameState.timeRemaining === undefined) return;
44861:     if (!isActive || !isVisible) return;
44862:     
44863:     if (gameState.timeRemaining <= 0) {
44864:       // Just stop decrementing, game does not end
44865:       return;
44866:     }
44867: 
44868:     const timer = setTimeout(() => {
44869:       setGameState(prev => {
44870:         if (prev.status !== "playing" || prev.timeRemaining === undefined || prev.timeRemaining <= 0) {
44871:           return prev;
44872:         }
44873:         const newTime = prev.timeRemaining - 1;
44874:         const nextState = {
44875:           ...prev,
44876:           timeRemaining: newTime,
44877:         };
44878:         gameStateRef.current = nextState as typeof prev;
44879:         return nextState as typeof prev;
44880:       });
44881:     }, 1000);
44882: 
44883:     return () => clearTimeout(timer);
44884:   }, [gameState.status, gameState.timeRemaining, isActive, isVisible]);
44885: 
44886:   useEffect(() => {
44887:     return () => {
44888:       if (bumpTimerRef.current) clearTimeout(bumpTimerRef.current);
44889:     };
44890:   }, []);
44891: 
44892:   const handleTap = (unitId: string) => {
44893:     if (gameState.status !== "playing") return;
44894: 
44895:     if (gameState.selectedTool === "rotate") {
44896:       const nextState = applyRotateUnit(gameState, unitId);
44897:       gameStateRef.current = nextState;
44898:       setGameState(nextState);
44899:       return;
44900:     }
44901: 
44902:     const currentState = gameStateRef.current;
44903:     const savedProgress = loadTribeOutProgress();
44904:     const { nextState, progressSnapshot } = applyTapUnit(unitId, currentState, savedProgress);
44905:     
44906:     gameStateRef.current = nextState;
44907:     setGameState(nextState);
44908: 
44909:     if (currentState.status !== "won" && nextState.status === "won") {
44910:       onBoom?.();
44911:       tribeOutAudio.playWin();
44912:     }
44913: 
44914:     if (progressSnapshot) {
44915:       persistTribeOutProgress(progressSnapshot);
44916:     }
44917: 
44918:     if (nextState.lastBumpedEntityId) {
44919:       if (bumpTimerRef.current) clearTimeout(bumpTimerRef.current);
44920:       setBumpingId(nextState.lastBumpedEntityId);
44921:       setBumpNonce(prev => prev + 1);
44922:       tribeOutAudio.playBump();
44923:       bumpTimerRef.current = setTimeout(() => setBumpingId(null), 700);
44924:     } else if (nextState.escapedCount > currentState.escapedCount) {
44925:       tribeOutAudio.playEscape();
44926:     }
44927:   };
44928: 
44929:   const handleRestart = () => {
44930:     if (bumpTimerRef.current) clearTimeout(bumpTimerRef.current);
44931:     setBumpingId(null);
44932:     const nextState = resetLevel(gameStateRef.current);
44933:     gameStateRef.current = nextState;
44934:     setGameState(nextState);
44935: 
44936:     const savedProgress = loadTribeOutProgress();
44937:     persistTribeOutProgress({
44938:       ...savedProgress,
44939:       coins: nextState.coins,
44940:     });
44941:   };
44942: 
44943:   const handleNextLevel = () => {
44944:     if (bumpTimerRef.current) clearTimeout(bumpTimerRef.current);
44945:     setBumpingId(null);
44946:     setHintedId(null);
44947:     const currentState = gameStateRef.current;
44948:     const nextIndex = (currentState.currentLevelIndex + 1) % LEVELS.length;
44949:     const nextState = buildNextLevelState(currentState, nextIndex);
44950:     
44951:     gameStateRef.current = nextState;
44952:     setGameState(nextState);
44953:     
44954:     const savedProgress = loadTribeOutProgress();
44955:     persistTribeOutProgress({
44956:       ...savedProgress,
44957:       currentLevelIndex: nextIndex,
44958:     });
44959:   };
44960: 
44961:   const handleHint = () => {
44962:     if (gameState.status !== "playing" || hintedId) return;
44963:     const available = getAvailableUnits(gameState, level.boardRows, level.boardCols);
44964:     if (available.length > 0) {
44965:       const targetId = available[Math.floor(Math.random() * available.length)];
44966:       
44967:       const isFree = gameState.hintsUsed === 0;
44968:       if (!isFree && gameState.coins < 50) return;
44969:       
44970:       setGameState(prev => ({
44971:         ...prev,
44972:         coins: isFree ? prev.coins : prev.coins - 50,
44973:         hintsUsed: prev.hintsUsed + 1
44974:       }));
44975:       gameStateRef.current.coins = isFree ? gameState.coins : gameState.coins - 50;
44976:       gameStateRef.current.hintsUsed = gameState.hintsUsed + 1;
44977:       
44978:       setHintedId(targetId);
44979:       setTimeout(() => setHintedId(null), 1500);
44980:     }
44981:   };
44982: 
44983:   const handleRotateToggle = () => {
44984:     if (gameState.status !== "playing" || gameState.rotateCharges <= 0) return;
44985:     setGameState(prev => {
44986:       const isSelected = prev.selectedTool === "rotate";
44987:       const nextState = { ...prev, selectedTool: (isSelected ? "none" : "rotate") as "none" | "rotate" };
44988:       gameStateRef.current = nextState;
44989:       return nextState;
44990:     });
44991:   };
44992: 
44993:   return (
44994:     <div className="tribe-game-root">
44995:       <GameShell
44996:         header={(
44997:           <div className="tribe-game-header">
44998:             <div className="tribe-game-header__top">
44999:               <div className="tribe-game-header__identity">
45000:                 <div className="tribe-game-header__title">
45001:                   Thoát Khỏi Rừng
45002:                 </div>
45003:                 <div className="tribe-game-header__level">
45004:                   Màn {gameState.currentLevelIndex + 1} · 11 Escape
45005:                 </div>
45006:               </div>
45007:               <div className="tribe-game-header__actions">
45008:                 <IconButton label="Thành Tích" onClick={onDashboard} size={42} style={HUD_ACTION_STYLE}>
45009:                   <Trophy size={19} />
45010:                 </IconButton>
45011:                 <IconButton label="Cài đặt" onClick={onSettings} size={42} style={HUD_ACTION_STYLE}>
45012:                   <Settings size={20} />
45013:                 </IconButton>
45014:                 <IconButton label="Chơi lại" onClick={handleRestart} size={42} style={HUD_ACTION_STYLE}>
45015:                   <RotateCcw size={19} />
45016:                 </IconButton>
45017:               </div>
45018:             </div>
45019:             <TribeOutHUD
45020:               level={gameState.currentLevelIndex + 1}
45021:               lives={gameState.lives}
45022:               maxLives={level.lives}
45023:               escapedCount={gameState.escapedCount}
45024:               totalUnits={gameState.totalUnits}
45025:               coins={gameState.coins}
45026:               timeRemaining={gameState.timeRemaining}
45027:             />
45028:           </div>
45029:         )}
45030:         notice={
45031:           level.tutorialText && gameState.escapedCount === 0 && gameState.status === "playing" ? (
45032:             <div className="tribe-tutorial-banner">{level.tutorialText}</div>
45033:           ) : undefined
45034:         }
45035:         controls={
45036:           <div style={{ padding: "0 16px", display: "flex", justifyContent: "center", gap: 16 }}>
45037:             <Button variant="secondary" onClick={handleHint} disabled={gameState.status !== "playing" || hintedId !== null || (gameState.hintsUsed > 0 && gameState.coins < 50)}>
45038:               💡 Gợi ý {gameState.hintsUsed === 0 ? "(Miễn phí)" : "(50 xu)"}
45039:             </Button>
45040:             <Button 
45041:               variant={gameState.selectedTool === "rotate" ? "primary" : "ghost"}
45042:               onClick={handleRotateToggle} 
45043:               disabled={gameState.status !== "playing" || gameState.rotateCharges <= 0}
45044:             >
45045:               🔄 Xoay ({gameState.rotateCharges})
45046:             </Button>
45047:           </div>
45048:         }
45049:         boardAreaRef={boardAreaRef}
45050:         boardAreaStyle={{ position: "relative" }}
45051:       >
45052:         <div className="tribe-board-center" style={{ width: layout.stageWidth, height: layout.stageHeight }}>
45053:           <TribeOutBoard
45054:             entities={gameState.entities}
45055:             boardRows={level.boardRows}
45056:             boardCols={level.boardCols}
45057:             layout={layout}
