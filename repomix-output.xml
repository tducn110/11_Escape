113:     deadEndRisk: { min: 0.08, max: 0.3 },
114:   },
115: };
116: 
117: export function phaseForLevelIndex(index: number): DifficultyPhase {
118:   if (index <= 20) return 1;
119:   if (index <= 40) return 2;
120:   if (index <= 60) return 3;
121:   if (index <= 80) return 4;
122:   return 5;
123: }
124: 
125: function templateIdForPhase(phase: DifficultyPhase): string {
126:   switch (phase) {
127:     case 1:
128:       return "phase1-authored-recovery";
129:     case 2:
130:       return "phase2-structured-dependency";
131:     case 3:
132:       return "phase3-stateful-chain";
133:     case 4:
134:       return "phase4-strategic-combination";
135:     case 5:
136:       return "phase5-expert-causal-planning";
137:   }
138: }
139: 
140: function conceptsForLevel(level: PuzzleLevel, phase: DifficultyPhase): string[] {
141:   const concepts = new Set<string>();
142:   if (level.rotateCharges > 0) concepts.add("rotate");
143:   if (level.entities.some(entity => entity.type === "gate")) concepts.add("gate");
144:   if (level.entities.some(entity => entity.type === "switch")) concepts.add("switch");
145:   if (level.entities.some(entity => entity.type === "obstacle")) concepts.add("obstacle");
146:   if (level.entities.some(entity => entity.type === "unit" && (entity.width > 1 || entity.height > 1))) concepts.add("multi-cell");
147:   concepts.add(`phase-${phase}`);
148:   return [...concepts];
149: }
150: 
151: function intendedOpening(level: PuzzleLevel): PuzzleAction[] {
152:   return listLegalExitActions(level, createInitialPuzzleState(level)).slice(0, 3);
153: }
154: 
155: export function generateManifests(levels: readonly PuzzleLevel[]): readonly LevelAuthoringManifest[] {
156:   return levels.map((level, index) => {
157:     const phase = level.phase ?? phaseForLevelIndex(index + 1);
158:     return {
159:       levelId: level.id,
160:       phase,
161:       sourceKind: phase === 1 ? "authored" : "generated",
162:       generatorVersion: GENERATOR_VERSION,
163:       seed: phase === 1 ? null : `${level.id}:${GENERATOR_VERSION}:0`,
164:       templateId: templateIdForPhase(phase),
165:       concepts: conceptsForLevel(level, phase),
166:       intendedOpening: intendedOpening(level),
167:       rotateRequired: level.rotateCharges > 0,
168:       intentionalDeadEnd: false,
169:       deadEndSignal: null,
170:       timerModel: {
171:         observationAllowanceSeconds: 8,
172:         actionAllowanceSeconds: Math.max(1, Math.ceil(level.timeLimit / Math.max(level.entities.length, 1))),
173:         mobileBufferSeconds: 4,
174:       },
175:       targetBand: PHASE_TARGET_BANDS[phase],
176:       approvedExceptions: [],
177:     };
178:   });
179: }
</file>

