 3863: <file path="src/components/game/useMeasuredElementSize.ts">
 3864: import { useEffect, useRef, useState } from "react";
 3865: 
 3866: interface MeasuredSize {
 3867:   width: number;
 3868:   height: number;
 3869: }
 3870: 
 3871: export function useMeasuredElementSize<T extends HTMLElement>() {
 3872:   const ref = useRef<T | null>(null);
 3873:   const rafRef = useRef(0);
 3874:   const timeoutRef = useRef<number[]>([]);
 3875:   const [size, setSize] = useState<MeasuredSize>({ width: 0, height: 0 });
 3876: 
 3877:   useEffect(() => {
 3878:     const element = ref.current;
 3879:     if (!element) {
 3880:       return;
 3881:     }
 3882: 
 3883:     const applyMeasuredSize = () => {
 3884:       const rect = element.getBoundingClientRect();
 3885:       const width = Math.max(0, Math.floor(rect.width));
 3886:       const height = Math.max(0, Math.floor(rect.height));
 3887: 
 3888:       setSize((current) =>
 3889:         current.width === width && current.height === height ? current : { width, height }
 3890:       );
 3891:     };
 3892: 
 3893:     const scheduleResize = () => {
 3894:       window.cancelAnimationFrame(rafRef.current);
 3895:       timeoutRef.current.forEach((timer) => window.clearTimeout(timer));
 3896:       timeoutRef.current = [];
 3897: 
 3898:       rafRef.current = window.requestAnimationFrame(applyMeasuredSize);
 3899:       timeoutRef.current = [120, 320].map((delay) => window.setTimeout(applyMeasuredSize, delay));
 3900:     };
 3901: 
 3902:     const resizeObserver =
 3903:       typeof ResizeObserver === "undefined" ? null : new ResizeObserver(scheduleResize);
 3904: 
 3905:     resizeObserver?.observe(element);
 3906:     scheduleResize();
 3907: 
 3908:     window.addEventListener("resize", scheduleResize, { passive: true });
 3909:     window.addEventListener("orientationchange", scheduleResize);
 3910:     window.visualViewport?.addEventListener("resize", scheduleResize, { passive: true });
 3911:     window.visualViewport?.addEventListener("scroll", scheduleResize, { passive: true });
 3912: 
 3913:     return () => {
 3914:       resizeObserver?.disconnect();
 3915:       window.cancelAnimationFrame(rafRef.current);
 3916:       timeoutRef.current.forEach((timer) => window.clearTimeout(timer));
 3917:       timeoutRef.current = [];
 3918:       window.removeEventListener("resize", scheduleResize);
 3919:       window.removeEventListener("orientationchange", scheduleResize);
 3920:       window.visualViewport?.removeEventListener("resize", scheduleResize);
 3921:       window.visualViewport?.removeEventListener("scroll", scheduleResize);
 3922:     };
 3923:   }, []);
 3924: 
 3925:   return { ref, size };
 3926: }
 3927: </file>
