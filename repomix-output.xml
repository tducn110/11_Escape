 2894: export function IsometricBoardBackdrop({ layout, boardRows, boardCols }: Props) {
 2895:   const hostRef = useRef<HTMLDivElement | null>(null);
 2896:   const appRef = useRef<Application | null>(null);
 2897:   const sceneRef = useRef<Container | null>(null);
 2898:   const layoutRef = useRef(layout);
 2899:   const boardRowsRef = useRef(boardRows);
 2900:   const boardColsRef = useRef(boardCols);
 2901: 
 2902:   layoutRef.current = layout;
 2903:   boardRowsRef.current = boardRows;
 2904:   boardColsRef.current = boardCols;
 2905: 
 2906:   const renderBackdrop = () => {
 2907:     const scene = sceneRef.current;
 2908:     const app = appRef.current;
 2909:     if (!scene || !app?.renderer) return;
 2910: 
 2911:     const currentLayout = layoutRef.current;
 2912:     const currentRows = boardRowsRef.current;
 2913:     const currentCols = boardColsRef.current;
 2914:     const existingChildren = scene.removeChildren();
 2915:     existingChildren.forEach((child) => child.destroy());
 2916: 
 2917:     const lastPoint = projectIsoPoint(
 2918:       currentLayout,
 2919:       Math.max(0, currentRows - 1),
 2920:       Math.max(0, currentCols - 1)
 2921:     );
 2922:     const shadow = new Graphics()
 2923:       .ellipse(
 2924:         currentLayout.stageWidth / 2,
 2925:         lastPoint.y + currentLayout.cellSize * 0.58,
 2926:         currentLayout.stageWidth * 0.43,
 2927:         currentLayout.cellSize * 0.62
 2928:       )
 2929:       .fill({ color: 0x1f7b45, alpha: 0.24 });
 2930:     shadow.zIndex = 0;
 2931:     scene.addChild(shadow);
 2932: 
 2933:     const grid: Array<{ row: number; col: number }> = [];
 2934:     for (let row = 0; row < currentRows; row += 1) {
 2935:       for (let col = 0; col < currentCols; col += 1) {
 2936:         grid.push({ row, col });
 2937:       }
 2938:     }
 2939: 
 2940:     grid
 2941:       .sort((a, b) => a.row + a.col - (b.row + b.col) || a.row - b.row || a.col - b.col)
 2942:       .forEach(({ row, col }) => {
 2943:         const point = projectIsoPoint(currentLayout, row, col);
 2944:         const tile = createTile(currentLayout, row, col);
 2945:         tile.position.set(point.x, point.y);
 2946:         tile.zIndex = 10 + row + col;
 2947:         scene.addChild(tile);
 2948:       });
 2949: 
 2950:     app.render();
 2951:   };
 2952: 
 2953:   useEffect(() => {
 2954:     let disposed = false;
 2955:     let initCompleted = false;
 2956:     const host = hostRef.current;
 2957:     if (!host) return;
 2958: 
 2959:     const app = new Application();
 2960:     appRef.current = app;
 2961: 
 2962:     const mount = async () => {
 2963:       await app.init({
 2964:         width: layoutRef.current.stageWidth,
 2965:         height: layoutRef.current.stageHeight,
 2966:         backgroundAlpha: 0,
 2967:         antialias: true,
 2968:         autoDensity: true,
 2969:         resolution: Math.min(window.devicePixelRatio || 1, 2),
 2970:         preference: "webgl",
 2971:         autoStart: false,
 2972:       });
 2973:       initCompleted = true;
 2974: 
 2975:       if (disposed) {
 2976:         appRef.current = null;
 2977:         app.destroy({ removeView: true, releaseGlobalResources: true }, { children: true });
 2978:         return;
 2979:       }
 2980: 
 2981:       host.appendChild(app.canvas);
 2982:       app.canvas.style.position = "absolute";
 2983:       app.canvas.style.inset = "0";
 2984:       app.canvas.style.width = "100%";
 2985:       app.canvas.style.height = "100%";
 2986:       app.canvas.style.pointerEvents = "none";
 2987:       app.canvas.style.display = "block";
 2988: 
 2989:       const scene = new Container();
 2990:       scene.sortableChildren = true;
 2991:       sceneRef.current = scene;
 2992:       app.stage.addChild(scene);
 2993:       app.renderer.resize(
 2994:         layoutRef.current.stageWidth,
 2995:         layoutRef.current.stageHeight
 2996:       );
