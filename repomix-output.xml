44092: <file path="src/features/tribe-out/TribeOutEntity.tsx">
44093: import { useState, useEffect, useRef, memo } from "react";
44094: import type { TribeOutEntity, Direction } from "./types";
44095: import { GameSprite } from "./assets/GameSprite";
44096: import type { IsoBoardLayout } from "./isometric";
44097: import { projectIsoEntity } from "./isometric";
44098: 
44099: const ESCAPE_ANIM: Record<Direction, string> = {
44100:   right: "tribeEscapeRight 0.55s ease-out forwards",
44101:   left:  "tribeEscapeLeft 0.55s ease-out forwards",
44102:   up:    "tribeEscapeUp 0.55s ease-out forwards",
44103:   down:  "tribeEscapeDown 0.55s ease-out forwards",
44104: };
44105: 
44106: const BUMP_ANIM: Record<Direction, string> = {
44107:   right: "tribeBumpRight 0.48s ease-out",
44108:   left:  "tribeBumpLeft 0.48s ease-out",
44109:   up:    "tribeBumpUp 0.48s ease-out",
44110:   down:  "tribeBumpDown 0.48s ease-out",
44111: };
44112: 
44113: interface TribeOutEntityProps {
44114:   entity: TribeOutEntity;
44115:   layout: IsoBoardLayout;
44116:   isBumping: boolean;
44117:   bumpNonce?: number;
44118:   isHinted?: boolean;
44119:   onTap: (id: string) => void;
44120: }
44121: 
44122: const DIRECTION_LABELS: Record<Direction, string> = {
44123:   up: "lên trên",
44124:   down: "xuống dưới",
44125:   left: "sang trái",
44126:   right: "sang phải",
44127: };
44128: 
44129: function getEntityAriaLabel(entity: TribeOutEntity): string {
44130:   if (entity.type === "obstacle") {
44131:     return `Chướng ngại vật kích thước ${entity.width}x${entity.height}`;
44132:   }
44133: 
44134:   return `Nhân vật đi ${DIRECTION_LABELS[entity.direction ?? "right"]}, kích thước ${entity.width}x${entity.height}`;
44135: }
44136: 
44137: export const TribeOutEntityComponent = memo(function TribeOutEntityComponent({
44138:   entity,
44139:   layout,
44140:   isBumping,
44141:   bumpNonce = 0,
44142:   isHinted,
44143:   onTap,
44144: }: TribeOutEntityProps) {
44145:   const [animState, setAnimState] = useState<"idle" | "bump" | "escape">("idle");
44146:   const [hidden, setHidden] = useState(entity.escaped);
44147:   
44148:   const prevBumpingRef = useRef(isBumping);
44149:   const prevEscapedRef = useRef(entity.escaped);
44150:   const prevBumpNonceRef = useRef(bumpNonce);
44151:   const innerRef = useRef<HTMLDivElement>(null);
44152: 
44153:   // Detect escape transition and level-reset (escaped → not escaped)
44154:   useEffect(() => {
44155:     if (entity.escaped && !prevEscapedRef.current) {
44156:       setAnimState("escape");
44157:       prevEscapedRef.current = true;
44158:       const t = setTimeout(() => setHidden(true), 580);
44159:       return () => clearTimeout(t);
44160:     } else if (!entity.escaped && prevEscapedRef.current) {
44161:       setHidden(false);
44162:       setAnimState("idle");
44163:       prevEscapedRef.current = false;
44164:     }
44165:   }, [entity.escaped]);
44166: 
44167:   // Detect bump transition
44168:   useEffect(() => {
44169:     const nonceChanged = bumpNonce > 0 && bumpNonce !== prevBumpNonceRef.current;
44170:     if ((isBumping && !prevBumpingRef.current) || nonceChanged) {
44171:       if (innerRef.current) {
44172:         innerRef.current.style.animation = "none";
44173:         void innerRef.current.offsetHeight;
44174:       }
44175:       setAnimState("bump");
44176:       const t = setTimeout(() => setAnimState("idle"), 600);
44177:       prevBumpingRef.current = isBumping;
44178:       prevBumpNonceRef.current = bumpNonce;
44179:       return () => clearTimeout(t);
44180:     }
44181:     prevBumpingRef.current = isBumping;
44182:     prevBumpNonceRef.current = bumpNonce;
44183:   }, [isBumping, bumpNonce]);
44184: 
44185:   if (hidden) return null;
44186: 
44187:   const isObstacle = entity.type === "obstacle";
44188:   const isGate = entity.type === "gate";
44189:   const isSwitch = entity.type === "switch";
44190:   const blocksPointer = isObstacle || isGate;
44191:   const isInteractive = !isObstacle && !isGate;
44192:   
44193:   const dir = entity.direction;
44194:   const projected = projectIsoEntity(layout, entity);
44195:   const size = Math.max(32, Math.round(projected.size));
44196:   const left = Math.round(projected.x - size / 2);
44197:   const top = Math.round(projected.y - size * (blocksPointer ? 0.78 : (isSwitch ? 0.5 : 0.9)));
44198:   const width = size;
44199:   const height = size;
44200: 
44201:   let animation = "";
44202:   if (animState === "escape" && dir) {
44203:     animation = ESCAPE_ANIM[dir];
44204:   } else if (animState === "bump" && dir) {
44205:     animation = BUMP_ANIM[dir];
44206:   } else if (!blocksPointer && !isSwitch) {
44207:     animation = "tribeBreath 2.8s ease-in-out infinite";
44208:   }
44209: 
44210:   const spriteSize = Math.max(24, Math.round(Math.min(width, height) * 0.92));
44211:   const ariaLabel = getEntityAriaLabel(entity);
44212: 
44213:   const handleActivate = () => {
44214:     if (isInteractive) {
44215:       onTap(entity.id);
44216:     }
44217:   };
44218: 
44219:   const handleKeyDown = (event: React.KeyboardEvent<HTMLDivElement>) => {
44220:     if (!isInteractive) {
44221:       return;
44222:     }
44223: 
44224:     if (event.key === "Enter" || event.key === " ") {
44225:       event.preventDefault();
44226:       handleActivate();
44227:     }
44228:   };
44229: 
44230:   let assetKey = entity.assetKey;
44231:   if (isGate) assetKey = entity.open ? "gate-open" : "gate-closed";
44232:   if (isSwitch) assetKey = entity.activated ? "switch-active" : "switch-inactive";
44233: 
44234:   return (
44235:     <div
44236:       style={{
44237:         position: "absolute",
44238:         top,
44239:         left,
44240:         width,
44241:         height,
44242:         zIndex: isSwitch ? projected.zIndex - 10 : projected.zIndex,
44243:         pointerEvents: blocksPointer ? "none" : "auto",
44244:       }}
44245:     >
44246:       <div
44247:         ref={innerRef}
44248:         onClick={handleActivate}
44249:         onKeyDown={handleKeyDown}
44250:         role={!isInteractive ? "img" : "button"}
44251:         aria-label={ariaLabel}
44252:         tabIndex={!isInteractive ? -1 : 0}
44253:         style={{
44254:           width: "100%",
44255:           height: "100%",
44256:           display: "flex",
44257:           alignItems: "center",
44258:           justifyContent: "center",
44259:           cursor: !isInteractive ? "default" : "pointer",
44260:           userSelect: "none",
44261:           WebkitUserSelect: "none",
44262:           animation,
44263:           filter: isHinted ? "drop-shadow(0 0 12px #fff) brightness(1.2)" : "none",
44264:           touchAction: "manipulation",
44265:           outlineOffset: 4,
44266:           transform: "translateZ(0)",
44267:         }}
44268:       >
44269:         <GameSprite 
44270:           assetKey={assetKey}
44271:           isObstacle={blocksPointer}
44272:           isSwitch={isSwitch}
44273:           direction={dir}
44274:           size={spriteSize}
44275:         />
44276:       </div>
44277:     </div>
44278:   );
44279: });
44280: </file>
