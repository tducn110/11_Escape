112: function makeParallelChainsLevel(
113:   index: number,
114:   chainLengths: number[],
115:   options: {
116:     boardRows: number;
117:     boardCols: number;
118:     rotateCharges: number;
119:     obstacleCount?: number;
120:     wideRoot?: boolean;
121:   },
122: ): PuzzleLevel {
123:   const entities: PuzzleEntity[] = [];
124:   const rowGap = chainLengths.length >= 3 ? 2 : 3;
125: 
126:   chainLengths.forEach((length, chainIndex) => {
127:     const row = 1 + chainIndex * rowGap;
128:     const widths = Array.from({ length }, (_, segmentIndex) => {
129:       if (options.wideRoot && chainIndex === 0 && segmentIndex === 0) {
130:         return 2;
131:       }
132:       return 1;
133:     });
134:     entities.push(
135:       ...buildChain({
136:         row,
137:         startCol: 0,
138:         segments: widths.map((width, segmentIndex) => ({ id: `u${chainIndex}_${segmentIndex}`, width })),
139:       }),
140:     );
141:   });
142: 
143:   for (let obstacleIndex = 0; obstacleIndex < (options.obstacleCount ?? 0); obstacleIndex += 1) {
144:     entities.push(obstacle(`o${obstacleIndex}`, 0, options.boardCols - 1 - obstacleIndex));
145:   }
146: 
147:   return createLevel(index, {
148:     boardRows: options.boardRows,
149:     boardCols: options.boardCols,
150:     lives: baseLives(index),
151:     timeLimit: 18 + chainLengths.reduce((sum, value) => sum + value, 0) * 2,
152:     rotateCharges: options.rotateCharges,
153:     entities,
154:   });
155: }
