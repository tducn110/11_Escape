 69:         fill="#9e9282"
 70:         stroke="#6b6154"
 71:         strokeWidth="3"
 72:       />
 73:       <path d="M40 42 Q52 40 60 48" stroke="#6b6154" strokeWidth="2.5" fill="none" strokeLinecap="round" />
 74:       <path d="M34 58 Q46 60 56 56" stroke="#6b6154" strokeWidth="2" fill="none" strokeLinecap="round" opacity="0.6" />
