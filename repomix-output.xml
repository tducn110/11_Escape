1010: /* ══════════════════════════════════════════════════
1011:    END GAME OVERLAY  (WinOverlay / LoseOverlay)
1012:    ══════════════════════════════════════════════════
1013: 
1014:    All asset PNGs share a 1536×1024 canvas.
1015:    Actual artwork alpha bounding boxes (alpha > 128):
1016: 
1017:      khung.png      (139,200)→(1387,826)  1249×627  ratio 1.99  fill 49.8%
1018:      bangten.png    (143,337)→(1385,639)  1243×303  ratio 4.10  fill 23.9%
1019:      sao.png        (523,225)→(1004,690)   482×466  ratio 1.03  fill 14.3%
1020:      continue.png   (201,310)→(1332,673)  1132×364  ratio 3.11  fill 26.2%
1021:      again.png      (259,351)→(1278,633)  1020×283  ratio 3.60  fill 18.4%
1022:      decorate.png   (378,115)→(1039,816)   662×702  ratio 0.94  fill 29.5%
1023:      decorate2.png  (320,197)→(1201,752)   882×556  ratio 1.59  fill 31.2%
1024: 
1025:    Parchment safe-area inside khung: L≈16.7% T≈24% R≈16.5% B≈26.7% of canvas.
1026: 
1027:    Strategy: CSS crop wrappers with overflow:hidden + negative margins
1028:    to remove transparent canvas padding at render time.
1029:    ══════════════════════════════════════════════════ */
1030: 
1031: /* Keyframes */
1032: @keyframes egOverlayIn {
1033:   0%   { opacity: 0; }
1034:   100% { opacity: 1; }
1035: }
1036: 
1037: @keyframes egCardIn {
1038:   0%   { opacity: 0; transform: scale(0.82) translateY(32px); }
1039:   60%  { transform: scale(1.04) translateY(-6px); }
1040:   100% { opacity: 1; transform: scale(1) translateY(0); }
1041: }
1042: 
1043: @keyframes egBannerIn {
1044:   0%   { opacity: 0; transform: translateX(-50%) translateY(-20px) scaleX(0.85); }
1045:   100% { opacity: 1; transform: translateX(-50%) translateY(0) scaleX(1); }
1046: }
1047: 
1048: @keyframes egStarPop {
1049:   0%   { opacity: 0; transform: scale(0) rotate(-20deg); }
1050:   60%  { transform: scale(1.25) rotate(8deg); }
1051:   100% { opacity: 1; transform: scale(1) rotate(0deg); }
1052: }
1053: 
1054: @keyframes egConfettiIn {
1055:   0%   { opacity: 0; transform: scale(0.6); }
1056:   100% { opacity: 1; transform: scale(1); }
1057: }
1058: 
1059: /* ── Overlay backdrop — fixed full-screen ─────────── */
1060: .eg-overlay {
1061:   position: fixed;
1062:   inset: 0;
1063:   display: flex;
1064:   align-items: center;
1065:   justify-content: center;
1066:   background: rgba(18, 32, 12, 0.70);
1067:   backdrop-filter: blur(5px);
1068:   z-index: 100;
1069:   animation: egOverlayIn 0.22s ease forwards;
1070:   padding: 24px 16px;
1071:   box-sizing: border-box;
1072: }
1073: 
1074: .eg-overlay--lose {
1075:   background: rgba(30, 18, 8, 0.72);
1076: }
1077: 
1078: /* ── Card wrapper ─────────────────────────────────── */
1079: /* khung artwork = 81.3% of canvas width → 680px canvas ≈ 553px visible frame */
1080: .eg-card-wrap {
1081:   position: relative;
1082:   z-index: 2;
1083:   width: min(680px, calc(100vw - 32px));
1084:   max-height: calc(100vh - 48px);
1085:   animation: egCardIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
1086:   display: flex;
1087:   flex-direction: column;
1088:   align-items: center;
1089: }
1090: 
1091: /* Confetti burst — anchored to card, not viewport */
1092: .eg-confetti {
1093:   position: absolute;
1094:   bottom: -8%;
1095:   left: 50%;
1096:   transform: translateX(-50%);
1097:   width: 85%;
1098:   pointer-events: none;
1099:   animation: egConfettiIn 0.5s 0.15s ease both;
1100:   z-index: 0;
1101: }
1102: 
1103: /* ── Bamboo frame ─────────────────────────────────── */
1104: .eg-khung {
1105:   position: relative;
1106:   width: 100%;
1107:   margin-top: 28px; /* Space for banner on top */
1108: }
1109: 
1110: /* Crop wrapper: clips transparent canvas padding around khung artwork.
1111:    khung alpha bbox: L=9.05% T=19.5% R=9.7% B=19.3% of canvas.
1112:    Negative margins pull content inward to hide transparent zones. */
1113: .eg-khung__crop {
1114:   overflow: hidden;
1115:   margin: -19.5% -9% -19.3% -9%;
1116: }
1117: 
1118: .eg-khung__img {
1119:   display: block;
1120:   width: 100%;
1121:   height: auto;
1122: }
1123: 
1124: /* Content layer over the frame image.
1125:    Parchment safe-area measured at canvas coords L=16.7% T=24% R=16.5% B=26.7%.
1126:    After crop margins collapse the canvas, we must express these as percentage
1127:    of the CROPPED container (which represents the full canvas still in img flow).
1128:    Since crop uses negative margins on the img (not on this absolute parent),
1129:    the .eg-khung is still sized by the full canvas image.
1130:    So percentages are relative to full canvas. */
1131: .eg-khung__content {
1132:   position: absolute;
1133:   top: 27%;
1134:   left: 18%;
1135:   right: 18%;
1136:   bottom: 22%;
1137:   display: flex;
1138:   flex-direction: column;
1139:   align-items: center;
1140:   justify-content: center;
1141:   gap: 2px;
1142: }
1143: 
1144: /* ── Banner on top of frame ───────────────────────── */
1145: /* bangten alpha bbox: L=9.3% T=32.9% R=9.8% B=37.6% */
1146: .eg-banner {
1147:   position: absolute;
1148:   top: 6px;
1149:   left: 50%;
1150:   transform: translateX(-50%);
1151:   width: 68%;
1152:   display: flex;
1153:   align-items: center;
1154:   justify-content: center;
1155:   animation: egBannerIn 0.38s 0.18s cubic-bezier(0.34, 1.56, 0.64, 1) both;
1156:   pointer-events: none;
1157:   z-index: 10;
1158: }
1159: 
1160: .eg-banner__crop {
1161:   overflow: hidden;
1162:   margin: -32.9% -9.3% -37.6% -9.3%;
1163:   width: 100%;
1164: }
1165: 
1166: .eg-banner__img {
1167:   display: block;
1168:   width: 100%;
1169:   height: auto;
1170: }
1171: 
1172: .eg-banner__text {
1173:   position: absolute;
1174:   top: 44%;
1175:   left: 50%;
1176:   transform: translate(-50%, -50%);
1177:   font-size: clamp(18px, 3.5vw, 28px);
1178:   font-weight: 900;
1179:   color: #ffffff;
1180:   letter-spacing: 0.04em;
1181:   text-transform: uppercase;
1182:   text-shadow:
1183:     0 2px 0 rgba(25, 80, 25, 0.9),
1184:     0 4px 8px rgba(10, 50, 10, 0.4);
1185:   white-space: nowrap;
1186: }
1187: 
1188: /* ── Win title (HOÀN THÀNH!) ──────────────────────── */
1189: .eg-win-title {
1190:   font-size: clamp(22px, 5vw, 38px);
1191:   font-weight: 900;
1192:   color: #7a4a1a;
1193:   text-transform: uppercase;
1194:   text-align: center;
1195:   margin-bottom: 2px;
1196:   line-height: 1.1;
1197:   text-shadow:
1198:     0 2px 0 rgba(255, 220, 150, 0.5),
1199:     0 4px 6px rgba(80, 30, 0, 0.2);
1200: }
1201: 
1202: /* ── Lose title image ─────────────────────────────── */
1203: .eg-lose-title {
1204:   font-size: clamp(36px, 8vw, 56px);
1205:   font-weight: 900;
1206:   color: #ff3333;
