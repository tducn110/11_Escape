 86: export function applyDeterministicExitClosure(level: PuzzleLevel, initialState: PuzzleState): ExitClosureResult {
 87:   let state = initialState;
 88:   const steps: SolveStep[] = [];
 89: 
 90:   while (!isPuzzleComplete(state)) {
 91:     const exits = listLegalExitActions(level, state);
 92:     if (exits.length === 0) {
 93:       break;
 94:     }
 95: 
 96:     const action = exits[0];
 97:     const result = applyPuzzleAction(level, state, action);
 98:     if (!result.accepted) {
 99:       break;
100:     }
101: 
102:     state = result.nextState;
103:     steps.push({
104:       action,
105:       stateKey: getStateKey(state),
106:     });
107:   }
108: 
109:   return { state, steps };
110: }
111: 
112: function verifyReplay(level: PuzzleLevel, steps: SolveStep[], expectedFinalStateKey: string): boolean {
113:   let state = createInitialPuzzleState(level);
114: 
115:   for (const step of steps) {
116:     const result = applyPuzzleAction(level, state, step.action);
117:     if (!result.accepted) {
118:       return false;
119:     }
120:     state = result.nextState;
121:   }
122: 
123:   return isPuzzleComplete(state) && getStateKey(state) === expectedFinalStateKey;
124: }
125: 
126: function buildSolveResult(
127:   level: PuzzleLevel,
128:   status: SolveStatus,
129:   solverPath: SolverPath,
130:   actions: SolveStep[],
131:   diagnostics: SolverDiagnostics,
132:   reason: string | null,
133: ): SolveResult {
134:   const finalStateKey = actions.at(-1)?.stateKey ?? getStateKey(createInitialPuzzleState(level));
135:   const rotateCount = actions.filter(step => step.action.type === "rotate").length;
136:   const cost = status === "SOLVABLE"
137:     ? {
138:         rotateCount,
139:         totalActionCount: actions.length,
140:       }
141:     : null;
142: 
143:   return {
144:     levelId: level.id,
145:     status,
146:     solverPath,
147:     cost,
148:     actions,
149:     finalStateKey: status === "SOLVABLE" ? finalStateKey : null,
150:     diagnostics,
151:     reason,
152:   };
153: }
154: 
155: function solveFromInitialState(
156:   level: PuzzleLevel,
157:   initialState: PuzzleState,
158:   budget: Partial<SolverBudget> = {},
159: ): SolveResult {
160:   const stateBudget = budget.stateBudget ?? DEFAULT_SOLVER_BUDGET.stateBudget;
161:   const timeBudgetMs = budget.timeBudgetMs ?? DEFAULT_SOLVER_BUDGET.timeBudgetMs;
162:   const startedAt = Date.now();
163: 
164:   let exploredStates = 0;
165:   let generatedStates = 0;
166:   let prunedDominatedStates = 0;
167:   let collapsedExitActions = 0;
168:   let frontierPeak = 0;
169: 
170:   const initialClosure = applyDeterministicExitClosure(level, initialState);
171:   collapsedExitActions += initialClosure.steps.length;
172:   exploredStates += 1;
173: 
174:   const baseDiagnostics = (): SolverDiagnostics => ({
175:     exploredStates,
176:     generatedStates,
177:     prunedDominatedStates,
178:     collapsedExitActions,
179:     frontierPeak,
180:     elapsedMs: Date.now() - startedAt,
181:     stateBudget,
182:     timeBudgetMs,
183:   });
184: 
185:   if (isPuzzleComplete(initialClosure.state)) {
186:     const result = buildSolveResult(level, "SOLVABLE", "FAST_EXIT_CLOSURE", initialClosure.steps, baseDiagnostics(), null);
187:     if (!result.finalStateKey || !verifyReplay(level, result.actions, result.finalStateKey)) {
188:       return buildSolveResult(level, "INCONCLUSIVE", "FAST_EXIT_CLOSURE", [], baseDiagnostics(), "replay-verification-failed");
189:     }
190:     return result;
191:   }
192: 
193:   if (initialClosure.state.rotateChargesRemaining <= 0) {
194:     return buildSolveResult(level, "UNSOLVABLE", "FAST_EXIT_CLOSURE", [], baseDiagnostics(), "no-rotate-solution");
195:   }
196: 
197:   const initialKey = getStateKey(initialClosure.state);
198:   const frontier: SearchNode[] = [{
199:     state: initialClosure.state,
200:     stateKey: initialKey,
201:     rotateCount: 0,
202:     totalActionCount: initialClosure.steps.length,
203:     actions: initialClosure.steps,
204:   }];
205:   const bestByState = new Map<string, SolveCost>([
206:     [initialKey, { rotateCount: 0, totalActionCount: initialClosure.steps.length }],
207:   ]);
208: 
209:   while (frontier.length > 0) {
210:     frontier.sort(compareNode);
211:     frontierPeak = Math.max(frontierPeak, frontier.length);
212: 
213:     if (exploredStates >= stateBudget) {
214:       return buildSolveResult(level, "INCONCLUSIVE", "STATEFUL_ROTATE_SEARCH", [], baseDiagnostics(), "state-budget-exhausted");
215:     }
216:     if (Date.now() - startedAt > timeBudgetMs) {
217:       return buildSolveResult(level, "INCONCLUSIVE", "STATEFUL_ROTATE_SEARCH", [], baseDiagnostics(), "time-budget-exhausted");
218:     }
219: 
220:     const current = frontier.shift()!;
221:     exploredStates += 1;
222: 
223:     if (isPuzzleComplete(current.state)) {
224:       const result = buildSolveResult(level, "SOLVABLE", "STATEFUL_ROTATE_SEARCH", current.actions, baseDiagnostics(), null);
225:       if (!result.finalStateKey || !verifyReplay(level, result.actions, result.finalStateKey)) {
226:         return buildSolveResult(level, "INCONCLUSIVE", "STATEFUL_ROTATE_SEARCH", [], baseDiagnostics(), "replay-verification-failed");
227:       }
228:       return result;
229:     }
230: 
231:     for (const action of listLegalRotateActions(current.state)) {
232:       const rotateResult = applyPuzzleAction(level, current.state, action);
233:       generatedStates += 1;
234:       if (!rotateResult.accepted) {
235:         continue;
236:       }
237: 
238:       const closure = applyDeterministicExitClosure(level, rotateResult.nextState);
239:       collapsedExitActions += closure.steps.length;
240:       const nextState = closure.state;
241:       const nextStateKey = getStateKey(nextState);
242:       const nextActions = [
243:         ...current.actions,
244:         { action, stateKey: getStateKey(rotateResult.nextState) },
245:         ...closure.steps,
246:       ];
247:       const nextCost: SolveCost = {
248:         rotateCount: current.rotateCount + 1,
249:         totalActionCount: nextActions.length,
250:       };
251:       const bestKnown = bestByState.get(nextStateKey);
252: 
253:       if (bestKnown && compareCost(bestKnown, nextCost) <= 0) {
254:         prunedDominatedStates += 1;
255:         continue;
256:       }
257: 
258:       bestByState.set(nextStateKey, nextCost);
259:       frontier.push({
260:         state: nextState,
261:         stateKey: nextStateKey,
262:         rotateCount: nextCost.rotateCount,
263:         totalActionCount: nextCost.totalActionCount,
264:         actions: nextActions,
265:       });
266:     }
267:   }
268: 
269:   return buildSolveResult(level, "UNSOLVABLE", "STATEFUL_ROTATE_SEARCH", [], baseDiagnostics(), "search-exhausted");
270: }
271: 
272: export function solveLevel(level: PuzzleLevel, budget: Partial<SolverBudget> = {}): SolveResult {
273:   return solveFromInitialState(level, createInitialPuzzleState(level), budget);
274: }
275: 
276: export function solveFromState(
277:   level: PuzzleLevel,
278:   initialState: PuzzleState,
279:   budget: Partial<SolverBudget> = {},
280: ): SolveResult {
281:   return solveFromInitialState(level, initialState, budget);
282: }
</file>

<file path="scripts/levels/validator.ts">
  1: import type { Direction, PuzzleEntity, PuzzleLevel } from "../../src/features/tribe-out/types";
  2: import { getOccupiedCells, isInsideBoard } from "../../src/features/tribe-out/puzzle";
  3: import type { LevelAuthoringManifest } from "./catalog/manifests";
  4: 
  5: export interface ValidationIssue {
  6:   levelId: PuzzleLevel["id"];
  7:   code: string;
  8:   message: string;
  9:   entityId?: string;
 10: }
 11: 
 12: const DIRECTIONS: readonly Direction[] = ["up", "right", "down", "left"];
 13: const LEVEL_ID_PATTERN = /^level-\d{3}$/;
 14: 
 15: function pushIssue(
 16:   issues: ValidationIssue[],
 17:   levelId: PuzzleLevel["id"],
 18:   code: string,
 19:   message: string,
 20:   entityId?: string,
 21: ): void {
 22:   issues.push({ levelId, code, message, entityId });
 23: }
 24: 
 25: function isInteger(value: unknown): value is number {
 26:   return typeof value === "number" && Number.isInteger(value);
 27: }
 28: 
 29: function validateLevelHeader(level: PuzzleLevel): ValidationIssue[] {
 30:   const issues: ValidationIssue[] = [];
 31: 
 32:   if (!LEVEL_ID_PATTERN.test(level.id)) {
 33:     pushIssue(issues, level.id, "invalid-level-id", `Level id ${level.id} must match level-NNN`);
 34:   }
 35:   if (!isInteger(level.boardRows) || level.boardRows <= 0) {
 36:     pushIssue(issues, level.id, "invalid-board-rows", `Level ${level.id} boardRows must be a positive integer`);
 37:   }
 38:   if (!isInteger(level.boardCols) || level.boardCols <= 0) {
 39:     pushIssue(issues, level.id, "invalid-board-cols", `Level ${level.id} boardCols must be a positive integer`);
 40:   }
 41:   if (!isInteger(level.lives) || level.lives <= 0) {
 42:     pushIssue(issues, level.id, "invalid-lives", `Level ${level.id} lives must be a positive integer`);
 43:   }
 44:   if (!isInteger(level.timeLimit) || level.timeLimit <= 0) {
 45:     pushIssue(issues, level.id, "invalid-time-limit", `Level ${level.id} timeLimit must be a positive integer`);
 46:   }
 47:   if (![1, 2, 3, 4, 5].includes(level.phase)) {
 48:     pushIssue(issues, level.id, "invalid-phase", `Level ${level.id} phase must be 1-5`);
 49:   }
 50:   if (!isInteger(level.rotateCharges) || level.rotateCharges < 0) {
 51:     pushIssue(issues, level.id, "invalid-rotate-charges", `Level ${level.id} rotateCharges must be a non-negative integer`);
 52:   }
 53:   if (!Array.isArray(level.entities) || level.entities.length === 0) {
 54:     pushIssue(issues, level.id, "missing-entities", `Level ${level.id} must contain at least one entity`);
 55:   }
 56: 
 57:   return issues;
 58: }
 59: 
 60: function validateEntityShape(level: PuzzleLevel, entity: PuzzleEntity, gateIds: Set<string>): ValidationIssue[] {
 61:   const issues: ValidationIssue[] = [];
 62: 
 63:   if (!isInteger(entity.row)) {
 64:     pushIssue(issues, level.id, "invalid-row", `Entity ${entity.id} row must be an integer`, entity.id);
 65:   }
 66:   if (!isInteger(entity.col)) {
 67:     pushIssue(issues, level.id, "invalid-col", `Entity ${entity.id} col must be an integer`, entity.id);
 68:   }
 69:   if (!isInteger(entity.width) || entity.width <= 0) {
 70:     pushIssue(issues, level.id, "invalid-width", `Entity ${entity.id} width must be a positive integer`, entity.id);
 71:   }
 72:   if (!isInteger(entity.height) || entity.height <= 0) {
 73:     pushIssue(issues, level.id, "invalid-height", `Entity ${entity.id} height must be a positive integer`, entity.id);
 74:   }
 75: 
 76:   if (entity.type === "unit") {
 77:     if (!DIRECTIONS.includes(entity.direction)) {
 78:       pushIssue(issues, level.id, "invalid-direction", `Unit ${entity.id} has invalid direction`, entity.id);
 79:     }
 80:   }
 81: 
 82:   if (entity.type === "gate" && typeof entity.open !== "boolean") {
 83:     pushIssue(issues, level.id, "invalid-gate-open", `Gate ${entity.id} open must be boolean`, entity.id);
 84:   }
 85: 
 86:   if (entity.type === "switch") {
 87:     if (typeof entity.activated !== "boolean") {
 88:       pushIssue(issues, level.id, "invalid-switch-activated", `Switch ${entity.id} activated must be boolean`, entity.id);
 89:     }
 90:     if (!entity.targetId) {
 91:       pushIssue(issues, level.id, "switch-missing-target", `Switch ${entity.id} has no gate target`, entity.id);
 92:     } else if (!gateIds.has(entity.targetId)) {
 93:       pushIssue(issues, level.id, "switch-target-not-gate", `Switch ${entity.id} targets missing gate ${entity.targetId}`, entity.id);
 94:     }
 95:   }
 96: 
 97:   return issues;
 98: }
 99: 
100: export function validateLevel(level: PuzzleLevel): ValidationIssue[] {
101:   const issues = validateLevelHeader(level);
102:   const seenEntityIds = new Set<string>();
103:   const occupied = new Map<string, string>();
104:   const gateIds = new Set(level.entities.filter(entity => entity.type === "gate").map(entity => entity.id));
105: 
106:   for (const entity of level.entities) {
107:     if (seenEntityIds.has(entity.id)) {
108:       pushIssue(issues, level.id, "duplicate-entity-id", `Duplicate entity id ${entity.id}`, entity.id);
109:     }
110:     seenEntityIds.add(entity.id);
111:     issues.push(...validateEntityShape(level, entity, gateIds));
112: 
113:     const cells = getOccupiedCells(entity);
114:     for (const cell of cells) {
115:       if (!isInsideBoard(cell.row, cell.col, level.boardRows, level.boardCols)) {
116:         pushIssue(
117:           issues,
118:           level.id,
119:           "out-of-bounds",
120:           `Entity ${entity.id} occupies ${cell.row},${cell.col} outside ${level.boardRows}x${level.boardCols}`,
121:           entity.id,
122:         );
123:       }
124: 
125:       const key = `${cell.row},${cell.col}`;
126:       const existing = occupied.get(key);
127:       if (existing && existing !== entity.id) {
128:         pushIssue(issues, level.id, "overlap", `Entity ${entity.id} overlaps ${existing} at ${key}`, entity.id);
129:       } else {
130:         occupied.set(key, entity.id);
131:       }
132:     }
133:   }
134: 
135:   return issues;
136: }
137: 
138: export function validateCatalog(levels: readonly PuzzleLevel[]): ValidationIssue[] {
139:   const issues: ValidationIssue[] = [];
140:   const seenLevelIds = new Set<PuzzleLevel["id"]>();
141: 
142:   if (levels.length !== 100) {
143:     issues.push({
144:       levelId: levels[0]?.id ?? "level-000",
145:       code: "invalid-level-count",
146:       message: `Catalog must contain exactly 100 levels, received ${levels.length}`,
147:     });
148:   }
149: 
150:   for (let index = 0; index < levels.length; index += 1) {
151:     const level = levels[index];
152:     const expectedId = `level-${String(index + 1).padStart(3, "0")}` as PuzzleLevel["id"];
153: 
154:     if (seenLevelIds.has(level.id)) {
155:       pushIssue(issues, level.id, "duplicate-level-id", `Duplicate level id ${String(level.id)}`);
156:     }
157:     seenLevelIds.add(level.id);
158: 
159:     if (level.id !== expectedId) {
160:       pushIssue(issues, level.id, "unexpected-level-order", `Expected ${expectedId} at catalog index ${index}, received ${level.id}`);
161:     }
162:     const expectedPhase = index < 20 ? 1 : index < 40 ? 2 : index < 60 ? 3 : index < 80 ? 4 : 5;
163:     if (level.phase !== expectedPhase) {
164:       pushIssue(issues, level.id, "phase-mismatch", `Expected phase ${expectedPhase} at catalog index ${index}, received ${level.phase}`);
165:     }
166: 
167:     issues.push(...validateLevel(level));
168:   }
169: 
170:   return issues;
171: }
172: 
173: export function validateManifestCatalog(
174:   levels: readonly PuzzleLevel[],
175:   manifests: readonly LevelAuthoringManifest[],
176: ): ValidationIssue[] {
177:   const issues: ValidationIssue[] = [];
178:   const manifestByLevelId = new Map(manifests.map(manifest => [manifest.levelId, manifest] as const));
179: 
180:   if (manifests.length !== levels.length) {
181:     issues.push({
182:       levelId: levels[0]?.id ?? "level-000",
183:       code: "manifest-count-mismatch",
184:       message: `Expected ${levels.length} manifests, received ${manifests.length}`,
185:     });
186:   }
187: 
188:   for (let index = 0; index < levels.length; index += 1) {
189:     const level = levels[index];
190:     const manifest = manifestByLevelId.get(level.id);
191:     if (!manifest) {
192:       issues.push({
193:         levelId: level.id,
194:         code: "manifest-missing",
195:         message: `Missing manifest for ${level.id}`,
196:       });
197:       continue;
198:     }
199: 
200:     if (manifest.levelId !== level.id) {
201:       issues.push({
202:         levelId: level.id,
203:         code: "manifest-level-mismatch",
204:         message: `Manifest levelId ${manifest.levelId} does not match ${level.id}`,
205:       });
206:     }
207: 
208:     const expectedPhase = index < 20 ? 1 : index < 40 ? 2 : index < 60 ? 3 : index < 80 ? 4 : 5;
209:     if (manifest.phase !== expectedPhase) {
210:       issues.push({
211:         levelId: level.id,
212:         code: "manifest-phase-mismatch",
213:         message: `Manifest phase ${manifest.phase} does not match expected phase ${expectedPhase}`,
214:       });
215:     }
216: 
217:     for (const exception of manifest.approvedExceptions) {
218:       if (!exception.reason || !exception.manualEvidenceRequired) {
219:         issues.push({
220:           levelId: level.id,
221:           code: "manifest-exception-invalid",
222:           message: `Manifest exception for ${level.id} must include reason and manual evidence`,
223:         });
224:       }
225:     }
226:   }
227: 
228:   return issues;
229: }
