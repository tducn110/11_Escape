<file path="src/components/game/useMeasuredElementSize.ts">
 1: import { useEffect, useRef, useState } from "react";
 2: 
 3: interface MeasuredSize {
 4:   width: number;
 5:   height: number;
 6: }
 7: 
 8: export function useMeasuredElementSize<T extends HTMLElement>() {
 9:   const ref = useRef<T | null>(null);
10:   const rafRef = useRef(0);
11:   const timeoutRef = useRef<number[]>([]);
12:   const [size, setSize] = useState<MeasuredSize>({ width: 0, height: 0 });
13: 
14:   useEffect(() => {
15:     const element = ref.current;
16:     if (!element) {
17:       return;
18:     }
19: 
20:     const applyMeasuredSize = () => {
21:       const rect = element.getBoundingClientRect();
22:       const width = Math.max(0, Math.floor(rect.width));
23:       const height = Math.max(0, Math.floor(rect.height));
24: 
25:       setSize((current) =>
26:         current.width === width && current.height === height ? current : { width, height }
27:       );
28:     };
29: 
30:     const scheduleResize = () => {
31:       window.cancelAnimationFrame(rafRef.current);
32:       timeoutRef.current.forEach((timer) => window.clearTimeout(timer));
33:       timeoutRef.current = [];
34: 
35:       rafRef.current = window.requestAnimationFrame(applyMeasuredSize);
36:       timeoutRef.current = [120, 320].map((delay) => window.setTimeout(applyMeasuredSize, delay));
37:     };
38: 
39:     const resizeObserver =
40:       typeof ResizeObserver === "undefined" ? null : new ResizeObserver(scheduleResize);
41: 
42:     resizeObserver?.observe(element);
43:     scheduleResize();
44: 
45:     window.addEventListener("resize", scheduleResize, { passive: true });
46:     window.addEventListener("orientationchange", scheduleResize);
47:     window.visualViewport?.addEventListener("resize", scheduleResize, { passive: true });
48:     window.visualViewport?.addEventListener("scroll", scheduleResize, { passive: true });
49: 
50:     return () => {
51:       resizeObserver?.disconnect();
52:       window.cancelAnimationFrame(rafRef.current);
53:       timeoutRef.current.forEach((timer) => window.clearTimeout(timer));
54:       timeoutRef.current = [];
55:       window.removeEventListener("resize", scheduleResize);
56:       window.removeEventListener("orientationchange", scheduleResize);
57:       window.visualViewport?.removeEventListener("resize", scheduleResize);
58:       window.visualViewport?.removeEventListener("scroll", scheduleResize);
59:     };
60:   }, []);
61: 
62:   return { ref, size };
63: }
</file>

