 3370: function createClient(wsUrl) {
 3371:   const socket = new WebSocket(wsUrl);
 3372:   let id = 0;
 3373:   const pending = new Map();
 3374:   const events = new Map();
 3375: 
 3376:   socket.addEventListener("message", (event) => {
 3377:     const message = JSON.parse(event.data.toString());
 3378: 
 3379:     if (typeof message.id === "number") {
 3380:       const resolver = pending.get(message.id);
 3381:       if (!resolver) return;
 3382:       pending.delete(message.id);
 3383:       if (message.error) {
 3384:         resolver.reject(new Error(message.error.message));
 3385:       } else {
 3386:         resolver.resolve(message.result);
 3387:       }
 3388:       return;
 3389:     }
 3390: 
 3391:     const listeners = events.get(message.method) ?? [];
 3392:     for (const listener of listeners) {
 3393:       listener(message.params ?? {});
 3394:     }
 3395:   });
 3396: 
 3397:   const opened = new Promise((resolve, reject) => {
 3398:     socket.addEventListener("open", resolve, { once: true });
 3399:     socket.addEventListener("error", reject, { once: true });
 3400:   });
 3401: 
 3402:   return {
 3403:     socket,
 3404:     opened,
 3405:     on(method, listener) {
 3406:       const listeners = events.get(method) ?? [];
 3407:       listeners.push(listener);
 3408:       events.set(method, listeners);
 3409:     },
 3410:     send(method, params = {}) {
 3411:       const messageId = ++id;
 3412:       const payload = { id: messageId, method, params };
 3413:       return new Promise((resolve, reject) => {
 3414:         pending.set(messageId, { resolve, reject });
 3415:         socket.send(JSON.stringify(payload));
 3416:       });
 3417:     },
 3418:   };
 3419: }
