235:       ref={hostRef}
236:       className="tribe-isometric-backdrop"
237:       style={{
238:         position: "absolute",
239:         inset: 0,
240:         overflow: "visible",
241:         pointerEvents: "none",
242:         zIndex: 0,
243:       }}
244:       aria-hidden="true"
