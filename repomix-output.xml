43230: <file path="src/features/tribe-out/gameLogic.ts">
43231: import type { TribeOutEntity, GameState, TribeOutProgressSnapshot, TribeOutTapResult } from "./types";
43232: import { LEVELS } from "./levels";
43233: 
43234: export function getOccupiedCells(entity: TribeOutEntity): { row: number; col: number }[] {
43235:   const cells: { row: number; col: number }[] = [];
43236:   for (let r = entity.row; r < entity.row + entity.height; r++) {
43237:     for (let c = entity.col; c < entity.col + entity.width; c++) {
43238:       cells.push({ row: r, col: c });
43239:     }
43240:   }
43241:   return cells;
43242: }
43243: 
43244: export function isInsideBoard(row: number, col: number, boardRows: number, boardCols: number): boolean {
43245:   return row >= 0 && row < boardRows && col >= 0 && col < boardCols;
43246: }
43247: 
43248: // Returns a map from "row,col" → entityId for all non-escaped entities.
43249: export function buildOccupancyMap(entities: TribeOutEntity[]): Map<string, string> {
43250:   const map = new Map<string, string>();
43251:   for (const entity of entities) {
43252:     if (entity.type === "unit" && entity.escaped) continue;
43253:     if (entity.type === "switch") continue;
43254:     if (entity.type === "gate" && entity.open) continue;
43255:     for (const cell of getOccupiedCells(entity)) {
43256:       map.set(`${cell.row},${cell.col}`, entity.id);
43257:     }
43258:   }
43259:   return map;
43260: }
43261: 
43262: // Returns every cell in front of the unit's leading edge until the board boundary.
43263: export function getForwardCellsUntilExit(
43264:   unit: TribeOutEntity,
43265:   boardRows: number,
43266:   boardCols: number
43267: ): { row: number; col: number }[] {
43268:   const cells: { row: number; col: number }[] = [];
43269:   const { direction, row, col, width, height } = unit;
43270: 
43271:   if (direction === "up") {
43272:     for (let r = row - 1; r >= 0; r--) {
43273:       for (let c = col; c < col + width; c++) cells.push({ row: r, col: c });
43274:     }
43275:   } else if (direction === "down") {
43276:     for (let r = row + height; r < boardRows; r++) {
43277:       for (let c = col; c < col + width; c++) cells.push({ row: r, col: c });
43278:     }
43279:   } else if (direction === "left") {
43280:     for (let c = col - 1; c >= 0; c--) {
43281:       for (let r = row; r < row + height; r++) cells.push({ row: r, col: c });
43282:     }
43283:   } else if (direction === "right") {
43284:     for (let c = col + width; c < boardCols; c++) {
43285:       for (let r = row; r < row + height; r++) cells.push({ row: r, col: c });
43286:     }
43287:   }
43288: 
43289:   return cells;
43290: }
43291: 
43292: export function canExit(
43293:   unit: TribeOutEntity,
43294:   entities: TribeOutEntity[],
43295:   boardRows: number,
43296:   boardCols: number
43297: ): boolean {
43298:   if (!unit.direction) return false;
43299:   const occupancyMap = buildOccupancyMap(entities);
43300:   const forwardCells = getForwardCellsUntilExit(unit, boardRows, boardCols);
43301:   for (const cell of forwardCells) {
43302:     const occupantId = occupancyMap.get(`${cell.row},${cell.col}`);
43303:     if (occupantId && occupantId !== unit.id) return false;
43304:   }
43305:   return true;
43306: }
43307: 
43308: export function getAvailableUnits(state: GameState, boardRows: number, boardCols: number): string[] {
43309:   const available: string[] = [];
43310:   for (const entity of state.entities) {
43311:     if (entity.type === "unit" && !entity.escaped) {
43312:       if (canExit(entity, state.entities, boardRows, boardCols)) {
43313:         available.push(entity.id);
43314:       }
43315:     }
43316:   }
43317:   return available;
43318: }
43319: 
43320: function sanitizeCoins(savedCoins: number): number {
43321:   return Number.isFinite(savedCoins) ? savedCoins : 0;
43322: }
43323: 
43324: export function buildInitialGameState(levelIndex: number, savedCoins = 0): GameState {
43325:   const level = LEVELS[levelIndex];
43326:   const entities = level.entities.map(e => ({ ...e, escaped: false }));
43327:   const totalUnits = entities.filter(e => e.type === "unit").length;
43328:   return {
43329:     currentLevelIndex: levelIndex,
43330:     lives: level.lives,
43331:     coins: sanitizeCoins(savedCoins),
43332:     escapedCount: 0,
43333:     totalUnits,
43334:     status: "playing",
43335:     entities,
43336:     lastBumpedEntityId: null,
43337:     lastEscapedEntityId: null,
43338:     coinsEarnedThisLevel: 0,
43339:     timeRemaining: level.timeLimit,
43340:     hintsUsed: 0,
43341:     rotateCharges: 1,
43342:     selectedTool: "none",
43343:   };
43344: }
43345: 
43346: export function buildNextLevelState(currentState: GameState, nextLevelIndex: number): GameState {
43347:   const level = LEVELS[nextLevelIndex];
43348:   const entities = level.entities.map(e => ({ ...e, escaped: false }));
43349:   const totalUnits = entities.filter(e => e.type === "unit").length;
43350:   return {
43351:     currentLevelIndex: nextLevelIndex,
43352:     lives: level.lives,
43353:     coins: currentState.coins,
43354:     escapedCount: 0,
43355:     totalUnits,
43356:     status: "playing",
43357:     entities,
43358:     lastBumpedEntityId: null,
43359:     lastEscapedEntityId: null,
43360:     coinsEarnedThisLevel: 0,
43361:     timeRemaining: level.timeLimit,
43362:     hintsUsed: 0,
43363:     rotateCharges: 1,
43364:     selectedTool: "none",
43365:   };
43366: }
43367: 
43368: export function resetLevel(state: GameState): GameState {
43369:   const level = LEVELS[state.currentLevelIndex];
43370:   const entities = level.entities.map(e => ({ ...e, escaped: false }));
43371:   const totalUnits = entities.filter(e => e.type === "unit").length;
43372:   return {
43373:     currentLevelIndex: state.currentLevelIndex,
43374:     lives: level.lives,
43375:     coins: Math.max(0, state.coins - state.coinsEarnedThisLevel),
43376:     escapedCount: 0,
43377:     totalUnits,
43378:     status: "playing",
43379:     entities,
43380:     lastBumpedEntityId: null,
43381:     lastEscapedEntityId: null,
43382:     coinsEarnedThisLevel: 0,
43383:     timeRemaining: level.timeLimit,
43384:     hintsUsed: 0,
43385:     rotateCharges: 1,
43386:     selectedTool: "none",
43387:   };
43388: }
43389: 
43390: function buildWinProgressSnapshot(
43391:   state: GameState,
43392:   nextCoins: number,
43393:   savedProgress: TribeOutProgressSnapshot,
43394:   stars: number
43395: ): TribeOutProgressSnapshot {
43396:   const currentBest = savedProgress.levelStars[state.currentLevelIndex] || 0;
43397:   return {
43398:     coins: nextCoins,
43399:     highestUnlockedLevel: Math.max(savedProgress.highestUnlockedLevel, state.currentLevelIndex + 1),
43400:     currentLevelIndex: state.currentLevelIndex,
43401:     levelStars: {
43402:       ...savedProgress.levelStars,
43403:       [state.currentLevelIndex]: Math.max(currentBest, stars),
43404:     }
43405:   };
43406: }
43407: 
43408: export function applyTapUnit(
43409:   unitId: string,
43410:   state: GameState,
43411:   savedProgress: TribeOutProgressSnapshot
43412: ): TribeOutTapResult {
43413:   if (state.status !== "playing") {
43414:     return { nextState: state, progressSnapshot: null };
43415:   }
43416: 
43417:   const entity = state.entities.find(e => e.id === unitId);
43418:   if (!entity || entity.type === "obstacle" || entity.escaped) {
43419:     return { nextState: state, progressSnapshot: null };
43420:   }
43421: 
43422:   const level = LEVELS[state.currentLevelIndex];
43423: 
43424:   if (canExit(entity, state.entities, level.boardRows, level.boardCols)) {
43425:     const forwardCells = getForwardCellsUntilExit(entity, level.boardRows, level.boardCols);
43426:     const pathCells = [...getOccupiedCells(entity), ...forwardCells];
43427:     
43428:     const activatedSwitches = new Set<string>();
43429:     for (const e of state.entities) {
43430:       if (e.type === "switch" && !e.activated) {
43431:         const switchCells = getOccupiedCells(e);
43432:         const overlap = switchCells.some(sc => pathCells.some(pc => pc.row === sc.row && pc.col === sc.col));
43433:         if (overlap) {
43434:           activatedSwitches.add(e.id);
43435:         }
43436:       }
43437:     }
43438:     
43439:     const targetGateIds = new Set<string>();
43440:     for (const swId of activatedSwitches) {
43441:       const sw = state.entities.find(e => e.id === swId);
43442:       if (sw && sw.targetId) targetGateIds.add(sw.targetId);
43443:     }
43444: 
43445:     const newEntities = state.entities.map(e => {
43446:       if (e.id === unitId) return { ...e, escaped: true };
43447:       if (activatedSwitches.has(e.id)) return { ...e, activated: true };
43448:       if (e.type === "gate" && targetGateIds.has(e.id)) return { ...e, open: true };
43449:       return e;
43450:     });
43451:     
43452:     const newEscapedCount = state.escapedCount + 1;
43453:     const allEscaped = newEntities.filter(e => e.type === "unit").every(e => e.escaped);
43454: 
43455:     let bonusCoins = 0;
43456:     let newStatus: GameState["status"] = "playing";
43457:     let progressSnapshot: TribeOutProgressSnapshot | null = null;
43458: 
43459:     if (allEscaped) {
43460:       newStatus = "won";
43461:       
43462:       let stars = 1;
43463:       if (state.lives === level.lives) stars++;
43464:       if (state.hintsUsed === 0 && (state.timeRemaining ?? 0) > 0) stars++;
43465:       
43466:       const previousStars = savedProgress.levelStars[state.currentLevelIndex] || 0;
43467:       const isReplay = previousStars > 0;
43468:       // if replay, we shouldn't farm bonus coins infinitely
43469:       bonusCoins = isReplay ? 0 : (50 + stars * 20);
43470:       const totalCoins = state.coins + (isReplay ? 0 : 10) + bonusCoins;
43471: 
43472:       progressSnapshot = buildWinProgressSnapshot(state, totalCoins, savedProgress, stars);
43473:       
43474:       return {
43475:         nextState: {
43476:           ...state,
43477:           entities: newEntities,
43478:           escapedCount: newEscapedCount,
43479:           coins: totalCoins,
43480:           coinsEarnedThisLevel: state.coinsEarnedThisLevel + (isReplay ? 0 : 10) + bonusCoins,
43481:           status: newStatus,
43482:           lastEscapedEntityId: unitId,
43483:           lastBumpedEntityId: null,
43484:           stars,
43485:         },
43486:         progressSnapshot,
43487:       };
43488:     }
43489: 
43490:     return {
43491:       nextState: {
43492:         ...state,
43493:         entities: newEntities,
43494:         escapedCount: newEscapedCount,
43495:         coins: state.coins + 10 + bonusCoins,
43496:         coinsEarnedThisLevel: state.coinsEarnedThisLevel + 10 + bonusCoins,
43497:         status: newStatus,
43498:         lastEscapedEntityId: unitId,
43499:         lastBumpedEntityId: null,
43500:       },
43501:       progressSnapshot,
43502:     };
43503:   } else {
43504:     const newLives = state.lives - 1;
43505:     return {
43506:       nextState: {
43507:         ...state,
43508:         lives: newLives,
43509:         status: newLives <= 0 ? "lost" : "playing",
43510:         lastBumpedEntityId: unitId,
43511:         lastEscapedEntityId: null,
43512:       },
43513:       progressSnapshot: null,
43514:     };
43515:   }
43516: }
43517: 
43518: export function applyRotateUnit(state: GameState, unitId: string): GameState {
43519:   if (state.status !== "playing" || state.rotateCharges <= 0) return state;
43520: 
43521:   const newEntities = state.entities.map(e => {
43522:     if (e.id === unitId && e.type === "unit" && !e.escaped) {
43523:       const directions: ("up" | "right" | "down" | "left")[] = ["up", "right", "down", "left"];
43524:       const currentIdx = directions.indexOf(e.direction!);
43525:       const nextDir = directions[(currentIdx + 1) % 4];
43526:       return { ...e, direction: nextDir };
43527:     }
43528:     return e;
43529:   });
43530: 
43531:   return {
43532:     ...state,
43533:     entities: newEntities,
43534:     rotateCharges: state.rotateCharges - 1,
43535:     selectedTool: "none",
43536:   };
43537: }
