 13: 
 14: export function GameSprite({ assetKey, isObstacle, direction, size }: GameSpriteProps) {
 15:   const [imageError, setImageError] = useState(false);
 16:   const characterFallbackUrl = IMAGE_ASSETS["villager-1"];
