<file path="src/features/tribe-out/TribeOutEntity.tsx">
  1: import { useState, useEffect, useRef, memo } from "react";
  2: import type { Direction, TribeOutEntity } from "./types";
  3: import { GameSprite } from "./assets/GameSprite";
  4: import type { IsoBoardLayout } from "./isometric";
  5: import { projectIsoEntity } from "./isometric";
  6: 
  7: const ESCAPE_ANIM: Record<Direction, string> = {
  8:   right: "tribeEscapeRight 0.55s ease-out forwards",
  9:   left:  "tribeEscapeLeft 0.55s ease-out forwards",
 10:   up:    "tribeEscapeUp 0.55s ease-out forwards",
 11:   down:  "tribeEscapeDown 0.55s ease-out forwards",
 12: };
 13: 
 14: const BUMP_ANIM: Record<Direction, string> = {
 15:   right: "tribeBumpRight 0.48s ease-out",
 16:   left:  "tribeBumpLeft 0.48s ease-out",
 17:   up:    "tribeBumpUp 0.48s ease-out",
 18:   down:  "tribeBumpDown 0.48s ease-out",
 19: };
 20: 
 21: interface TribeOutEntityProps {
 22:   entity: TribeOutEntity;
 23:   layout: IsoBoardLayout;
 24:   isBumping: boolean;
 25:   bumpNonce?: number;
 26:   isHinted?: boolean;
 27:   onTap: (id: string) => void;
 28: }
 29: 
 30: const DIRECTION_LABELS: Record<Direction, string> = {
 31:   up: "lên trên",
 32:   down: "xuống dưới",
 33:   left: "sang trái",
 34:   right: "sang phải",
 35: };
 36: 
 37: 
 38: 
 39: function getEntityAriaLabel(entity: TribeOutEntity): string {
 40:   if (entity.type === "obstacle") {
 41:     return `Chướng ngại vật kích thước ${entity.width}x${entity.height}`;
 42:   }
 43:   if (entity.type === "gate") {
 44:     return `Cổng ${entity.open ? "đang mở" : "đang đóng"} kích thước ${entity.width}x${entity.height}`;
 45:   }
 46:   if (entity.type === "switch") {
 47:     return `Công tắc ${entity.activated ? "đã kích hoạt" : "chưa kích hoạt"} kích thước ${entity.width}x${entity.height}`;
 48:   }
 49:   const direction = entity.type === "unit" ? entity.direction : "right";
 50:   return `Nhân vật đi ${DIRECTION_LABELS[direction]}, kích thước ${entity.width}x${entity.height}`;
 51: }
 52: 
 53: export const TribeOutEntityComponent = memo(function TribeOutEntityComponent({
 54:   entity,
 55:   layout,
 56:   isBumping,
 57:   bumpNonce = 0,
 58:   isHinted,
 59:   onTap,
 60: }: TribeOutEntityProps) {
 61:   const [animState, setAnimState] = useState<"idle" | "bump" | "escape">("idle");
 62:   const isUnitType = entity.type === "unit";
 63:   const escaped = isUnitType ? Boolean(entity.escaped) : false;
 64:   const [hidden, setHidden] = useState(escaped);
 65:   
 66:   const prevBumpingRef = useRef(isBumping);
 67:   const prevEscapedRef = useRef(escaped);
 68:   const prevBumpNonceRef = useRef(bumpNonce);
 69:   const innerRef = useRef<HTMLDivElement>(null);
 70: 
 71:   // Detect escape transition and level-reset (escaped → not escaped)
 72:   useEffect(() => {
 73:     if (escaped && !prevEscapedRef.current) {
 74:       setAnimState("escape");
 75:       prevEscapedRef.current = true;
 76:       const t = setTimeout(() => setHidden(true), 580);
 77:       return () => clearTimeout(t);
 78:     } else if (!escaped && prevEscapedRef.current) {
 79:       setHidden(false);
 80:       setAnimState("idle");
 81:       prevEscapedRef.current = false;
 82:     }
 83:   }, [escaped]);
 84: 
 85:   // Detect bump transition
 86:   useEffect(() => {
 87:     const nonceChanged = bumpNonce > 0 && bumpNonce !== prevBumpNonceRef.current;
 88:     if ((isBumping && !prevBumpingRef.current) || nonceChanged) {
 89:       if (innerRef.current) {
 90:         innerRef.current.style.animation = "none";
 91:         void innerRef.current.offsetHeight;
 92:       }
 93:       setAnimState("bump");
 94:       const t = setTimeout(() => setAnimState("idle"), 600);
 95:       prevBumpingRef.current = isBumping;
 96:       prevBumpNonceRef.current = bumpNonce;
 97:       return () => clearTimeout(t);
 98:     }
 99:     prevBumpingRef.current = isBumping;
100:     prevBumpNonceRef.current = bumpNonce;
101:   }, [isBumping, bumpNonce]);
102: 
103:   if (hidden) return null;
104: 
105:   const isUnit = isUnitType && !escaped;
106:   const isObstacle = entity.type === "obstacle";
107:   const isGate = entity.type === "gate";
108:   const isSwitch = entity.type === "switch";
109:   const blocksPointer = isObstacle || isGate || isSwitch;
110:   const isInteractive = isUnit;
111:   
112:   const dir = entity.type === "unit" ? entity.direction : undefined;
113:   const projected = projectIsoEntity(layout, entity);
114:   const width = Math.max(32, Math.round(projected.width));
115:   const height = Math.max(32, Math.round(projected.height));
116:   const left = Math.round(projected.x - width / 2);
117:   const top = Math.round(projected.y - height / 2);
118:   const spriteOffsetX = isUnit && entity.width > 1 ? -((entity.width - 1) * layout.stepX) / 2 : 0;
119: 
120:   let animation = "";
121:   if (animState === "escape" && dir) {
122:     animation = ESCAPE_ANIM[dir];
123:   } else if (animState === "bump" && dir) {
124:     animation = BUMP_ANIM[dir];
125:   } else if (isUnit) {
126:     animation = "tribeBreath 2.8s ease-in-out infinite";
127:   }
128: 
129:   const spriteSize = Math.max(24, Math.round(Math.min(width, height) * 0.92));
130:   const ariaLabel = getEntityAriaLabel(entity);
131: 
132:   const handleActivate = () => {
133:     if (isInteractive) {
134:       onTap(entity.id);
135:     }
136:   };
137: 
138:   const handleKeyDown = (event: React.KeyboardEvent<HTMLDivElement>) => {
139:     if (!isInteractive) {
140:       return;
141:     }
142: 
143:     if (event.key === "Enter" || event.key === " ") {
144:       event.preventDefault();
145:       handleActivate();
146:     }
147:   };
148: 
149:   let assetKey = entity.assetKey;
150:   if (isGate) assetKey = entity.open ? "gate-open" : "gate-closed";
151:   if (isSwitch) assetKey = entity.activated ? "switch-active" : "switch-inactive";
152: 
153:   return (
154:     <div
155:       style={{
156:         position: "absolute",
157:         top,
158:         left,
159:         width,
160:         height,
161:         zIndex: isSwitch ? projected.zIndex - 10 : projected.zIndex,
162:         pointerEvents: blocksPointer ? "none" : "auto",
163:       }}
164:     >
165:       <div
166:         ref={innerRef}
167:         onClick={isInteractive ? handleActivate : undefined}
168:         onKeyDown={isInteractive ? handleKeyDown : undefined}
169:         role={isInteractive ? "button" : "img"}
170:         aria-label={ariaLabel}
171:         tabIndex={isInteractive ? 0 : -1}
172:         style={{
173:           width: "100%",
174:           height: "100%",
175:           display: "flex",
176:           alignItems: "center",
177:           justifyContent: "center",
178:           cursor: isInteractive ? "pointer" : "default",
179:           userSelect: "none",
180:           WebkitUserSelect: "none",
181:           animation,
182:           filter: isHinted ? "drop-shadow(0 0 12px #fff) brightness(1.2)" : "none",
183:           touchAction: "manipulation",
184:           outlineOffset: 4,
185:           transform: "translateZ(0)",
186:         }}
187:       >
188:         <div style={{
189:           width: "100%",
190:           height: "100%",
191:           transform: spriteOffsetX === 0 ? "none" : `translateX(${spriteOffsetX}px)`,
192:           transformOrigin: "center",
193:           display: "flex",
194:           alignItems: "center",
195:           justifyContent: "center",
196:         }}>
197:           {!(entity.type === "gate" && entity.open) && (
198:             <GameSprite
199:               assetKey={assetKey}
200:               isObstacle={blocksPointer}
201:               isSwitch={isSwitch}
202:               direction={dir}
203:               size={spriteSize}
204:             />
205:           )}
206:         </div>
207:       </div>
208:     </div>
209:   );
210: });
</file>

