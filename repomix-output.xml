43058: <file path="src/features/tribe-out/tribeOutStorage.ts">
43059: import type { TribeOutProgressSnapshot } from "./types";
43060: 
43061: const COINS_KEY = "tribeout_coins";
43062: const HIGHEST_LEVEL_KEY = "tribeout_highest_level";
43063: const CURRENT_LEVEL_KEY = "tribeout_current_level";
43064: 
43065: function readNumber(key: string, fallback: number): number {
43066:   if (typeof window === "undefined" || !window.localStorage) {
43067:     return fallback;
43068:   }
43069: 
43070:   const rawValue = window.localStorage.getItem(key);
43071:   const parsedValue = rawValue === null ? fallback : Number.parseInt(rawValue, 10);
43072:   return Number.isNaN(parsedValue) ? fallback : parsedValue;
43073: }
43074: 
43075: export function loadTribeOutProgress(): TribeOutProgressSnapshot {
43076:   const highest = readNumber(HIGHEST_LEVEL_KEY, 0);
43077:   
43078:   let levelStars: Record<number, number> = {};
43079:   if (typeof window !== "undefined" && window.localStorage) {
43080:     const rawStars = window.localStorage.getItem("tribeout_level_stars");
43081:     if (rawStars) {
43082:       try { levelStars = JSON.parse(rawStars); } catch (e) {}
43083:     }
43084:   }
43085: 
43086:   return {
43087:     coins: readNumber(COINS_KEY, 0),
43088:     highestUnlockedLevel: highest,
43089:     currentLevelIndex: readNumber(CURRENT_LEVEL_KEY, highest),
43090:     levelStars,
43091:   };
43092: }
43093: 
43094: export function persistTribeOutProgress(progress: TribeOutProgressSnapshot): void {
43095:   if (typeof window === "undefined" || !window.localStorage) {
43096:     return;
43097:   }
43098: 
43099:   try {
43100:     window.localStorage.setItem(COINS_KEY, String(progress.coins));
43101:     window.localStorage.setItem(HIGHEST_LEVEL_KEY, String(progress.highestUnlockedLevel));
43102:     if (progress.currentLevelIndex !== undefined) {
43103:       window.localStorage.setItem(CURRENT_LEVEL_KEY, String(progress.currentLevelIndex));
43104:     }
43105:     window.localStorage.setItem("tribeout_level_stars", JSON.stringify(progress.levelStars || {}));
43106:   } catch (error) {
43107:     console.warn("Failed to save TribeOut progress to localStorage:", error);
43108:   }
43109: }
43110: 
43111: export function clearTribeOutProgress(): void {
43112:   if (typeof window === "undefined" || !window.localStorage) {
43113:     return;
43114:   }
43115: 
43116:   try {
43117:     window.localStorage.removeItem(COINS_KEY);
43118:     window.localStorage.removeItem(HIGHEST_LEVEL_KEY);
43119:     window.localStorage.removeItem(CURRENT_LEVEL_KEY);
43120:   } catch (error) {
43121:     console.warn("Failed to clear TribeOut progress from localStorage:", error);
43122:   }
43123: }
