 3158: const fs = require('fs');
 3159: const path = require('path');
 3160: const crypto = require('crypto');
 3161: 
 3162: function seedRandom(seed) {
 3163:     const hash = crypto.createHash('sha256').update(seed.toString()).digest();
 3164:     let index = 0;
 3165:     return function() {
 3166:         if (index >= hash.length) {
 3167:             index = 0;
 3168:             const newHash = crypto.createHash('sha256').update(hash).digest();
 3169:             hash.fill(0); // clear
 3170:             hash.set(newHash);
 3171:         }
 3172:         const val = hash[index] / 256.0;
 3173:         index++;
 3174:         return val;
 3175:     };
 3176: }
 3177: 
 3178: function generateLevels(numLevels) {
 3179:     const handcrafted = require('./handcrafted_levels.cjs');
 3180:     const levels = [...handcrafted];
 3181:     
 3182:     // Start generating from i = levels.length + 1
 3183:     for (let i = levels.length + 1; i <= numLevels; i++) {
 3184:         const rand = seedRandom(`level_${i}_v2`);
 3185:         let tier = Math.floor(i / 10);
 3186:         
 3187:         let size = Math.min(9, 5 + Math.floor(i / 15)); 
 3188:         if (i <= 20) {
 3189:             size = 5 + Math.floor(i / 10); // 5x5 then 6x6
 3190:         }
 3191:         
 3192:         let boardCols = size;
 3193:         let boardRows = size;
 3194:         
 3195:         let numUnits = i <= 20 ? (4 + Math.floor(i * 0.5)) : Math.min(10 + Math.floor(i * 0.8), Math.floor((boardCols * boardRows) * 0.7));
 3196:         
 3197:         let numObstacles = Math.floor(tier * 1.5);
 3198:         
 3199:         let timePerUnit = Math.max(1.0, 3.5 - (tier * 0.2));
 3200:         let timeLimit = Math.max(10, Math.floor(numUnits * timePerUnit + 8));
 3201:         
 3202:         const entities = [];
 3203:         const grid = Array.from({ length: boardRows }, () => Array(boardCols).fill(null));
 3204:         
 3205:         const isOccupied = (r, c, w, h) => {
 3206:             if (r < 0 || r + h > boardRows || c < 0 || c + w > boardCols) return true;
 3207:             for (let y = r; y < r + h; y++) {
 3208:                 for (let x = c; x < c + w; x++) {
 3209:                     if (grid[y][x] !== null) return true;
 3210:                 }
 3211:             }
 3212:             return false;
 3213:         };
 3214: 
 3215:         const markOccupied = (r, c, w, h, id) => {
 3216:             for (let y = r; y < r + h; y++) {
 3217:                 for (let x = c; x < c + w; x++) {
 3218:                     grid[y][x] = id;
 3219:                 }
 3220:             }
 3221:         };
 3222: 
 3223:         for (let o = 0; o < numObstacles; o++) {
 3224:             let r = Math.floor(rand() * boardRows);
 3225:             let c = Math.floor(rand() * boardCols);
 3226:             let w = 1; let h = 1;
 3227:             if (i > 20 && rand() < 0.2) {
 3228:                 if (rand() < 0.5) w = 2; else h = 2;
 3229:             }
 3230:             if (!isOccupied(r, c, w, h)) {
 3231:                 markOccupied(r, c, w, h, `obs_${o}`);
 3232:                 entities.push({ id: `obs_${o}`, type: "obstacle", assetKey: "rock", row: r, col: c, width: w, height: h });
 3233:             }
 3234:         }
 3235:         
 3236:         let unitCount = 0;
 3237:         let attempts = 0;
 3238:         const directions = ["up", "down", "left", "right"];
 3239:         const placedUnits = [];
 3240:         
 3241:         while (unitCount < numUnits && attempts < 2500) {
 3242:             attempts++;
 3243:             let r = Math.floor(rand() * boardRows);
 3244:             let c = Math.floor(rand() * boardCols);
 3245:             
 3246:             // Phase 2: multi-cell units
 3247:             let w = 1; let h = 1;
 3248:             if (i > 20 && rand() < 0.15) {
 3249:                 if (rand() < 0.5) w = 2; else h = 2;
 3250:             }
 3251: 
 3252:             if (isOccupied(r, c, w, h)) continue;
 3253:             
 3254:             let dir = directions[Math.floor(rand() * directions.length)];
 3255:             if (w === 2 && (dir === "left" || dir === "right")) continue; // avoid weird long exits initially, or we can allow it
 3256:             
 3257:             let pathClear = true;
 3258:             let blocksExisting = false;
 3259: 
 3260:             // Check if path clear
 3261:             if (dir === "up") {
 3262:                 for (let y = r - 1; y >= 0; y--) {
 3263:                     for (let x = c; x < c + w; x++) if (grid[y][x] !== null) { pathClear = false; break; }
 3264:                 }
 3265:             } else if (dir === "down") {
 3266:                 for (let y = r + h; y < boardRows; y++) {
 3267:                     for (let x = c; x < c + w; x++) if (grid[y][x] !== null) { pathClear = false; break; }
 3268:                 }
 3269:             } else if (dir === "left") {
 3270:                 for (let x = c - 1; x >= 0; x--) {
 3271:                     for (let y = r; y < r + h; y++) if (grid[y][x] !== null) { pathClear = false; break; }
 3272:                 }
 3273:             } else if (dir === "right") {
 3274:                 for (let x = c + w; x < boardCols; x++) {
 3275:                     for (let y = r; y < r + h; y++) if (grid[y][x] !== null) { pathClear = false; break; }
 3276:                 }
 3277:             }
 3278:             
 3279:             if (!pathClear) continue;
 3280: 
 3281:             // Check if it blocks an existing unit's escape path
 3282:             for (let pu of placedUnits) {
 3283:                 let puBlocked = false;
 3284:                 if (pu.dir === "up" && pu.c >= c && pu.c < c + w && r + h <= pu.r) puBlocked = true;
 3285:                 if (pu.dir === "down" && pu.c >= c && pu.c < c + w && r >= pu.r + pu.h) puBlocked = true;
 3286:                 if (pu.dir === "left" && pu.r >= r && pu.r < r + h && c + w <= pu.c) puBlocked = true;
 3287:                 if (pu.dir === "right" && pu.r >= r && pu.r < r + h && c >= pu.c + pu.w) puBlocked = true;
 3288:                 if (puBlocked) { blocksExisting = true; break; }
 3289:             }
 3290:             
 3291:             // To force deep dependencies, we require blocksExisting to be true 
 3292:             // after the first few units.
 3293:             if (unitCount > 2 && !blocksExisting && rand() < 0.75) {
 3294:                 // Reject this placement 75% of the time to force building on top of existing units
 3295:                 continue;
 3296:             }
 3297: 
 3298:             markOccupied(r, c, w, h, `u${unitCount}`);
 3299:             let newUnit = {
 3300:                 id: `u${unitCount}`,
 3301:                 type: "unit",
 3302:                 assetKey: `villager-${(unitCount % 7) + 1}`,
 3303:                 row: r,
 3304:                 col: c,
 3305:                 width: w,
 3306:                 height: h,
 3307:                 direction: dir
 3308:             };
 3309:             entities.push(newUnit);
 3310:             placedUnits.push({r, c, w, h, dir, id: `u${unitCount}`});
 3311:             unitCount++;
 3312:         }
 3313:         
 3314:         entities.sort(() => rand() - 0.5);
 3315:         
 3316:         levels.push({
 3317:             id: i,
 3318:             boardRows,
 3319:             boardCols,
 3320:             lives: 3 + Math.floor(i / 30),
 3321:             timeLimit: timeLimit,
 3322:             tutorialText: i === 1 ? "Chạm vào nhân vật để họ chạy thoát! Chú ý thời gian!" : undefined,
 3323:             entities
 3324:         });
 3325:     }
 3326:     
 3327:     let out = `import type { TribeOutLevel } from "./types";\n\nexport const LEVELS: TribeOutLevel[] = ${JSON.stringify(levels, null, 2)};\n`;
 3328:     fs.writeFileSync(path.join(__dirname, '../src/features/tribe-out/levels.ts'), out);
 3329: }
