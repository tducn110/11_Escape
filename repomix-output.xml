10: function serializeLevels(levels: readonly ReturnType<typeof generateLevels>[number][]): string {
11:   return [
12:     'import type { TribeOutLevel } from "./types";',
13:     "",
14:     `export const LEVELS: readonly TribeOutLevel[] = ${JSON.stringify(levels, null, 2)};`,
15:     "",
16:     "export const LEVEL_SET_VERSION = 2;",
17:     'export const LEVEL_BY_ID: ReadonlyMap<TribeOutLevel["id"], TribeOutLevel> = new Map(LEVELS.map(level => [level.id, level] as const));',
18:     'export const LEVEL_INDEX_BY_ID: ReadonlyMap<TribeOutLevel["id"], number> = new Map(LEVELS.map((level, index) => [level.id, index] as const));',
19:     "",
20:   ].join("\n");
21: }
22: 
23: const repoRoot = process.cwd();
24: const tempRoot = mkdtempSync(join(repoRoot, ".levels-generate-"));
25: const tempReportsDir = join(tempRoot, "reports", "levels");
26: mkdirSync(tempReportsDir, { recursive: true });
27: 
28: const levels = generateLevels();
29: const manifests = generateManifests(levels);
30: const validationIssues = [
31:   ...validateCatalog(levels),
32:   ...validateManifestCatalog(levels, manifests),
