 18:   const imageUrl = IMAGE_ASSETS[assetKey] ?? (isCharacter ? characterFallbackUrl : undefined);
 19:   const resolvedImageUrl = imageError
 20:     ? (isCharacter && imageUrl !== characterFallbackUrl ? characterFallbackUrl : undefined)
 21:     : imageUrl;
 22: 
