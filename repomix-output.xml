<file path="src/features/tribe-out/tribeOutStorage.ts">
  1: import { LEVELS, LEVEL_SET_VERSION } from "./levels";
  2: import type { LevelId, StarRating, TribeOutLevel, TribeOutProgressSnapshot } from "./types";
  3: 
  4: export interface StorageLike {
  5:   getItem(key: string): string | null;
  6:   setItem(key: string, value: string): void;
  7:   removeItem(key: string): void;
  8: }
  9: 
 10: const PROGRESS_KEY = "tribeout_progress";
 11: const LEGACY_KEYS = [
 12:   "tribeout_coins",
 13:   "tribeout_highest_level",
 14:   "tribeout_current_level",
 15:   "tribeout_level_stars",
 16: ];
 17: 
 18: const CURRENT_SCHEMA_VERSION = 2;
 19: const CURRENT_LEVEL_SET_VERSION = LEVEL_SET_VERSION;
 20: const LEVEL_ID_PATTERN = /^level-\d{3}$/;
 21: 
 22: function getStorage(): StorageLike | null {
 23:   try {
 24:     if (typeof window === "undefined" || !window.localStorage) {
 25:       return null;
 26:     }
 27:     return window.localStorage;
 28:   } catch {
 29:     return null;
 30:   }
 31: }
 32: 
 33: function firstLevelId(catalog: readonly TribeOutLevel[]): LevelId {
 34:   return catalog[0]?.id ?? "level-001";
 35: }
 36: 
 37: function defaultProgress(catalog: readonly TribeOutLevel[]): TribeOutProgressSnapshot {
 38:   const initialLevelId = firstLevelId(catalog);
 39:   return {
 40:     schemaVersion: CURRENT_SCHEMA_VERSION,
 41:     levelSetVersion: CURRENT_LEVEL_SET_VERSION,
 42:     unlockedLevelIds: [initialLevelId],
 43:     currentLevelId: initialLevelId,
 44:     starsByLevelId: {},
 45:   };
 46: }
 47: 
 48: function safeGetItem(storage: StorageLike, key: string): string | null {
 49:   try {
 50:     return storage.getItem(key);
 51:   } catch {
 52:     return null;
 53:   }
 54: }
 55: 
 56: function safeSetItem(storage: StorageLike, key: string, value: string): boolean {
 57:   try {
 58:     storage.setItem(key, value);
 59:     return true;
 60:   } catch {
 61:     return false;
 62:   }
 63: }
 64: 
 65: function safeRemoveItem(storage: StorageLike, key: string): void {
 66:   try {
 67:     storage.removeItem(key);
 68:   } catch {
 69:     // ignore storage cleanup failures
 70:   }
 71: }
 72: 
 73: function readJson(storage: StorageLike, key: string): unknown {
 74:   const raw = safeGetItem(storage, key);
 75:   if (!raw) return null;
 76:   try {
 77:     return JSON.parse(raw);
 78:   } catch {
 79:     return null;
 80:   }
 81: }
 82: 
 83: function clampLegacyIndex(value: unknown, catalog: readonly TribeOutLevel[]): number | null {
 84:   if (!Number.isInteger(value)) {
 85:     return null;
 86:   }
 87:   const numericValue = Number(value);
 88:   if (numericValue < 0) return 0;
 89:   if (numericValue >= catalog.length) return catalog.length - 1;
 90:   return numericValue;
 91: }
 92: 
 93: function normalizeStableLevelId(value: unknown, catalog: readonly TribeOutLevel[]): LevelId | null {
 94:   if (typeof value !== "string" || !LEVEL_ID_PATTERN.test(value)) {
 95:     return null;
 96:   }
 97:   return catalog.some(level => level.id === value) ? value as LevelId : null;
 98: }
 99: 
100: function buildContiguousUnlockPrefix(highestIndex: number, catalog: readonly TribeOutLevel[]): LevelId[] {
101:   const clampedHighest = Math.max(0, Math.min(highestIndex, catalog.length - 1));
102:   return catalog.slice(0, clampedHighest + 1).map(level => level.id);
103: }
104: 
105: function normalizeStars(value: unknown, catalog: readonly TribeOutLevel[]): Partial<Record<LevelId, StarRating>> {
106:   if (!value || typeof value !== "object") return {};
107: 
108:   const result: Partial<Record<LevelId, StarRating>> = {};
109:   for (const [rawKey, rawStars] of Object.entries(value as Record<string, unknown>)) {
110:     const levelId = normalizeStableLevelId(rawKey, catalog);
111:     if (!levelId) continue;
112:     if (!Number.isInteger(rawStars)) continue;
113:     const stars = Math.max(0, Math.min(3, Number(rawStars))) as StarRating;
114:     result[levelId] = Math.max(result[levelId] ?? 0, stars) as StarRating;
115:   }
116: 
117:   return result;
118: }
119: 
120: function normalizeUnlockPrefix(values: unknown, catalog: readonly TribeOutLevel[]): LevelId[] {
121:   const validIds = Array.isArray(values)
122:     ? values.map(value => normalizeStableLevelId(value, catalog)).filter((value): value is LevelId => value !== null)
123:     : [];
124: 
125:   const highestIndex = validIds.reduce((maxIndex, levelId) => {
126:     const nextIndex = catalog.findIndex(level => level.id === levelId);
127:     return Math.max(maxIndex, nextIndex);
128:   }, 0);
129: 
130:   return buildContiguousUnlockPrefix(highestIndex, catalog);
131: }
132: 
133: function sanitizeCurrentLevelId(
134:   candidate: unknown,
135:   unlockedLevelIds: readonly LevelId[],
136:   catalog: readonly TribeOutLevel[],
137: ): LevelId {
138:   const stableLevelId = normalizeStableLevelId(candidate, catalog);
139:   if (stableLevelId && unlockedLevelIds.includes(stableLevelId)) {
140:     return stableLevelId;
141:   }
142:   return unlockedLevelIds.at(-1) ?? firstLevelId(catalog);
143: }
144: 
145: export function sanitizeProgress(value: unknown, catalog: readonly TribeOutLevel[] = LEVELS): TribeOutProgressSnapshot {
146:   const defaults = defaultProgress(catalog);
147:   if (!value || typeof value !== "object") {
148:     return defaults;
149:   }
150: 
151:   const raw = value as Partial<TribeOutProgressSnapshot>;
152:   const unlockedLevelIds = normalizeUnlockPrefix(raw.unlockedLevelIds, catalog);
153:   const currentLevelId = sanitizeCurrentLevelId(raw.currentLevelId, unlockedLevelIds, catalog);
154:   const starsByLevelId =
155:     raw.levelSetVersion === CURRENT_LEVEL_SET_VERSION && raw.schemaVersion === CURRENT_SCHEMA_VERSION
156:       ? normalizeStars(raw.starsByLevelId, catalog)
157:       : {};
158: 
159:   return {
160:     schemaVersion: CURRENT_SCHEMA_VERSION,
161:     levelSetVersion: CURRENT_LEVEL_SET_VERSION,
162:     unlockedLevelIds,
163:     currentLevelId,
164:     starsByLevelId,
165:   };
166: }
167: 
168: function persistCanonicalProgress(storage: StorageLike, progress: TribeOutProgressSnapshot): boolean {
169:   const persisted = safeSetItem(storage, PROGRESS_KEY, JSON.stringify(progress));
170:   if (!persisted) {
171:     return false;
172:   }
173:   for (const key of LEGACY_KEYS) {
174:     safeRemoveItem(storage, key);
175:   }
176:   return true;
177: }
178: 
179: export function migrateLegacyProgress(storage: StorageLike, catalog: readonly TribeOutLevel[] = LEVELS): TribeOutProgressSnapshot {
180:   const defaults = defaultProgress(catalog);
181:   const currentLevelIndex = clampLegacyIndex(readJson(storage, "tribeout_current_level"), catalog);
182:   const highestUnlockedIndex = clampLegacyIndex(readJson(storage, "tribeout_highest_level"), catalog);
183:   void readJson(storage, "tribeout_level_stars");
184: 
185:   const highestIndex = highestUnlockedIndex ?? currentLevelIndex ?? 0;
186:   const unlockedLevelIds = buildContiguousUnlockPrefix(highestIndex, catalog);
187:   const currentLevelId = currentLevelIndex !== null
188:     ? unlockedLevelIds[Math.min(currentLevelIndex, unlockedLevelIds.length - 1)] ?? defaults.currentLevelId
189:     : unlockedLevelIds.at(-1) ?? defaults.currentLevelId;
190: 
191:   const progress: TribeOutProgressSnapshot = {
192:     schemaVersion: CURRENT_SCHEMA_VERSION,
193:     levelSetVersion: CURRENT_LEVEL_SET_VERSION,
194:     unlockedLevelIds,
195:     currentLevelId,
196:     starsByLevelId: {},
197:   };
198: 
199:   persistCanonicalProgress(storage, progress);
200:   return progress;
201: }
202: 
203: export function loadTribeOutProgress(catalog: readonly TribeOutLevel[] = LEVELS): TribeOutProgressSnapshot {
204:   const storage = getStorage();
205:   if (!storage) {
206:     return defaultProgress(catalog);
207:   }
208: 
209:   const canonical = readJson(storage, PROGRESS_KEY);
210:   if (canonical) {
211:     const sanitized = sanitizeProgress(canonical, catalog);
212:     const raw = canonical as Partial<TribeOutProgressSnapshot>;
213: 
214:     if (
215:       raw.schemaVersion !== sanitized.schemaVersion ||
216:       raw.levelSetVersion !== sanitized.levelSetVersion ||
217:       JSON.stringify(raw.unlockedLevelIds ?? []) !== JSON.stringify(sanitized.unlockedLevelIds) ||
218:       raw.currentLevelId !== sanitized.currentLevelId ||
219:       JSON.stringify(raw.starsByLevelId ?? {}) !== JSON.stringify(sanitized.starsByLevelId)
220:     ) {
221:       persistCanonicalProgress(storage, sanitized);
222:     }
223: 
224:     return sanitized;
225:   }
226: 
227:   return migrateLegacyProgress(storage, catalog);
228: }
229: 
230: export function persistTribeOutProgress(progress: TribeOutProgressSnapshot): void {
231:   const storage = getStorage();
232:   if (!storage) return;
233: 
234:   const sanitized = sanitizeProgress(progress, LEVELS);
235:   persistCanonicalProgress(storage, sanitized);
236: }
237: 
238: export function clearTribeOutProgress(): void {
239:   const storage = getStorage();
240:   if (!storage) return;
241: 
242:   safeRemoveItem(storage, PROGRESS_KEY);
243:   for (const key of LEGACY_KEYS) {
244:     safeRemoveItem(storage, key);
245:   }
246: }
</file>

<file path="src/features/tribe-out/gameLogic.ts">
  1: import type {
  2:   EntityId,
  3:   GameState,
  4:   PuzzleLevel,
  5:   PuzzleState,
  6:   StarRating,
  7:   TribeOutLevel,
  8:   TribeOutProgressSnapshot,
  9:   TribeOutTapResult,
 10: } from "./types";
 11: import { LEVELS, LEVEL_BY_ID, LEVEL_INDEX_BY_ID, LEVEL_SET_VERSION } from "./levels";
 12: import {
 13:   applyPuzzleAction,
 14:   canExitUnit,
 15:   createInitialPuzzleState,
 16:   getForwardCellsUntilExit,
 17:   getOccupiedCells,
 18:   isInsideBoard,
 19:   isPuzzleComplete,
 20:   listLegalExitActions,
 21:   listLegalRotateActions,
 22:   getEntityById,
 23:   getStateKey,
 24: } from "./puzzle";
 25: 
 26: function getLevel(levelId: TribeOutLevel["id"]): TribeOutLevel {
 27:   return LEVEL_BY_ID.get(levelId) ?? LEVELS[0];
 28: }
 29: 
 30: function clonePuzzleState(level: PuzzleLevel): PuzzleState {
 31:   return createInitialPuzzleState(level);
 32: }
 33: 
 34: function buildGameState(level: TribeOutLevel, puzzleState = clonePuzzleState(level), overrides: Partial<GameState> = {}): GameState {
 35:   const totalUnits = level.entities.filter(entity => entity.type === "unit").length;
 36: 
 37:   return {
 38:     currentLevelId: level.id,
 39:     lives: level.lives,
 40:     escapedCount: 0,
 41:     totalUnits,
 42:     status: "playing",
 43:     puzzle: puzzleState,
 44:     lastBumpedEntityId: null,
 45:     lastEscapedEntityId: null,
 46:     timeRemaining: level.timeLimit,
 47:     hintsUsed: 0,
 48:     stars: 0,
 49:     selectedTool: "none",
 50:     ...overrides,
 51:   };
 52: }
 53: 
 54: export function getAvailableUnits(state: GameState, boardRows: number, boardCols: number): EntityId[] {
 55:   return listLegalExitActions({ boardRows, boardCols }, state.puzzle)
 56:     .map(action => action.entityId)
 57:     .filter(entityId => {
 58:       const entity = getEntityById(state.puzzle, entityId);
 59:       return Boolean(entity && entity.type === "unit" && !entity.escaped && canExitUnit({ boardRows, boardCols }, state.puzzle, entity));
 60:     });
 61: }
 62: 
 63: function applyExitClosure(level: TribeOutLevel, puzzle: PuzzleState) {
 64:   let state = puzzle;
 65:   const actions: { type: "exit"; entityId: EntityId }[] = [];
 66: 
 67:   while (!isPuzzleComplete(state)) {
 68:     const exits = listLegalExitActions(level, state);
 69:     if (exits.length === 0) {
 70:       break;
 71:     }
 72:     const action = exits[0];
 73:     const result = applyPuzzleAction(level, state, action);
 74:     if (!result.accepted) {
 75:       break;
 76:     }
 77:     state = result.nextState;
 78:     actions.push(action);
 79:   }
 80: 
 81:   return { state, actions };
 82: }
 83: 
 84: export function getRepresentativeHintAction(level: TribeOutLevel, puzzle: PuzzleState): EntityId | null {
 85:   const initialClosure = applyExitClosure(level, puzzle);
 86:   if (initialClosure.actions.length > 0) {
 87:     return initialClosure.actions[0].entityId;
 88:   }
 89:   if (initialClosure.state.rotateChargesRemaining <= 0) {
 90:     return null;
 91:   }
 92: 
 93:   const frontier: Array<{
 94:     puzzle: PuzzleState;
 95:     actionTrail: EntityId[];
 96:     rotateCount: number;
 97:     totalActionCount: number;
 98:   }> = [{
 99:     puzzle: initialClosure.state,
100:     actionTrail: [],
101:     rotateCount: 0,
102:     totalActionCount: 0,
103:   }];
104:   const bestByState = new Map<string, { rotateCount: number; totalActionCount: number }>([
105:     [getStateKey(initialClosure.state), { rotateCount: 0, totalActionCount: 0 }],
106:   ]);
107: 
108:   while (frontier.length > 0) {
109:     frontier.sort((left, right) => {
110:       if (left.rotateCount !== right.rotateCount) return left.rotateCount - right.rotateCount;
111:       if (left.totalActionCount !== right.totalActionCount) return left.totalActionCount - right.totalActionCount;
112:       return getStateKey(left.puzzle).localeCompare(getStateKey(right.puzzle));
113:     });
114: 
115:     const current = frontier.shift()!;
116:     if (isPuzzleComplete(current.puzzle)) {
117:       return current.actionTrail[0] ?? null;
118:     }
119: 
120:     for (const action of listLegalRotateActions(current.puzzle)) {
121:       const rotated = applyPuzzleAction(level, current.puzzle, action);
122:       if (!rotated.accepted) continue;
123: 
124:       const closure = applyExitClosure(level, rotated.nextState);
125:       const nextPuzzle = closure.state;
126:       const nextTrail = [...current.actionTrail, action.entityId];
127:       const nextCost = {
128:         rotateCount: current.rotateCount + 1,
129:         totalActionCount: current.totalActionCount + 1 + closure.actions.length,
130:       };
131:       const stateKey = getStateKey(nextPuzzle);
132:       const best = bestByState.get(stateKey);
133:       if (
134:         best &&
135:         (best.rotateCount < nextCost.rotateCount ||
136:           (best.rotateCount === nextCost.rotateCount && best.totalActionCount <= nextCost.totalActionCount))
137:       ) {
138:         continue;
139:       }
140: 
141:       bestByState.set(stateKey, nextCost);
142:       frontier.push({
143:         puzzle: nextPuzzle,
144:         actionTrail: nextTrail,
145:         rotateCount: nextCost.rotateCount,
146:         totalActionCount: nextCost.totalActionCount,
147:       });
148:     }
149:   }
150: 
151:   return null;
152: }
153: 
154: export function buildInitialGameState(levelId: TribeOutLevel["id"]): GameState {
155:   const level = getLevel(levelId);
156:   return buildGameState(level, clonePuzzleState(level));
157: }
158: 
159: export function buildNextLevelState(_currentState: GameState, nextLevelId: TribeOutLevel["id"]): GameState {
160:   const level = getLevel(nextLevelId);
161:   return buildGameState(level, clonePuzzleState(level), {
162:     currentLevelId: level.id,
163:   });
164: }
165: 
166: export function resetLevel(state: GameState): GameState {
167:   const level = getLevel(state.currentLevelId);
168:   return buildGameState(level, clonePuzzleState(level), {
169:     currentLevelId: level.id,
170:   });
171: }
172: 
173: function calculateAvailableStars(stateBeforeWin: GameState, level: TribeOutLevel): StarRating {
174:   let stars = 1;
175:   if (stateBeforeWin.lives === level.lives) {
176:     stars += 1;
177:   }
178:   if (stateBeforeWin.hintsUsed === 0 && (stateBeforeWin.timeRemaining ?? 1) > 0) {
179:     stars += 1;
180:   }
181:   return Math.min(3, stars) as StarRating;
182: }
183: 
184: export function calculateStars(stateBeforeWin: GameState, level: TribeOutLevel): StarRating {
185:   return calculateAvailableStars(stateBeforeWin, level);
186: }
187: 
188: export function buildWinProgressSnapshot(
189:   progress: TribeOutProgressSnapshot,
190:   completedLevelId: TribeOutLevel["id"],
191:   stars: StarRating,
192: ): TribeOutProgressSnapshot {
193:   const completedLevelIndex = LEVEL_INDEX_BY_ID.get(completedLevelId) ?? -1;
194:   const nextLevel = completedLevelIndex >= 0 ? LEVELS[completedLevelIndex + 1] : undefined;
195:   const unlockedLevelIds = new Set(progress.unlockedLevelIds);
196:   unlockedLevelIds.add(completedLevelId);
197:   if (nextLevel) {
198:     unlockedLevelIds.add(nextLevel.id);
199:   }
200: 
201:   return {
202:     schemaVersion: progress.schemaVersion,
203:     levelSetVersion: LEVEL_SET_VERSION,
204:     unlockedLevelIds: [...unlockedLevelIds],
205:     currentLevelId: completedLevelId,
206:     starsByLevelId: {
207:       ...progress.starsByLevelId,
208:       [completedLevelId]: Math.max(progress.starsByLevelId[completedLevelId] ?? 0, stars) as StarRating,
209:     },
210:   };
211: }
212: 
213: export function applyTapUnit(
214:   unitId: string,
215:   state: GameState,
216:   savedProgress: TribeOutProgressSnapshot,
217: ): TribeOutTapResult {
218:   if (state.status !== "playing") {
219:     return { nextState: state, progressSnapshot: null };
220:   }
221: 
222:   const level = getLevel(state.currentLevelId);
223:   const actionResult = applyPuzzleAction(level, state.puzzle, { type: "exit", entityId: unitId });
224: 
225:   if (actionResult.outcome === "invalid_target") {
226:     return { nextState: state, progressSnapshot: null };
227:   }
228: 
229:   if (actionResult.outcome === "blocked_path") {
230:     const nextLives = state.lives - 1;
231:     return {
232:       nextState: {
233:         ...state,
234:         lives: nextLives,
235:         status: nextLives <= 0 ? "lost" : "playing",
236:         lastBumpedEntityId: unitId,
237:         lastEscapedEntityId: null,
238:       },
239:       progressSnapshot: null,
240:     };
241:   }
242: 
243:   const escapedCount = state.escapedCount + 1;
244:   const puzzle = actionResult.nextState;
245:   const completed = isPuzzleComplete(puzzle);
246:   const stars = completed ? calculateStars(state, level) : state.stars;
247:   const nextState: GameState = {
248:     ...state,
249:     puzzle,
250:     escapedCount,
251:     lastBumpedEntityId: null,
252:     lastEscapedEntityId: unitId,
253:     stars,
254:     status: completed ? "won" : "playing",
255:   };
256: 
257:   return {
258:     nextState,
259:     progressSnapshot: completed ? buildWinProgressSnapshot(savedProgress, level.id, stars) : null,
260:   };
261: }
262: 
263: export function applyRotateUnit(state: GameState, unitId: string): GameState {
264:   if (state.status !== "playing") return state;
265: 
266:   const level = getLevel(state.currentLevelId);
267:   const actionResult = applyPuzzleAction(level, state.puzzle, { type: "rotate", entityId: unitId });
268:   if (actionResult.outcome !== "accepted") {
269:     return state;
270:   }
271: 
272:   return {
273:     ...state,
274:     puzzle: actionResult.nextState,
275:     selectedTool: "none",
276:   };
277: }
278: 
279: export { getOccupiedCells, isInsideBoard, getForwardCellsUntilExit };
280: export { canExitUnit as canExit };
281: export { buildOccupancyMap } from "./puzzle";
</file>

