<file path="scripts/levels/analyzer.ts">
  1: import type { PuzzleLevel } from "../../src/features/tribe-out/types";
  2: import {
  3:   applyPuzzleAction,
  4:   createInitialPuzzleState,
  5:   listLegalExitActions,
  6:   listLegalRotateActions,
  7: } from "../../src/features/tribe-out/puzzle";
  8: import { solveFromState, type SolveResult } from "./solver";
  9: 
 10: export type MetricCoverage = "exact" | "sampled" | "not-applicable";
 11: 
 12: export interface MetricValue<T> {
 13:   value: T;
 14:   coverage: MetricCoverage;
 15:   sampleCount: number | null;
 16:   seed: string | null;
 17: }
 18: 
 19: export type DifficultyPhase = 1 | 2 | 3 | 4 | 5;
 20: 
 21: export interface DifficultyReport {
 22:   levelId: PuzzleLevel["id"];
 23:   phase: DifficultyPhase;
 24:   unitCount: number;
 25:   obstacleCount: number;
 26:   gateCount: number;
 27:   switchCount: number;
 28:   multiCellUnitCount: number;
 29:   initialAvailableMoves: number;
 30:   initialAvailableRatio: number;
 31:   criticalPathLength: MetricValue<number | null>;
 32:   causalUnlockDepth: MetricValue<number>;
 33:   averageAvailableMoves: MetricValue<number>;
 34:   forcedStateRatio: MetricValue<number>;
 35:   minRotateRequired: number;
 36:   deadEndRisk: MetricValue<number>;
 37:   meaningfulDecisionProxy: MetricValue<number>;
 38:   phaseTargetStatus: "IN_BAND" | "OUT_OF_BAND" | "APPROVED_EXCEPTION";
 39:   outOfBandReasons: string[];
 40: }
 41: 
 42: export interface AnalyzerConfig {
 43:   phase: DifficultyPhase;
 44:   sampleCount: number;
 45:   seed: string;
 46: }
 47: 
 48: interface NumericRange {
 49:   min: number;
 50:   max: number;
 51: }
 52: 
 53: interface DifficultyTargetBand {
 54:   unitCount: NumericRange;
 55:   initialAvailableMoves: NumericRange;
 56:   initialAvailableRatio: NumericRange;
 57:   causalDepth: NumericRange;
 58:   averageAvailableMoves: NumericRange;
 59:   minRotateRequired: NumericRange;
 60:   meaningfulDecisionProxy: NumericRange;
 61:   deadEndRisk: NumericRange;
 62: }
 63: 
 64: const PHASE_TARGETS: Record<DifficultyPhase, DifficultyTargetBand> = {
 65:   1: {
 66:     unitCount: { min: 1, max: 7 },
 67:     initialAvailableMoves: { min: 1, max: 3 },
 68:     initialAvailableRatio: { min: 0, max: 0.65 },
 69:     causalDepth: { min: 1, max: 4 },
 70:     averageAvailableMoves: { min: 1, max: 3.5 },
 71:     minRotateRequired: { min: 0, max: 1 },
 72:     meaningfulDecisionProxy: { min: 0, max: 1 },
 73:     deadEndRisk: { min: 0, max: 0 },
 74:   },
 75:   2: {
 76:     unitCount: { min: 6, max: 10 },
 77:     initialAvailableMoves: { min: 1, max: 3 },
 78:     initialAvailableRatio: { min: 0.2, max: 0.45 },
 79:     causalDepth: { min: 4, max: 7 },
 80:     averageAvailableMoves: { min: 1.5, max: 3.5 },
 81:     minRotateRequired: { min: 0, max: 1 },
 82:     meaningfulDecisionProxy: { min: 1, max: 2 },
 83:     deadEndRisk: { min: 0, max: 0.05 },
 84:   },
 85:   3: {
 86:     unitCount: { min: 7, max: 11 },
 87:     initialAvailableMoves: { min: 1, max: 3 },
 88:     initialAvailableRatio: { min: 0.15, max: 0.4 },
 89:     causalDepth: { min: 5, max: 9 },
 90:     averageAvailableMoves: { min: 1, max: 3 },
 91:     minRotateRequired: { min: 0, max: 1 },
 92:     meaningfulDecisionProxy: { min: 1, max: 3 },
 93:     deadEndRisk: { min: 0, max: 0.12 },
 94:   },
 95:   4: {
 96:     unitCount: { min: 8, max: 12 },
 97:     initialAvailableMoves: { min: 1, max: 2 },
 98:     initialAvailableRatio: { min: 0.1, max: 0.3 },
 99:     causalDepth: { min: 7, max: 11 },
100:     averageAvailableMoves: { min: 1, max: 2.8 },
101:     minRotateRequired: { min: 1, max: 1 },
102:     meaningfulDecisionProxy: { min: 2, max: 4 },
103:     deadEndRisk: { min: 0.05, max: 0.25 },
104:   },
105:   5: {
106:     unitCount: { min: 9, max: 14 },
107:     initialAvailableMoves: { min: 1, max: 3 },
108:     initialAvailableRatio: { min: 0.08, max: 0.25 },
109:     causalDepth: { min: 9, max: 14 },
110:     averageAvailableMoves: { min: 1, max: 2.5 },
111:     minRotateRequired: { min: 1, max: 2 },
112:     meaningfulDecisionProxy: { min: 3, max: 6 },
113:     deadEndRisk: { min: 0.08, max: 0.3 },
114:   },
115: };
116: 
117: function buildMetricValue<T>(value: T, coverage: MetricCoverage = "exact", sampleCount: number | null = null, seed: string | null = null): MetricValue<T> {
118:   return { value, coverage, sampleCount, seed };
119: }
120: 
121: function countPieces(level: PuzzleLevel) {
122:   let obstacleCount = 0;
123:   let gateCount = 0;
124:   let switchCount = 0;
125:   let multiCellUnitCount = 0;
126:   let unitCount = 0;
127: 
128:   for (const entity of level.entities) {
129:     if (entity.type === "unit") {
130:       unitCount += 1;
131:       if (entity.width > 1 || entity.height > 1) multiCellUnitCount += 1;
132:     } else if (entity.type === "obstacle") {
133:       obstacleCount += 1;
134:     } else if (entity.type === "gate") {
135:       gateCount += 1;
136:     } else if (entity.type === "switch") {
137:       switchCount += 1;
138:     }
139:   }
140: 
141:   return { unitCount, obstacleCount, gateCount, switchCount, multiCellUnitCount };
142: }
143: 
144: function countInitialMoves(level: PuzzleLevel): number {
145:   return listLegalExitActions(level, createInitialPuzzleState(level)).length;
146: }
147: 
148: function computeMonotonicWaveDepth(level: PuzzleLevel): number | null {
149:   let state = createInitialPuzzleState(level);
150:   let depth = 0;
151: 
152:   while (true) {
153:     const exits = listLegalExitActions(level, state);
154:     if (exits.length === 0) {
155:       return state.entities.every(entity => entity.type !== "unit" || entity.escaped) ? depth : null;
156:     }
157: 
158:     depth += 1;
159:     for (const action of exits) {
160:       const result = applyPuzzleAction(level, state, action);
161:       if (!result.accepted) {
162:         return null;
163:       }
164:       state = result.nextState;
165:     }
166:   }
167: }
168: 
169: function computeTraceMetrics(level: PuzzleLevel, solveResult: SolveResult): {
170:   averageAvailableMoves: number;
171:   forcedStateRatio: number;
172:   meaningfulDecisionProxy: number;
173:   causalUnlockDepth: number;
174:   deadEndRisk: number;
175: } {
176:   let state = createInitialPuzzleState(level);
177:   let totalAvailableExits = 0;
178:   let observedStates = 0;
179:   let forcedExitStates = 0;
180:   let meaningfulDecisionStates = 0;
181:   let causalDepth = 0;
182:   let currentWaveKind: "rotate" | "exit" | null = null;
183:   let deadEndRotateChoices = 0;
184:   let totalWinningReachableRotateChoices = 0;
185: 
186:   for (const step of solveResult.actions) {
187:     const exits = listLegalExitActions(level, state);
188:     const rotates = listLegalRotateActions(state);
189:     totalAvailableExits += exits.length;
190:     observedStates += 1;
191:     if (exits.length === 1) {
192:       forcedExitStates += 1;
193:     }
194:     if (rotates.length >= 2) {
195:       const distinctOutcomes = new Set<string>();
196:       let branchChoices = 0;
197:       for (const rotateAction of rotates) {
198:         const result = applyPuzzleAction(level, state, rotateAction);
199:         if (!result.accepted) continue;
200:         branchChoices += 1;
201:         const branchSolution = solveFromState(level, result.nextState, {
202:           stateBudget: 40_000,
203:           timeBudgetMs: 1_500,
204:         });
205:         if (branchSolution.status !== "SOLVABLE") {
206:           deadEndRotateChoices += 1;
207:         }
208:         distinctOutcomes.add(branchSolution.finalStateKey ?? `${branchSolution.status}:${rotateAction.entityId}`);
209:       }
210:       if (branchChoices >= 2 && distinctOutcomes.size >= 2) {
211:         meaningfulDecisionStates += 1;
212:       }
213:       totalWinningReachableRotateChoices += branchChoices;
214:     }
215: 
216:     if (step.action.type !== currentWaveKind) {
217:       causalDepth += 1;
218:       currentWaveKind = step.action.type;
219:     } else if (step.action.type === "rotate") {
220:       causalDepth += 1;
221:     }
222: 
223:     const result = applyPuzzleAction(level, state, step.action);
224:     if (!result.accepted) {
225:       return {
226:         averageAvailableMoves: 0,
227:         forcedStateRatio: 0,
228:         meaningfulDecisionProxy: 0,
229:         causalUnlockDepth: 0,
230:         deadEndRisk: 0,
231:       };
232:     }
233:     state = result.nextState;
234:   }
235: 
236:   return {
237:     averageAvailableMoves: observedStates > 0 ? totalAvailableExits / observedStates : countInitialMoves(level),
238:     forcedStateRatio: observedStates > 0 ? forcedExitStates / observedStates : 0,
239:     meaningfulDecisionProxy: meaningfulDecisionStates,
240:     causalUnlockDepth: Math.max(causalDepth, computeMonotonicWaveDepth(level) ?? 0, solveResult.actions.length > 0 ? 1 : 0),
241:     deadEndRisk: totalWinningReachableRotateChoices > 0 ? deadEndRotateChoices / totalWinningReachableRotateChoices : 0,
242:   };
243: }
244: 
245: function evaluateRange(name: string, value: number, range: NumericRange, reasons: string[]): void {
246:   if (value < range.min || value > range.max) {
247:     reasons.push(`${name}=${value} outside [${range.min}, ${range.max}]`);
248:   }
249: }
250: 
251: export function analyzeLevel(level: PuzzleLevel, solveResult: SolveResult, config: AnalyzerConfig): DifficultyReport {
252:   const { unitCount, obstacleCount, gateCount, switchCount, multiCellUnitCount } = countPieces(level);
253:   const initialAvailableMoves = countInitialMoves(level);
254:   const initialAvailableRatio = unitCount > 0 ? initialAvailableMoves / unitCount : 0;
255:   const minRotateRequired = solveResult.cost?.rotateCount ?? 0;
256:   const traceMetrics = computeTraceMetrics(level, solveResult);
257:   const phaseTargets = PHASE_TARGETS[config.phase];
258:   const outOfBandReasons: string[] = [];
259: 
260:   evaluateRange("unitCount", unitCount, phaseTargets.unitCount, outOfBandReasons);
261:   evaluateRange("initialAvailableMoves", initialAvailableMoves, phaseTargets.initialAvailableMoves, outOfBandReasons);
262:   evaluateRange("initialAvailableRatio", Number(initialAvailableRatio.toFixed(4)), phaseTargets.initialAvailableRatio, outOfBandReasons);
263:   evaluateRange("causalUnlockDepth", traceMetrics.causalUnlockDepth, phaseTargets.causalDepth, outOfBandReasons);
264:   evaluateRange("averageAvailableMoves", Number(traceMetrics.averageAvailableMoves.toFixed(4)), phaseTargets.averageAvailableMoves, outOfBandReasons);
265:   evaluateRange("minRotateRequired", minRotateRequired, phaseTargets.minRotateRequired, outOfBandReasons);
266:   evaluateRange("meaningfulDecisionProxy", traceMetrics.meaningfulDecisionProxy, phaseTargets.meaningfulDecisionProxy, outOfBandReasons);
267:   evaluateRange("deadEndRisk", Number(traceMetrics.deadEndRisk.toFixed(4)), phaseTargets.deadEndRisk, outOfBandReasons);
268: 
269:   return {
270:     levelId: level.id,
271:     phase: config.phase,
272:     unitCount,
273:     obstacleCount,
274:     gateCount,
275:     switchCount,
276:     multiCellUnitCount,
277:     initialAvailableMoves,
278:     initialAvailableRatio,
279:     criticalPathLength: buildMetricValue<number | null>(computeMonotonicWaveDepth(level), computeMonotonicWaveDepth(level) === null ? "not-applicable" : "exact"),
280:     causalUnlockDepth: buildMetricValue<number>(traceMetrics.causalUnlockDepth, "exact"),
281:     averageAvailableMoves: buildMetricValue<number>(traceMetrics.averageAvailableMoves, "exact"),
282:     forcedStateRatio: buildMetricValue<number>(traceMetrics.forcedStateRatio, "exact"),
283:     minRotateRequired,
284:     deadEndRisk: buildMetricValue<number>(traceMetrics.deadEndRisk, "exact"),
285:     meaningfulDecisionProxy: buildMetricValue<number>(traceMetrics.meaningfulDecisionProxy, "exact"),
286:     phaseTargetStatus: outOfBandReasons.length === 0 ? "IN_BAND" : "OUT_OF_BAND",
287:     outOfBandReasons,
288:   };
289: }
</file>

<file path="scripts/levels/catalog.ts">
  1: import type { DifficultyPhase, Direction, EntityId, PuzzleEntity, PuzzleLevel } from "../../src/features/tribe-out/types";
  2: 
  3: type SegmentSpec = {
  4:   id: EntityId;
  5:   width: number;
  6:   height?: number;
  7: };
  8: 
  9: type ChainSpec = {
 10:   row: number;
 11:   startCol: number;
 12:   direction?: Direction;
 13:   segments: SegmentSpec[];
 14: };
 15: 
 16: function levelId(index: number): PuzzleLevel["id"] {
 17:   return `level-${String(index).padStart(3, "0")}` as PuzzleLevel["id"];
 18: }
 19: 
 20: function phaseFor(index: number): DifficultyPhase {
 21:   if (index <= 20) return 1;
 22:   if (index <= 40) return 2;
 23:   if (index <= 60) return 3;
 24:   if (index <= 80) return 4;
 25:   return 5;
 26: }
 27: 
 28: function unit(
 29:   id: EntityId,
 30:   row: number,
 31:   col: number,
 32:   direction: Direction,
 33:   width = 1,
 34:   height = 1,
 35:   assetKey = `villager-${((Number(id.replace(/\D+/g, "")) || 1) % 7) + 1}`,
 36: ): PuzzleEntity {
 37:   return { id, type: "unit", assetKey, row, col, width, height, direction, escaped: false };
 38: }
 39: 
 40: function obstacle(id: EntityId, row: number, col: number, width = 1, height = 1): PuzzleEntity {
 41:   return { id, type: "obstacle", assetKey: "rock", row, col, width, height };
 42: }
 43: 
 44: function gate(id: EntityId, row: number, col: number, open = false): PuzzleEntity {
 45:   return { id, type: "gate", assetKey: open ? "gate-open" : "gate-closed", row, col, width: 1, height: 1, open };
 46: }
 47: 
 48: function switchEntity(id: EntityId, row: number, col: number, targetId: EntityId, activated = false): PuzzleEntity {
 49:   return { id, type: "switch", assetKey: activated ? "switch-active" : "switch-inactive", row, col, width: 1, height: 1, targetId, activated };
 50: }
 51: 
 52: function createLevel(index: number, level: Omit<PuzzleLevel, "id" | "phase">): PuzzleLevel {
 53:   return { id: levelId(index), phase: phaseFor(index), ...level };
 54: }
 55: 
 56: function buildChain(spec: ChainSpec): PuzzleEntity[] {
 57:   const direction = spec.direction ?? "right";
 58:   const entities: PuzzleEntity[] = [];
 59:   let col = spec.startCol;
 60: 
 61:   for (const segment of spec.segments) {
 62:     const height = segment.height ?? 1;
 63:     entities.push(unit(segment.id, spec.row, col, direction, segment.width, height));
 64:     col += segment.width;
 65:   }
 66: 
 67:   return entities;
 68: }
 69: 
 70: function baseLives(index: number): number {
 71:   return 3 + Math.floor((index - 1) / 30);
 72: }
 73: 
 74: function phaseTutorial(index: number): string | undefined {
 75:   switch (index) {
 76:     case 1: return "Chạm vào nhân vật để họ chạy thoát!";
 77:     case 2: return "Nhân vật này đang cản đường nhân vật kia!";
 78:     case 3: return "Bạn có thể xoay nhân vật bằng nút Xoay ở dưới!";
 79:     case 4: return "Dùng công tắc để mở cổng!";
 80:     case 5: return "Có những nhân vật chiếm nhiều hơn 1 ô!";
 81:     default: return undefined;
 82:   }
 83: }
