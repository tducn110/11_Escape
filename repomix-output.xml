 3001: 
 3002:     return () => {
 3003:       disposed = true;
 3004:       sceneRef.current = null;
 3005:       if (initCompleted && appRef.current) {
 3006:         appRef.current.destroy(
 3007:           { removeView: true, releaseGlobalResources: true },
 3008:           { children: true }
 3009:         );
 3010:         appRef.current = null;
 3011:       }
 3012:     };
 3013:   }, []);
 3014: 
 3015:   useEffect(() => {
 3016:     const app = appRef.current;
 3017:     if (!sceneRef.current || !app?.renderer) return;
 3018: 
 3019:     app.renderer.resize(layout.stageWidth, layout.stageHeight);
 3020:     renderBackdrop();
 3021:   }, [
 3022:     boardCols,
 3023:     boardRows,
 3024:     layout.cellSize,
 3025:     layout.originX,
 3026:     layout.originY,
 3027:     layout.stageHeight,
 3028:     layout.stageWidth,
