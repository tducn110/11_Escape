  const screenshotPath = path.join(OUTPUT_DIR, `${viewport.label}.png`);
  await fs.writeFile(screenshotPath, Buffer.from(screenshot.data, "base64"));

  client.socket.close();
  await closeTarget(target.id);

  return {
    viewport: viewport.label,
    baseScreenshotPath,
    screenshotPath,
    baseMetrics,
    afterWin,
    afterReplay,
    afterNext,
  };
}

