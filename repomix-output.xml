 79: function compareCost(left: SolveCost, right: SolveCost): number {
 80:   if (left.rotateCount !== right.rotateCount) {
 81:     return left.rotateCount - right.rotateCount;
 82:   }
 83:   return left.totalActionCount - right.totalActionCount;
