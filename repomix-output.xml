<file path="src/features/tribe-out/isometric.ts">
  1: import type { TribeOutEntity } from "./types";
  2: 
  3: export interface IsoBoardLayout {
  4:   cellSize: number;
  5:   tileWidth: number;
  6:   tileHeight: number;
  7:   stepX: number;
  8:   stepY: number;
  9:   paddingX: number;
 10:   paddingY: number;
 11:   stageWidth: number;
 12:   stageHeight: number;
 13:   originX: number;
 14:   originY: number;
 15: }
 16: 
 17: const MIN_CELL_SIZE = 16;
 18: const MAX_CELL_SIZE = 112;
 19: const MAX_STAGE_WIDTH = 1000;
 20: const BOARD_GUTTER = 8;
 21: 
 22: function clamp(value: number, min: number, max: number) {
 23:   return Math.max(min, Math.min(value, max));
 24: }
 25: 
 26: export function getIsoBoardLayout(
 27:   boardRows: number,
 28:   boardCols: number,
 29:   availableWidth: number,
 30:   availableHeight: number
 31: ): IsoBoardLayout {
 32:   const fallbackCellSize = 44;
 33: 
 34:   const safeWidth =
 35:     availableWidth > 0
 36:       ? Math.max(0, Math.min(availableWidth, MAX_STAGE_WIDTH + BOARD_GUTTER) - BOARD_GUTTER * 2)
 37:       : boardCols * fallbackCellSize;
 38:   const safeHeight =
 39:     availableHeight > 0
 40:       ? Math.max(0, availableHeight - BOARD_GUTTER * 2)
 41:       : boardRows * fallbackCellSize;
 42:       
 43:   const byWidth = Math.floor(safeWidth / (boardCols + 1));
 44:   const byHeight = Math.floor(safeHeight / (boardRows + 1));
 45:   const cellSize = clamp(
 46:     Math.min(byWidth || fallbackCellSize, byHeight || fallbackCellSize, MAX_CELL_SIZE),
 47:     MIN_CELL_SIZE,
 48:     MAX_CELL_SIZE
 49:   );
 50: 
 51:   const tileWidth = cellSize;
 52:   const tileHeight = cellSize;
 53:   const stepX = cellSize;
 54:   const stepY = cellSize;
 55:   const paddingX = cellSize * 0.5;
 56:   const paddingY = cellSize * 0.5;
 57:   const stageWidth = Math.round(boardCols * stepX + paddingX * 2);
 58:   const stageHeight = Math.round(boardRows * stepY + paddingY * 2);
 59: 
 60:   return {
 61:     cellSize,
 62:     tileWidth,
 63:     tileHeight,
 64:     stepX,
 65:     stepY,
 66:     paddingX,
 67:     paddingY,
 68:     stageWidth,
 69:     stageHeight,
 70:     originX: paddingX,
 71:     originY: paddingY,
 72:   };
 73: }
 74: 
 75: export function projectIsoPoint(layout: IsoBoardLayout, row: number, col: number) {
 76:   return {
 77:     x: layout.originX + col * layout.stepX + layout.stepX / 2,
 78:     y: layout.originY + row * layout.stepY + layout.stepY / 2,
 79:   };
 80: }
 81: 
 82: export function projectIsoEntity(layout: IsoBoardLayout, entity: TribeOutEntity) {
 83:   const centerRow = entity.row + (entity.height - 1) / 2;
 84:   const centerCol = entity.col + (entity.width - 1) / 2;
 85:   const point = projectIsoPoint(layout, centerRow, centerCol);
 86:   
 87:   // Z-index should be based on the row in 2D
 88:   const lowestPoint = projectIsoPoint(layout, entity.row + entity.height - 1, entity.col + entity.width - 1);
 89: 
 90:   const scale = entity.type === "obstacle" ? 0.88 : 1.08;
 91:   const visualWidth = entity.width * layout.cellSize * scale;
 92:   const visualHeight = entity.height * layout.cellSize * scale;
 93: 
 94:   return {
 95:     x: point.x,
 96:     y: point.y,
 97:     zIndex: 100 + Math.round(lowestPoint.y),
 98:     width: visualWidth,
 99:     height: visualHeight,
100:   };
101: }
</file>

