157: function makeStatefulLevel(
158:   index: number,
159:   config: {
160:     boardRows: number;
161:     boardCols: number;
162:     rotateCharges: number;
163:     keyChain: number[];
164:     helperChain: number[];
165:     gatedChain: number[];
166:     includeGate: boolean;
167:     includeSwitch: boolean;
168:     includeWideUnit: boolean;
169:     includeRotateDecoy: boolean;
170:     includeObstacle: boolean;
171:   },
172: ): PuzzleLevel {
173:   const entities: PuzzleEntity[] = [];
174:   const keyRow = 1;
175:   const helperRow = 3;
176:   const gatedRow = 5;
177: 
178:   const keySegments = config.keyChain.map((width, segmentIndex) => ({
179:     id: `k${index}_${segmentIndex}`,
180:     width,
181:   }));
182:   const helperSegments = config.helperChain.map((width, segmentIndex) => ({
183:     id: `h${index}_${segmentIndex}`,
184:     width,
185:   }));
186:   const gatedSegments = config.gatedChain.map((width, segmentIndex) => ({
187:     id: `g${index}_${segmentIndex}`,
188:     width,
189:   }));
190: 
191:   entities.push(
192:     ...buildChain({
193:       row: keyRow,
194:       startCol: 0,
195:       segments: keySegments,
196:     }),
197:     ...buildChain({
198:       row: helperRow,
199:       startCol: 0,
200:       segments: helperSegments,
201:     }),
202:     ...buildChain({
203:       row: gatedRow,
204:       startCol: 0,
205:       segments: gatedSegments,
206:     }),
207:   );
208: 
209:   const keyRootEndCol = config.keyChain.reduce((sum, width) => sum + width, 0);
210:   const helperRootEndCol = config.helperChain.reduce((sum, width) => sum + width, 0);
211:   const gatedRootEndCol = config.gatedChain.reduce((sum, width) => sum + width, 0);
212: 
213:   if (config.includeSwitch) {
214:     entities.push(switchEntity(`s${index}`, keyRow, keyRootEndCol, `gate-${index}`));
215:   }
216: 
217:   if (config.includeGate) {
218:     entities.push(gate(`gate-${index}`, gatedRow, gatedRootEndCol, false));
219:   }
220: 
221:   if (config.includeWideUnit) {
222:     entities.push(unit(`m${index}`, helperRow + 1, 0, "right", 2, 1));
223:   }
224: 
225:   if (config.includeRotateDecoy) {
226:     const decoyCol = Math.min(config.boardCols - 1, Math.max(keyRootEndCol, helperRootEndCol) + 1);
227:     entities.push(unit(`r${index}`, 2, decoyCol, "up"));
228:     entities.push(obstacle(`or${index}`, 1, decoyCol));
229:   }
230: 
231:   return createLevel(index, {
232:     boardRows: config.boardRows,
233:     boardCols: config.boardCols,
234:     lives: baseLives(index),
235:     timeLimit: 24 + (config.keyChain.length + config.helperChain.length + config.gatedChain.length) * 3,
236:     rotateCharges: config.rotateCharges,
237:     entities,
238:   });
239: }
