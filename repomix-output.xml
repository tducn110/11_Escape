<file path="src/features/tribe-out/audio/tribeOutAudio.ts">
  1: type ToneOptions = {
  2:   waveform?: OscillatorType;
  3:   volume?: number;
  4:   attack?: number;
  5:   release?: number;
  6:   freqEnd?: number;
  7: };
  8: 
  9: const DESKTOP_AUDIO = {
 10:   masterVolume: 1,
 11:   musicVolume: 0.1,
 12:   sfxVolume: 2.0,
 13: };
 14: 
 15: const MOBILE_AUDIO = {
 16:   masterVolume: 1,
 17:   musicVolume: 0.2,
 18:   sfxVolume: 2.0,
 19: };
 20: 
 21: const TONE_SFX_GAIN = 1.35;
 22: 
 23: function clampVolume(volume: number) {
 24:   return Math.min(1, Math.max(0, volume));
 25: }
 26: 
 27: class TribeOutAudio {
 28:   private context: AudioContext | null = null;
 29:   private musicEnabled = true;
 30:   private sfxEnabled = true;
 31:   private mobileAudioMode = false;
 32:   private masterBgmGain: GainNode | null = null;
 33:   private masterSfxGain: GainNode | null = null;
 34:   private unlockListenersBound = false;
 35:   private visibilityListenerBound = false;
 36:   private audioBuffers: Map<string, AudioBuffer> = new Map();
 37: 
 38:   constructor() {
 39:     this.addVisibilityListener();
 40:   }
 41: 
 42:   preload() {
 43:     this.addUnlockListeners();
 44:     this.addVisibilityListener();
 45:     this.preloadExternalAudio().catch(() => {});
 46:   }
 47: 
 48:   async preloadExternalAudio() {
 49:     if (typeof window === "undefined") return;
 50:     try {
 51:       const { AUDIO_ASSETS } = await import("../assets/assetRegistry");
 52:       const context = this.ensureContext();
 53:       if (!context) return;
 54:       
 55:       for (const [key, url] of Object.entries(AUDIO_ASSETS)) {
 56:         if (!this.audioBuffers.has(key)) {
 57:           fetch(url)
 58:             .then(res => res.arrayBuffer())
 59:             .then(buffer => context.decodeAudioData(buffer))
 60:             .then(audioBuffer => this.audioBuffers.set(key, audioBuffer))
 61:             .catch(e => console.warn(`Failed to load audio asset: ${key}`, e));
 62:         }
 63:       }
 64:     } catch {
 65:       // Ignore
 66:     }
 67:   }
 68: 
 69:   private readonly handleVisibilityChange = () => {
 70:     if (typeof document === "undefined") return;
 71: 
 72:     if (document.hidden) {
 73:       if (this.masterBgmGain) this.masterBgmGain.gain.value = 0;
 74:       if (this.masterSfxGain) this.masterSfxGain.gain.value = 0;
 75:       if (this.context && this.context.state === "running") {
 76:         this.context.suspend?.()?.catch(() => {});
 77:       }
 78:     } else {
 79:       if (this.masterBgmGain) this.masterBgmGain.gain.value = this.musicEnabled ? 1 : 0;
 80:       if (this.masterSfxGain) this.masterSfxGain.gain.value = this.sfxEnabled ? 1 : 0;
 81:       if (this.context && this.context.state === "suspended") {
 82:         this.context.resume?.()?.catch(() => {});
 83:       }
 84:     }
 85:   };
 86: 
 87:   private readonly unlock = () => {
 88:     this.unlockFromGesture({ removeFallbackListeners: true });
 89:   };
 90: 
 91:   unlockFromGesture({ removeFallbackListeners = false }: { removeFallbackListeners?: boolean } = {}) {
 92:     const context = this.ensureContext();
 93:     if (context?.state === "suspended") {
 94:       context.resume().catch(() => {});
 95:     }
 96: 
 97:     if (removeFallbackListeners && (!context || context.state === "running")) {
 98:       this.removeUnlockListeners();
 99:     }
100:   }
101: 
102:   setMusicEnabled(enabled: boolean) {
103:     this.musicEnabled = enabled;
104: 
105:     if (this.masterBgmGain) {
106:       this.masterBgmGain.gain.value = enabled ? 1 : 0;
107:     }
108: 
109:     if (!enabled) {
110:       this.removeVisibilityListener();
111:       return;
112:     }
113: 
114:     this.addVisibilityListener();
115:   }
116: 
117:   setSfxEnabled(enabled: boolean) {
118:     this.sfxEnabled = enabled;
119:     if (this.masterSfxGain) {
120:       this.masterSfxGain.gain.value = enabled ? 1 : 0;
121:     }
122:   }
123: 
124:   isMusicEnabled(): boolean {
125:     return this.musicEnabled;
126:   }
127: 
128:   isSfxEnabled(): boolean {
129:     return this.sfxEnabled;
130:   }
131: 
132:   setMobileAudioMode(enabled: boolean) {
133:     if (this.mobileAudioMode === enabled) return;
134:     this.mobileAudioMode = enabled;
135:   }
136: 
137:   playButtonClick() {
138:     if (!this.sfxEnabled) return;
139:     if (this.playBuffer("click", this.sfxToneVolume(1.0))) return;
140: 
141:     this.withRunningContext((context) => {
142:       const now = context.currentTime + 0.006;
143:       this.tone(context, 587.33, now, 0.055, {
144:         waveform: "triangle",
145:         volume: this.sfxToneVolume(0.045),
146:         attack: 0.006,
147:         release: 0.045,
148:       });
149:       this.tone(context, 880, now + 0.028, 0.05, {
150:         waveform: "sine",
151:         volume: this.sfxToneVolume(0.032),
152:         attack: 0.004,
153:         release: 0.04,
154:       });
155:     });
156:   }
157: 
158:   playEscape() {
159:     if (!this.sfxEnabled) return;
160:     if (this.playBuffer("escape", this.sfxToneVolume(1.0))) return;
161: 
162:     this.withRunningContext((context) => {
163:       const now = context.currentTime + 0.01;
