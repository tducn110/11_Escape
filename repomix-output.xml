214:   private ensureContext(): AudioContext | null {
215:     if (typeof window === "undefined") return null;
216:     if (this.context && this.context.state !== "closed") return this.context;
217: 
218:     const AudioCtor =
219:       window.AudioContext ??
220:       (window as Window & typeof globalThis & { webkitAudioContext?: typeof AudioContext })
221:         .webkitAudioContext;
222: 
223:     if (!AudioCtor) return null;
224: 
225:     try {
226:       this.context = new AudioCtor();
227:       this.masterBgmGain = this.context.createGain();
228:       this.masterSfxGain = this.context.createGain();
229: 
230:       this.masterBgmGain.gain.value = this.musicEnabled ? 1 : 0;
231:       this.masterSfxGain.gain.value = this.sfxEnabled ? 1 : 0;
232: 
233:       this.masterBgmGain.connect(this.context.destination);
234:       this.masterSfxGain.connect(this.context.destination);
235:     } catch {
236:       return null;
237:     }
238: 
239:     return this.context;
240:   }
241: 
242:   private resumeContext(): AudioContext | null {
243:     const context = this.ensureContext();
244:     if (!context) return null;
245: 
246:     if (context.state === "suspended") {
247:       context.resume().catch(() => {});
248:     }
249: 
250:     return context;
251:   }
252: 
253:   private withRunningContext(callback: (context: AudioContext) => void) {
254:     if (typeof document !== "undefined" && document.hidden) return;
255: 
256:     const context = this.resumeContext();
257:     if (!context) return;
258: 
259:     if (context.state === "running") {
260:       callback(context);
261:     } else {
262:       this.addUnlockListeners();
263:       // Execute callback anyway; audio will play once resumed
264:       callback(context);
265:     }
266:   }
267: 
268:   private playBuffer(key: string, volume: number): boolean {
269:     const buffer = this.audioBuffers.get(key);
270:     if (!buffer) return false;
271:     
272:     this.withRunningContext((context) => {
273:       try {
274:         const source = context.createBufferSource();
275:         source.buffer = buffer;
276:         
277:         const gain = context.createGain();
278:         gain.gain.value = volume;
279:         
280:         source.connect(gain);
281:         if (this.masterSfxGain) {
282:           gain.connect(this.masterSfxGain);
283:         }
284:         source.start(0);
285:       } catch {
286:         // Ignore synthesis errors
287:       }
288:     });
289:     
290:     return true;
291:   }
292: 
293:   private tone(
294:     context: AudioContext,
295:     frequency: number,
296:     startTime: number,
297:     duration: number,
298:     options: ToneOptions = {}
299:   ) {
300:     try {
301:       const oscillator = context.createOscillator();
302:       const gain = context.createGain();
303:       const attack = options.attack ?? 0.012;
304:       const release = options.release ?? 0.08;
305:       const volume = options.volume ?? 0.04;
306:       const stopTime = startTime + duration + release;
307: 
308:       oscillator.type = options.waveform ?? "sine";
309:       oscillator.frequency.setValueAtTime(frequency, startTime);
310:       if (options.freqEnd) {
311:         oscillator.frequency.exponentialRampToValueAtTime(options.freqEnd, startTime + attack + 0.05);
312:       }
313: 
314:       gain.gain.setValueAtTime(0.0001, startTime);
315:       gain.gain.linearRampToValueAtTime(volume, startTime + attack);
316:       gain.gain.exponentialRampToValueAtTime(0.0001, stopTime);
317: 
318:       oscillator.connect(gain);
319:       if (this.masterSfxGain) {
320:         gain.connect(this.masterSfxGain);
321:       }
322:       oscillator.start(startTime);
323:       oscillator.stop(stopTime + 0.02);
324:     } catch {
325:       // Ignore audio synthesis errors
326:     }
327:   }
328: 
329:   private addUnlockListeners() {
330:     if (typeof window === "undefined" || this.unlockListenersBound) return;
331: 
332:     window.addEventListener("pointerdown", this.unlock, { passive: true });
333:     window.addEventListener("touchstart", this.unlock, { passive: true });
334:     window.addEventListener("keydown", this.unlock);
335:     this.unlockListenersBound = true;
336:   }
337: 
338:   private removeUnlockListeners() {
339:     if (typeof window === "undefined" || !this.unlockListenersBound) return;
340: 
341:     window.removeEventListener("pointerdown", this.unlock);
342:     window.removeEventListener("touchstart", this.unlock);
343:     window.removeEventListener("keydown", this.unlock);
344:     this.unlockListenersBound = false;
345:   }
346: 
347:   private audioConfig() {
348:     const isMobile = () => {
349:       if (typeof window === "undefined") return false;
350:       const uaMatch = /Mobi|Android|iPhone|iPad|iPod|IEMobile|BlackBerry|Opera Mini/i.test(
351:         navigator.userAgent
352:       );
353:       const widthMatch = window.matchMedia("(max-width: 1024px)").matches;
354:       const touchMatch = "ontouchstart" in window || navigator.maxTouchPoints > 0;
355:       return uaMatch || widthMatch || touchMatch;
356:     };
357:     const forceMobile = this.mobileAudioMode || isMobile();
358:     return forceMobile ? MOBILE_AUDIO : DESKTOP_AUDIO;
359:   }
360: 
361:   private sfxToneVolume(volume: number) {
362:     const config = this.audioConfig();
363:     return clampVolume(config.masterVolume * config.sfxVolume * volume * TONE_SFX_GAIN);
364:   }
365: 
366:   private addVisibilityListener() {
367:     if (typeof document === "undefined" || this.visibilityListenerBound) return;
368:     document.addEventListener("visibilitychange", this.handleVisibilityChange);
369:     this.visibilityListenerBound = true;
370:   }
371: 
372:   private removeVisibilityListener() {
373:     if (typeof document === "undefined" || !this.visibilityListenerBound) return;
374:     document.removeEventListener("visibilitychange", this.handleVisibilityChange);
375:     this.visibilityListenerBound = false;
376:   }
377: 
378:   dispose() {
379:     this.removeUnlockListeners();
380:     this.removeVisibilityListener();
381:     this.visibilityListenerBound = false;
382:     if (this.context && this.context.state !== "closed") {
383:       this.context.close?.()?.catch(() => {});
384:     }
385:     this.context = null;
386:     this.masterBgmGain = null;
387:     this.masterSfxGain = null;
388:   }
389: }
