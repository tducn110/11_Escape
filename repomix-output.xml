454: export function generateLevels(): readonly PuzzleLevel[] {
455:   const levels: PuzzleLevel[] = [];
456: 
457:   for (let index = 1; index <= 100; index += 1) {
458:     const phase = phaseFor(index);
459:     const level = phase === 1
460:       ? makePhase1(index)
461:       : phase === 2
462:         ? phase2Level(index)
463:         : phase === 3
464:           ? phase3Level(index)
465:           : phase === 4
466:             ? phase4Level(index)
467:             : phase5Level(index);
468: 
469:     levels.push({
470:       ...level,
471:       entities: level.entities.map(entity => ({ ...entity })) as PuzzleEntity[],
472:     });
473:   }
474: 
475:   return levels;
476: }
