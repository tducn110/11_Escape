<file path="src/features/tribe-out/puzzle/engine.ts">
  1: import { getPathCells, getLiveUnitById, isPuzzleComplete } from "./selectors";
  2: import { getOccupiedCells } from "./geometry";
  3: import type { PuzzleAction, PuzzleActionResult, PuzzleEntity, PuzzleLevel, PuzzleState, UnitEntity } from "./types";
  4: import { cellKey, buildOccupancyMap } from "./occupancy";
  5: 
  6: function cloneEntity(entity: PuzzleEntity): PuzzleEntity {
  7:   return { ...entity } as PuzzleEntity;
  8: }
  9: 
 10: function rotateClockwise(direction: UnitEntity["direction"]): UnitEntity["direction"] {
 11:   switch (direction) {
 12:     case "up": return "right";
 13:     case "right": return "down";
 14:     case "down": return "left";
 15:     case "left": return "up";
 16:   }
 17: }
 18: 
 19: export function createInitialPuzzleState(level: PuzzleLevel): PuzzleState {
 20:   return {
 21:     entities: level.entities.map(entity => {
 22:       if (entity.type === "unit") {
 23:         return { ...entity, escaped: false };
 24:       }
 25:       if (entity.type === "gate") {
 26:         return { ...entity, open: Boolean(entity.open) };
 27:       }
 28:       if (entity.type === "switch") {
 29:         return { ...entity, activated: Boolean(entity.activated) };
 30:       }
 31:       return cloneEntity(entity);
 32:     }),
 33:     rotateChargesRemaining: level.rotateCharges,
 34:   };
 35: }
 36: 
 37: function applyExit(level: PuzzleLevel, state: PuzzleState, unit: UnitEntity): PuzzleActionResult {
 38:   const occupancyMap = buildOccupancyMap(state.entities);
 39:   const pathCells = getPathCells(unit, level);
 40:   for (const cell of pathCells) {
 41:     const occupantId = occupancyMap.get(cellKey(cell.row, cell.col));
 42:     if (occupantId && occupantId !== unit.id) {
 43:       return {
 44:         action: { type: "exit", entityId: unit.id },
 45:         nextState: state,
 46:         outcome: "blocked_path",
 47:         accepted: false,
 48:         details: {
 49:           activatedSwitchIds: [],
 50:           openedGateIds: [],
 51:           consumedRotateCharge: false,
 52:           completedPuzzle: false,
 53:         },
 54:       };
 55:     }
 56:   }
 57: 
 58:   const activatedSwitchIds = new Set<string>();
 59:   for (const entity of state.entities) {
 60:     if (entity.type !== "switch" || entity.activated) continue;
 61:     const switchCells = getOccupiedCells(entity);
 62:     if (switchCells.some(cell => pathCells.some(pathCell => pathCell.row === cell.row && pathCell.col === cell.col))) {
 63:       activatedSwitchIds.add(entity.id);
 64:     }
 65:   }
 66: 
 67:   const openGateIds = new Set<string>();
 68:   for (const entity of state.entities) {
 69:     if (entity.type !== "switch" || !activatedSwitchIds.has(entity.id)) continue;
 70:     if (entity.targetId) {
 71:       openGateIds.add(entity.targetId);
 72:     }
 73:   }
 74: 
 75:   const nextEntities = state.entities.map((entity: PuzzleEntity) => {
 76:     if (entity.id === unit.id && entity.type === "unit") {
 77:       return { ...entity, escaped: true };
 78:     }
 79:     if (entity.type === "switch" && activatedSwitchIds.has(entity.id)) {
 80:       return { ...entity, activated: true };
 81:     }
 82:     if (entity.type === "gate" && openGateIds.has(entity.id)) {
 83:       return { ...entity, open: true };
 84:     }
 85:     return entity;
 86:   });
 87: 
 88:   return {
 89:     action: { type: "exit", entityId: unit.id },
 90:     nextState: { ...state, entities: nextEntities },
 91:     outcome: "accepted",
 92:     accepted: true,
 93:     details: {
 94:       activatedSwitchIds: [...activatedSwitchIds].sort(),
 95:       openedGateIds: [...openGateIds].sort(),
 96:       consumedRotateCharge: false,
 97:       completedPuzzle: isPuzzleComplete({ ...state, entities: nextEntities }),
 98:     },
 99:   };
100: }
101: 
102: function applyRotate(state: PuzzleState, unit: UnitEntity): PuzzleActionResult {
103:   if (state.rotateChargesRemaining <= 0) {
104:     return {
105:       action: { type: "rotate", entityId: unit.id },
106:       nextState: state,
107:       outcome: "no_charges",
108:       accepted: false,
109:       details: {
110:         activatedSwitchIds: [],
111:         openedGateIds: [],
112:         consumedRotateCharge: false,
113:         completedPuzzle: false,
114:       },
115:     };
116:   }
117: 
118:   const nextEntities = state.entities.map(entity => {
119:     if (entity.id !== unit.id || entity.type !== "unit" || entity.escaped) {
120:       return entity;
121:     }
122:     return { ...entity, direction: rotateClockwise(entity.direction) };
123:   });
124: 
125:   return {
126:     action: { type: "rotate", entityId: unit.id },
127:     nextState: {
128:       ...state,
129:       entities: nextEntities,
130:       rotateChargesRemaining: state.rotateChargesRemaining - 1,
131:     },
132:     outcome: "accepted",
133:     accepted: true,
134:     details: {
135:       activatedSwitchIds: [],
136:       openedGateIds: [],
137:       consumedRotateCharge: true,
138:       completedPuzzle: false,
139:     },
140:   };
141: }
142: 
143: export function applyPuzzleAction(level: PuzzleLevel, state: PuzzleState, action: PuzzleAction): PuzzleActionResult {
144:   if (isPuzzleComplete(state)) {
145:     return {
146:       action,
147:       nextState: state,
148:       outcome: "already_complete",
149:       accepted: false,
150:       details: {
151:         activatedSwitchIds: [],
152:         openedGateIds: [],
153:         consumedRotateCharge: false,
154:         completedPuzzle: true,
155:       },
156:     };
157:   }
158: 
159:   if (action.type === "exit") {
160:     const unit = getLiveUnitById(state, action.entityId);
161:     if (!unit) {
162:       return {
163:         action,
164:         nextState: state,
165:         outcome: "invalid_target",
166:         accepted: false,
167:         details: {
168:           activatedSwitchIds: [],
169:           openedGateIds: [],
170:           consumedRotateCharge: false,
171:           completedPuzzle: false,
172:         },
173:       };
174:     }
175:     return applyExit(level, state, unit);
176:   }
177: 
178:   const unit = getLiveUnitById(state, action.entityId);
179:   if (!unit) {
180:     return {
181:       action,
182:       nextState: state,
183:       outcome: "invalid_target",
184:       accepted: false,
185:       details: {
186:         activatedSwitchIds: [],
187:         openedGateIds: [],
188:         consumedRotateCharge: false,
189:         completedPuzzle: false,
190:       },
191:     };
192:   }
193:   return applyRotate(state, unit);
194: }
195: 
196: export { isPuzzleComplete };
</file>

<file path="src/features/tribe-out/puzzle/selectors.ts">
 1: import { buildOccupancyMap } from "./occupancy";
 2: import { getForwardCellsUntilExit, getOccupiedCells } from "./geometry";
 3: import type { EntityId, PuzzleAction, PuzzleEntity, PuzzleLevel, PuzzleState, UnitEntity } from "./types";
 4: 
 5: export function getEntityById(state: PuzzleState, entityId: EntityId): PuzzleEntity | undefined {
 6:   return state.entities.find(entity => entity.id === entityId);
 7: }
 8: 
 9: export function getLiveUnitById(state: PuzzleState, entityId: EntityId): UnitEntity | undefined {
10:   const entity = getEntityById(state, entityId);
11:   if (!entity || entity.type !== "unit" || entity.escaped) {
12:     return undefined;
13:   }
14:   return entity;
15: }
16: 
17: export function canExitUnit(level: Pick<PuzzleLevel, "boardRows" | "boardCols">, state: PuzzleState, unit: UnitEntity): boolean {
18:   const occupancyMap = buildOccupancyMap(state.entities);
19:   const forwardCells = getForwardCellsUntilExit(unit, level.boardRows, level.boardCols);
20: 
21:   for (const cell of forwardCells) {
22:     const occupantId = occupancyMap.get(`${cell.row},${cell.col}`);
23:     if (occupantId && occupantId !== unit.id) {
24:       return false;
25:     }
26:   }
27: 
28:   return true;
29: }
30: 
31: function compareByEntityId<T extends { entityId: EntityId }>(left: T, right: T): number {
32:   return left.entityId.localeCompare(right.entityId);
33: }
34: 
35: export function listLegalExitActions(
36:   level: Pick<PuzzleLevel, "boardRows" | "boardCols">,
37:   state: PuzzleState,
38: ): Array<{ type: "exit"; entityId: EntityId }> {
39:   const actions: Array<{ type: "exit"; entityId: EntityId }> = [];
40:   for (const entity of state.entities) {
41:     if (entity.type !== "unit" || entity.escaped) continue;
42:     if (canExitUnit(level, state, entity)) {
43:       actions.push({ type: "exit", entityId: entity.id });
44:     }
45:   }
46:   return actions.sort(compareByEntityId);
47: }
48: 
49: export function listLegalRotateActions(state: PuzzleState): Array<{ type: "rotate"; entityId: EntityId }> {
50:   if (state.rotateChargesRemaining <= 0) {
51:     return [];
52:   }
53: 
54:   return state.entities
55:     .filter((entity): entity is UnitEntity => entity.type === "unit" && !entity.escaped)
56:     .map(entity => ({ type: "rotate" as const, entityId: entity.id }))
57:     .sort(compareByEntityId);
58: }
59: 
60: export function listLegalPuzzleActions(level: Pick<PuzzleLevel, "boardRows" | "boardCols">, state: PuzzleState): PuzzleAction[] {
61:   return [
62:     ...listLegalExitActions(level, state),
63:     ...listLegalRotateActions(state),
64:   ];
65: }
66: 
67: export function isPuzzleComplete(state: PuzzleState): boolean {
68:   return state.entities.filter(entity => entity.type === "unit").every(entity => entity.escaped);
69: }
70: 
71: export function getPathCells(unit: UnitEntity, level: Pick<PuzzleLevel, "boardRows" | "boardCols">): { row: number; col: number }[] {
72:   return [...getOccupiedCells(unit), ...getForwardCellsUntilExit(unit, level.boardRows, level.boardCols)];
73: }
</file>

