 24:     return (
 25:       <div style={{ width: size, height: size, position: "relative" }}>
 26:         <img 
 27:           src={resolvedImageUrl}
 28:           alt={assetKey}
 29:           style={{ width: "100%", height: "100%", objectFit: "contain", display: "block" }}
 30:           onError={() => setImageError(true)}
 31:           draggable={false}
 32:         />
 33:         {direction && (
 34:           <div style={{
 35:             position: "absolute",
 36:             inset: 0,
 37:             pointerEvents: "none",
 38:           }}>
 39:              <svg width={size} height={size} viewBox="0 0 100 100">
 40:                 <g transform={`rotate(${{ down: 0, left: 90, up: 180, right: 270 }[direction]} 50 50) translate(50 85)`}>
 41:                   <circle r="10" fill="#fff" stroke="#2a2418" strokeWidth="2" />
 42:                   <path d="M0 4.5 L-4.5 -3 L4.5 -3 Z" fill="#2a2418" />
 43:                 </g>
 44:              </svg>
 45:           </div>
 46:         )}
 47:       </div>
 48:     );
 49:   }
 50: 
 51:   // Fallback to SVG implementation
 52:   if (assetKey === "gate-open") return <GateSprite size={size} open={true} />;
 53:   if (assetKey === "gate-closed") return <GateSprite size={size} open={false} />;
 54:   if (assetKey === "switch-active") return <SwitchSprite size={size} active={true} />;
 55:   if (assetKey === "switch-inactive") return <SwitchSprite size={size} active={false} />;
 56:   
 57:   if (isObstacle) {
 58:     return <ObstacleSprite size={size} />;
 59:   }
 60:   return null;
 61: }
 62: 
 63: function ObstacleSprite({ size }: { size: number }) {
 64:   return (
 65:     <svg width={size} height={size} viewBox="0 0 100 100" style={{ display: "block" }}>
 66:       <ellipse cx="50" cy="82" rx="30" ry="8" fill="rgba(42,36,24,0.18)" />
 67:       <path
