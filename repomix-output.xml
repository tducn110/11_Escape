 4139: import { useState } from "react";
 4140: import { AnimalSprite } from "../AnimalSprite";
 4141: import { IMAGE_ASSETS } from "./assetRegistry";
 4142: import type { Direction } from "../types";
 4143: 
 4144: const ARROW_ROT: Record<Direction, number> = { up: 45, right: 135, down: 225, left: 315 };
 4145: 
 4146: interface GameSpriteProps {
 4147:   assetKey: string;
 4148:   isObstacle?: boolean;
 4149:   isSwitch?: boolean;
 4150:   direction?: Direction;
 4151:   size: number;
 4152: }
 4153: 
 4154: export function GameSprite({ assetKey, isObstacle, direction, size }: GameSpriteProps) {
 4155:   const [imageError, setImageError] = useState(false);
 4156:   const imageUrl = IMAGE_ASSETS[assetKey];
 4157: 
 4158:   if (imageUrl && !imageError) {
 4159:     return (
 4160:       <div style={{ width: size, height: size, position: "relative" }}>
 4161:         <img 
 4162:           src={imageUrl} 
 4163:           alt={assetKey}
 4164:           style={{ width: "100%", height: "100%", objectFit: "contain", display: "block" }}
 4165:           onError={() => setImageError(true)}
 4166:           draggable={false}
 4167:         />
 4168:         {direction && (
 4169:           <div style={{
 4170:             position: "absolute",
 4171:             inset: 0,
 4172:             pointerEvents: "none",
 4173:             transform: `rotate(${ARROW_ROT[direction]}deg)`
 4174:           }}>
 4175:              <svg width={size} height={size} viewBox="0 0 100 100">
 4176:                 <g transform="translate(50 12)">
 4177:                   <circle r="10" fill="#fff" stroke="#2a2418" strokeWidth="2" />
 4178:                   <path d="M0 -4.5 L4.5 3 L-4.5 3 Z" fill="#2a2418" />
 4179:                 </g>
 4180:              </svg>
 4181:           </div>
 4182:         )}
 4183:       </div>
 4184:     );
 4185:   }
 4186: 
 4187:   // Fallback to SVG implementation
 4188:   if (assetKey === "gate-open") return <GateSprite size={size} open={true} />;
 4189:   if (assetKey === "gate-closed") return <GateSprite size={size} open={false} />;
 4190:   if (assetKey === "switch-active") return <SwitchSprite size={size} active={true} />;
 4191:   if (assetKey === "switch-inactive") return <SwitchSprite size={size} active={false} />;
 4192:   
 4193:   if (isObstacle) {
 4194:     return <ObstacleSprite size={size} />;
 4195:   }
 4196:   return <AnimalSprite assetKey={assetKey} direction={direction} size={size} />;
 4197: }
