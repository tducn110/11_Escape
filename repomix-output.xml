 2833: function createTile(layout: IsoBoardLayout, row: number, col: number) {
 2834:   const tile = new Graphics();
 2835:   const halfWidth = Math.max(6, layout.tileWidth * 0.47);
 2836:   const halfHeight = Math.max(4, layout.tileHeight * 0.46);
 2837:   const depth = Math.max(4, layout.cellSize * 0.2);
 2838:   const isLight = (row + col) % 2 === 0;
 2839: 
 2840:   tile
 2841:     .poly([
 2842:       -halfWidth, 0,
 2843:       0, halfHeight,
 2844:       0, halfHeight + depth,
 2845:       -halfWidth, depth,
 2846:     ])
 2847:     .fill({ color: isLight ? 0x219f62 : 0x1b9258 });
 2848: 
 2849:   tile
 2850:     .poly([
 2851:       halfWidth, 0,
 2852:       0, halfHeight,
 2853:       0, halfHeight + depth,
 2854:       halfWidth, depth,
 2855:     ])
 2856:     .fill({ color: isLight ? 0x168553 : 0x12794b });
 2857: 
 2858:   tile
 2859:     .poly([
 2860:       0, -halfHeight,
 2861:       halfWidth, 0,
 2862:       0, halfHeight,
 2863:       -halfWidth, 0,
 2864:     ])
 2865:     .fill({ color: isLight ? 0x46df88 : 0x36cf7a })
 2866:     .stroke({
 2867:       width: Math.max(1, layout.cellSize * 0.035),
 2868:       color: 0x168c55,
 2869:       alpha: 0.68,
 2870:       join: "round",
 2871:     });
 2872: 
 2873:   tile
 2874:     .moveTo(-halfWidth * 0.72, -halfHeight * 0.03)
 2875:     .lineTo(0, -halfHeight * 0.72)
 2876:     .lineTo(halfWidth * 0.72, -halfHeight * 0.03)
 2877:     .stroke({
 2878:       width: Math.max(1, layout.cellSize * 0.025),
 2879:       color: 0xb5f3c9,
 2880:       alpha: 0.38,
 2881:       cap: "round",
 2882:       join: "round",
 2883:     });
 2884: 
 2885:   if ((row * 5 + col * 3) % 11 === 0) {
 2886:     tile
 2887:       .circle(-halfWidth * 0.23, halfHeight * 0.12, Math.max(1.2, layout.cellSize * 0.035))
 2888:       .fill({ color: 0xffa64d, alpha: 0.68 });
 2889:   }
 2890: 
 2891:   return tile;
 2892: }
