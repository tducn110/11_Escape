 85: function makePhase1(index: number): PuzzleLevel {
 86:   const count = 2 + ((index - 1) % 3);
 87:   const boardRows = 3 + (index % 2);
 88:   const boardCols = count + 2;
 89:   const entities: PuzzleEntity[] = [
 90:     ...buildChain({
 91:       row: 1,
 92:       startCol: 0,
 93:       segments: Array.from({ length: count }, (_, i) => ({ id: `u${i}`, width: 1 })),
 94:     }),
 95:   ];
 96: 
 97:   if (index % 4 === 0) {
 98:     entities.push(obstacle("o0", 0, boardCols - 1));
 99:   }
100: 
101:   return createLevel(index, {
102:     boardRows,
103:     boardCols,
104:     lives: baseLives(index),
105:     timeLimit: 16 + count * 3,
106:     tutorialText: phaseTutorial(index),
107:     rotateCharges: 0,
108:     entities,
109:   });
110: }
