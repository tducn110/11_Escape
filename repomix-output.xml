182:     if (!this.sfxEnabled) return;
183:     if (this.playBuffer("win", this.sfxToneVolume(1.0))) return;
184: 
185:     this.withRunningContext((context) => {
186:       const now = context.currentTime + 0.01;
187:       const notes = [523.25, 659.25, 783.99, 1046.5];
188:       notes.forEach((freq, idx) => {
