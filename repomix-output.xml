 4391:       
 4392:       for (const [key, url] of Object.entries(AUDIO_ASSETS)) {
 4393:         if (!this.audioBuffers.has(key)) {
 4394:           fetch(url)
 4395:             .then(res => res.arrayBuffer())
 4396:             .then(buffer => context.decodeAudioData(buffer))
 4397:             .then(audioBuffer => this.audioBuffers.set(key, audioBuffer))
 4398:             .catch(e => console.warn(`Failed to load audio asset: ${key}`, e));
 4399:         }
 4400:       }
 4401:     } catch {
 4402:       // Ignore
 4403:     }
 4404:   }
