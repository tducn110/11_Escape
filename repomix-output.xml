 4551:   private ensureContext(): AudioContext | null {
 4552:     if (typeof window === "undefined") return null;
 4553:     if (this.context && this.context.state !== "closed") return this.context;
 4554: 
 4555:     const AudioCtor =
 4556:       window.AudioContext ??
 4557:       (window as Window & typeof globalThis & { webkitAudioContext?: typeof AudioContext })
 4558:         .webkitAudioContext;
 4559: 
 4560:     if (!AudioCtor) return null;
 4561: 
 4562:     try {
 4563:       this.context = new AudioCtor();
 4564:       this.masterBgmGain = this.context.createGain();
 4565:       this.masterSfxGain = this.context.createGain();
 4566: 
 4567:       this.masterBgmGain.gain.value = this.musicEnabled ? 1 : 0;
 4568:       this.masterSfxGain.gain.value = this.sfxEnabled ? 1 : 0;
 4569: 
 4570:       this.masterBgmGain.connect(this.context.destination);
 4571:       this.masterSfxGain.connect(this.context.destination);
 4572:     } catch {
 4573:       return null;
 4574:     }
 4575: 
 4576:     return this.context;
 4577:   }
 4578: 
 4579:   private resumeContext(): AudioContext | null {
 4580:     const context = this.ensureContext();
 4581:     if (!context) return null;
 4582: 
 4583:     if (context.state === "suspended") {
 4584:       context.resume().catch(() => {});
 4585:     }
 4586: 
 4587:     return context;
 4588:   }
 4589: 
 4590:   private withRunningContext(callback: (context: AudioContext) => void) {
 4591:     if (typeof document !== "undefined" && document.hidden) return;
 4592: 
 4593:     const context = this.resumeContext();
 4594:     if (!context) return;
 4595: 
 4596:     if (context.state === "running") {
 4597:       callback(context);
 4598:     } else {
 4599:       this.addUnlockListeners();
 4600:       // Execute callback anyway; audio will play once resumed
 4601:       callback(context);
 4602:     }
 4603:   }
 4604: 
 4605:   private playBuffer(key: string, volume: number): boolean {
 4606:     const buffer = this.audioBuffers.get(key);
 4607:     if (!buffer) return false;
 4608:     
 4609:     this.withRunningContext((context) => {
 4610:       try {
 4611:         const source = context.createBufferSource();
 4612:         source.buffer = buffer;
 4613:         
 4614:         const gain = context.createGain();
 4615:         gain.gain.value = volume;
 4616:         
 4617:         source.connect(gain);
 4618:         if (this.masterSfxGain) {
 4619:           gain.connect(this.masterSfxGain);
 4620:         }
 4621:         source.start(0);
 4622:       } catch {
 4623:         // Ignore synthesis errors
 4624:       }
 4625:     });
 4626:     
 4627:     return true;
 4628:   }
 4629: 
 4630:   private tone(
 4631:     context: AudioContext,
 4632:     frequency: number,
 4633:     startTime: number,
 4634:     duration: number,
 4635:     options: ToneOptions = {}
 4636:   ) {
 4637:     try {
 4638:       const oscillator = context.createOscillator();
 4639:       const gain = context.createGain();
 4640:       const attack = options.attack ?? 0.012;
 4641:       const release = options.release ?? 0.08;
 4642:       const volume = options.volume ?? 0.04;
 4643:       const stopTime = startTime + duration + release;
 4644: 
 4645:       oscillator.type = options.waveform ?? "sine";
 4646:       oscillator.frequency.setValueAtTime(frequency, startTime);
 4647:       if (options.freqEnd) {
 4648:         oscillator.frequency.exponentialRampToValueAtTime(options.freqEnd, startTime + attack + 0.05);
 4649:       }
 4650: 
 4651:       gain.gain.setValueAtTime(0.0001, startTime);
 4652:       gain.gain.linearRampToValueAtTime(volume, startTime + attack);
 4653:       gain.gain.exponentialRampToValueAtTime(0.0001, stopTime);
 4654: 
 4655:       oscillator.connect(gain);
 4656:       if (this.masterSfxGain) {
 4657:         gain.connect(this.masterSfxGain);
 4658:       }
 4659:       oscillator.start(startTime);
 4660:       oscillator.stop(stopTime + 0.02);
 4661:     } catch {
 4662:       // Ignore audio synthesis errors
 4663:     }
 4664:   }
 4665: 
 4666:   private addUnlockListeners() {
 4667:     if (typeof window === "undefined" || this.unlockListenersBound) return;
 4668: 
 4669:     window.addEventListener("pointerdown", this.unlock, { passive: true });
 4670:     window.addEventListener("touchstart", this.unlock, { passive: true });
 4671:     window.addEventListener("keydown", this.unlock);
 4672:     this.unlockListenersBound = true;
 4673:   }
 4674: 
 4675:   private removeUnlockListeners() {
 4676:     if (typeof window === "undefined" || !this.unlockListenersBound) return;
 4677: 
 4678:     window.removeEventListener("pointerdown", this.unlock);
 4679:     window.removeEventListener("touchstart", this.unlock);
 4680:     window.removeEventListener("keydown", this.unlock);
 4681:     this.unlockListenersBound = false;
 4682:   }
 4683: 
 4684:   private audioConfig() {
 4685:     const isMobile = () => {
 4686:       if (typeof window === "undefined") return false;
 4687:       const uaMatch = /Mobi|Android|iPhone|iPad|iPod|IEMobile|BlackBerry|Opera Mini/i.test(
 4688:         navigator.userAgent
 4689:       );
 4690:       const widthMatch = window.matchMedia("(max-width: 1024px)").matches;
 4691:       const touchMatch = "ontouchstart" in window || navigator.maxTouchPoints > 0;
 4692:       return uaMatch || widthMatch || touchMatch;
 4693:     };
 4694:     const forceMobile = this.mobileAudioMode || isMobile();
 4695:     return forceMobile ? MOBILE_AUDIO : DESKTOP_AUDIO;
 4696:   }
 4697: 
 4698:   private sfxToneVolume(volume: number) {
 4699:     const config = this.audioConfig();
 4700:     return clampVolume(config.masterVolume * config.sfxVolume * volume * TONE_SFX_GAIN);
 4701:   }
 4702: 
 4703:   private addVisibilityListener() {
 4704:     if (typeof document === "undefined" || this.visibilityListenerBound) return;
 4705:     document.addEventListener("visibilitychange", this.handleVisibilityChange);
 4706:     this.visibilityListenerBound = true;
 4707:   }
 4708: 
 4709:   private removeVisibilityListener() {
 4710:     if (typeof document === "undefined" || !this.visibilityListenerBound) return;
 4711:     document.removeEventListener("visibilitychange", this.handleVisibilityChange);
 4712:     this.visibilityListenerBound = false;
 4713:   }
 4714: 
 4715:   dispose() {
 4716:     this.removeUnlockListeners();
 4717:     this.removeVisibilityListener();
 4718:     this.visibilityListenerBound = false;
 4719:     if (this.context && this.context.state !== "closed") {
 4720:       this.context.close?.()?.catch(() => {});
 4721:     }
 4722:     this.context = null;
 4723:     this.masterBgmGain = null;
 4724:     this.masterSfxGain = null;
 4725:   }
 4726: }
 4727: 
 4728: export const tribeOutAudio = new TribeOutAudio();
