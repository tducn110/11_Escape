 3052: <file path="src/features/tribe-out/isometric.ts">
 3053: import type { TribeOutEntity } from "./types";
 3054: 
 3055: export interface IsoBoardLayout {
 3056:   cellSize: number;
 3057:   tileWidth: number;
 3058:   tileHeight: number;
 3059:   stepX: number;
 3060:   stepY: number;
 3061:   paddingX: number;
 3062:   paddingY: number;
 3063:   stageWidth: number;
 3064:   stageHeight: number;
 3065:   originX: number;
 3066:   originY: number;
 3067: }
 3068: 
 3069: const MIN_CELL_SIZE = 16;
 3070: const MAX_CELL_SIZE = 112;
 3071: const MAX_STAGE_WIDTH = 1000;
 3072: const BOARD_GUTTER = 8;
 3073: 
 3074: function clamp(value: number, min: number, max: number) {
 3075:   return Math.max(min, Math.min(value, max));
 3076: }
 3077: 
 3078: export function getIsoBoardLayout(
 3079:   boardRows: number,
 3080:   boardCols: number,
 3081:   availableWidth: number,
 3082:   availableHeight: number
 3083: ): IsoBoardLayout {
 3084:   const span = boardRows + boardCols;
 3085:   const widthFactor = span * 0.76 + 1.16;
 3086:   const heightFactor = Math.max(0, span - 2) * 0.38 + 2.65;
 3087:   const fallbackCellSize = 44;
 3088: 
 3089:   const safeWidth =
 3090:     availableWidth > 0
 3091:       ? Math.max(0, Math.min(availableWidth, MAX_STAGE_WIDTH + BOARD_GUTTER) - BOARD_GUTTER)
 3092:       : widthFactor * fallbackCellSize;
 3093:   const safeHeight =
 3094:     availableHeight > 0
 3095:       ? Math.max(0, availableHeight - BOARD_GUTTER)
 3096:       : heightFactor * fallbackCellSize;
 3097:   const byWidth = Math.floor(safeWidth / widthFactor);
 3098:   const byHeight = Math.floor(safeHeight / heightFactor);
 3099:   const cellSize = clamp(
 3100:     Math.min(byWidth || fallbackCellSize, byHeight || fallbackCellSize, MAX_CELL_SIZE),
 3101:     MIN_CELL_SIZE,
 3102:     MAX_CELL_SIZE
 3103:   );
 3104: 
 3105:   const tileWidth = Math.round(cellSize * 1.52);
 3106:   const tileHeight = Math.round(cellSize * 0.76);
 3107:   const stepX = tileWidth / 2;
 3108:   const stepY = tileHeight / 2;
 3109:   const paddingX = Math.round(cellSize * 0.58);
 3110:   const paddingY = Math.round(cellSize * 0.5);
 3111:   const stageWidth = Math.round(span * stepX + paddingX * 2);
 3112:   const stageHeight = Math.round(Math.max(0, span - 2) * stepY + cellSize * 2.65);
 3113: 
 3114:   return {
 3115:     cellSize,
 3116:     tileWidth,
 3117:     tileHeight,
 3118:     stepX,
 3119:     stepY,
 3120:     paddingX,
 3121:     paddingY,
 3122:     stageWidth,
 3123:     stageHeight,
 3124:     originX: paddingX + boardRows * stepX,
 3125:     originY: paddingY + cellSize * 1.15,
 3126:   };
 3127: }
 3128: 
 3129: export function projectIsoPoint(layout: IsoBoardLayout, row: number, col: number) {
 3130:   return {
 3131:     x: layout.originX + (col - row) * layout.stepX,
 3132:     y: layout.originY + (col + row) * layout.stepY,
 3133:   };
 3134: }
 3135: 
 3136: export function projectIsoEntity(layout: IsoBoardLayout, entity: TribeOutEntity) {
 3137:   const centerRow = entity.row + (entity.height - 1) / 2;
 3138:   const centerCol = entity.col + (entity.width - 1) / 2;
 3139:   const point = projectIsoPoint(layout, centerRow, centerCol);
 3140:   
 3141:   // Z-index should be based on the furthest bottom tile (max row + max col)
 3142:   const lowestPoint = projectIsoPoint(layout, entity.row + entity.height - 1, entity.col + entity.width - 1);
 3143: 
 3144:   const footprint = Math.max(entity.width, entity.height);
 3145:   const baseSize = footprint * layout.cellSize;
 3146:   const visualSize = entity.type === "obstacle" ? baseSize * 0.88 : baseSize * 1.08;
 3147: 
 3148:   return {
 3149:     x: point.x,
 3150:     y: point.y,
 3151:     zIndex: 100 + Math.round(lowestPoint.y),
 3152:     size: visualSize,
 3153:   };
 3154: }
