43005: <file path="src/features/tribe-out/TribeOutBoard.tsx">
43006: import { TribeOutEntityComponent } from "./TribeOutEntity";
43007: import type { TribeOutEntity } from "./types";
43008: import type { IsoBoardLayout } from "./isometric";
43009: import { IsometricBoardBackdrop } from "./pixi/IsometricBoardBackdrop";
43010: 
43011: interface Props {
43012:   entities: TribeOutEntity[];
43013:   boardRows: number;
43014:   boardCols: number;
43015:   layout: IsoBoardLayout;
43016:   bumpingId: string | null;
43017:   bumpNonce: number;
43018:   hintedId?: string | null;
43019:   onTap: (id: string) => void;
43020: }
43021: 
43022: export function TribeOutBoard({ entities, boardRows, boardCols, layout, bumpingId, bumpNonce, hintedId, onTap }: Props) {
43023:   const boardWidth = layout.stageWidth;
43024:   const boardHeight = layout.stageHeight;
43025: 
43026:   return (
43027:     <div
43028:       role="group"
43029:       aria-label={`Bàn chơi ${boardRows} hàng ${boardCols} cột`}
43030:       style={{
43031:         position: "relative",
43032:         width: boardWidth,
43033:         height: boardHeight,
43034:         margin: "0 auto",
43035:         flexShrink: 0,
43036:         isolation: "isolate",
43037:       }}
43038:     >
43039:       <IsometricBoardBackdrop layout={layout} boardRows={boardRows} boardCols={boardCols} />
43040: 
43041:       {/* Entities */}
43042:       {entities.map(entity => (
43043:         <TribeOutEntityComponent
43044:           key={entity.id}
43045:           entity={entity}
43046:           layout={layout}
43047:           isBumping={bumpingId === entity.id}
43048:           bumpNonce={bumpingId === entity.id ? bumpNonce : 0}
43049:           isHinted={hintedId === entity.id}
43050:           onTap={onTap}
43051:         />
43052:       ))}
43053:     </div>
43054:   );
43055: }
43056: </file>
