<file path="src/features/tribe-out/gameLogic.test.ts">
import { describe, it, expect, vi } from "vitest";
import {
  canExit,
  applyTapUnit,
  applyRotateUnit,
  getForwardCellsUntilExit,
  getOccupiedCells,
  buildOccupancyMap
} from "./gameLogic";
import type { GameState, TribeOutEntity, TribeOutProgressSnapshot } from "./types";
import { LEVELS } from "./levels";

describe("gameLogic", () => {
  it("rotate charge and direction", () => {
    const state: GameState = {
      status: "playing",
      rotateCharges: 1,
      selectedTool: "rotate",
      currentLevelIndex: 0,
      lives: 3,
      coins: 0,
      escapedCount: 0,
      totalUnits: 1,
      entities: [
        { id: "u1", type: "unit", direction: "up", row: 1, col: 1, width: 1, height: 1, assetKey: "rock" }
      ],
      lastBumpedEntityId: null,
      lastEscapedEntityId: null,
      coinsEarnedThisLevel: 0,
      hintsUsed: 0,
    };
    
    const nextState = applyRotateUnit(state, "u1");
    expect(nextState.rotateCharges).toBe(0);
    expect(nextState.selectedTool).toBe("none");
    expect(nextState.entities[0].direction).toBe("right");

    const noRotateState = applyRotateUnit(nextState, "u1");
    expect(noRotateState.entities[0].direction).toBe("right"); // No charges
  });

  it("gate open does not block, closed gate blocks", () => {
    const entities: TribeOutEntity[] = [
      { id: "u1", type: "unit", direction: "right", row: 0, col: 0, width: 1, height: 1, assetKey: "" },
      { id: "g1", type: "gate", row: 0, col: 1, width: 1, height: 1, open: false, assetKey: "" }
    ];
    
    // Closed gate blocks
    expect(canExit(entities[0], entities, 1, 3)).toBe(false);

    // Open gate doesn't block
    entities[1].open = true;
    expect(canExit(entities[0], entities, 1, 3)).toBe(true);
  });

  it("multi-cell unit blocking", () => {
    const entities: TribeOutEntity[] = [
      { id: "u1", type: "unit", direction: "right", row: 0, col: 0, width: 1, height: 1, assetKey: "" },
      { id: "u2", type: "unit", direction: "down", row: 0, col: 1, width: 1, height: 2, assetKey: "" }
    ];
    expect(canExit(entities[0], entities, 2, 2)).toBe(false);
  });

  it("switch activates only if unit can escape", () => {
    const state: GameState = {
      status: "playing", rotateCharges: 0, selectedTool: "none",
      currentLevelIndex: 0, lives: 3, coins: 0, escapedCount: 0, totalUnits: 1,
      entities: [
        { id: "u1", type: "unit", direction: "right", row: 0, col: 0, width: 1, height: 1, assetKey: "" },
        { id: "s1", type: "switch", row: 0, col: 1, width: 1, height: 1, targetId: "g1", activated: false, assetKey: "" },
        { id: "g1", type: "gate", row: 1, col: 1, width: 1, height: 1, open: false, assetKey: "" }
      ],
      lastBumpedEntityId: null, lastEscapedEntityId: null, coinsEarnedThisLevel: 0, hintsUsed: 0,
    };
    const snap: TribeOutProgressSnapshot = { highestUnlockedLevel: 0, coins: 0, currentLevelIndex: 0, levelStars: {} };
    
    // Switch is at (0,1). Path is right. Exit is clear. 
    // u1 escapes -> switch activated -> gate open.
    const res = applyTapUnit("u1", state, snap);
    expect(res.nextState.entities.find(e => e.id === "u1")?.escaped).toBe(true);
    expect(res.nextState.entities.find(e => e.id === "s1")?.activated).toBe(true);
    expect(res.nextState.entities.find(e => e.id === "g1")?.open).toBe(true);
  });

  it("switch does not activate if path is blocked", () => {
    const state: GameState = {
      status: "playing", rotateCharges: 0, selectedTool: "none",
      currentLevelIndex: 0, lives: 3, coins: 0, escapedCount: 0, totalUnits: 1,
      entities: [
        { id: "u1", type: "unit", direction: "right", row: 0, col: 0, width: 1, height: 1, assetKey: "" },
        { id: "s1", type: "switch", row: 0, col: 1, width: 1, height: 1, targetId: "g1", activated: false, assetKey: "" },
        { id: "o1", type: "obstacle", row: 0, col: 2, width: 1, height: 1, assetKey: "" },
        { id: "g1", type: "gate", row: 1, col: 1, width: 1, height: 1, open: false, assetKey: "" }
      ],
      lastBumpedEntityId: null, lastEscapedEntityId: null, coinsEarnedThisLevel: 0, hintsUsed: 0,
    };
    const snap: TribeOutProgressSnapshot = { highestUnlockedLevel: 0, coins: 0, currentLevelIndex: 0, levelStars: {} };
    
    // Path blocked by o1
    const res = applyTapUnit("u1", state, snap);
    expect(res.nextState.entities.find(e => e.id === "u1")?.escaped).toBeFalsy();
    expect(res.nextState.entities.find(e => e.id === "s1")?.activated).toBeFalsy();
    expect(res.nextState.entities.find(e => e.id === "g1")?.open).toBe(false);
  });
});
</file>

