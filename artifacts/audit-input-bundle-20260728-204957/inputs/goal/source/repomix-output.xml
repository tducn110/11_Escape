<file path="src/features/tribe-out/gameLogic.ts">
import type { TribeOutEntity, GameState, TribeOutProgressSnapshot, TribeOutTapResult } from "./types";
import { LEVELS } from "./levels";

export function getOccupiedCells(entity: TribeOutEntity): { row: number; col: number }[] {
  const cells: { row: number; col: number }[] = [];
  for (let r = entity.row; r < entity.row + entity.height; r++) {
    for (let c = entity.col; c < entity.col + entity.width; c++) {
      cells.push({ row: r, col: c });
    }
  }
  return cells;
}

export function isInsideBoard(row: number, col: number, boardRows: number, boardCols: number): boolean {
  return row >= 0 && row < boardRows && col >= 0 && col < boardCols;
}

// Returns a map from "row,col" → entityId for all non-escaped entities.
export function buildOccupancyMap(entities: TribeOutEntity[]): Map<string, string> {
  const map = new Map<string, string>();
  for (const entity of entities) {
    if (entity.type === "unit" && entity.escaped) continue;
    if (entity.type === "switch") continue;
    if (entity.type === "gate" && entity.open) continue;
    for (const cell of getOccupiedCells(entity)) {
      map.set(`${cell.row},${cell.col}`, entity.id);
    }
  }
  return map;
}

// Returns every cell in front of the unit's leading edge until the board boundary.
export function getForwardCellsUntilExit(
  unit: TribeOutEntity,
  boardRows: number,
  boardCols: number
): { row: number; col: number }[] {
  const cells: { row: number; col: number }[] = [];
  const { direction, row, col, width, height } = unit;

  if (direction === "up") {
    for (let r = row - 1; r >= 0; r--) {
      for (let c = col; c < col + width; c++) cells.push({ row: r, col: c });
    }
  } else if (direction === "down") {
    for (let r = row + height; r < boardRows; r++) {
      for (let c = col; c < col + width; c++) cells.push({ row: r, col: c });
    }
  } else if (direction === "left") {
    for (let c = col - 1; c >= 0; c--) {
      for (let r = row; r < row + height; r++) cells.push({ row: r, col: c });
    }
  } else if (direction === "right") {
    for (let c = col + width; c < boardCols; c++) {
      for (let r = row; r < row + height; r++) cells.push({ row: r, col: c });
    }
  }

  return cells;
}

export function canExit(
  unit: TribeOutEntity,
  entities: TribeOutEntity[],
  boardRows: number,
  boardCols: number
): boolean {
  if (!unit.direction) return false;
  const occupancyMap = buildOccupancyMap(entities);
  const forwardCells = getForwardCellsUntilExit(unit, boardRows, boardCols);
  for (const cell of forwardCells) {
    const occupantId = occupancyMap.get(`${cell.row},${cell.col}`);
    if (occupantId && occupantId !== unit.id) return false;
  }
  return true;
}

export function getAvailableUnits(state: GameState, boardRows: number, boardCols: number): string[] {
  const available: string[] = [];
  for (const entity of state.entities) {
    if (entity.type === "unit" && !entity.escaped) {
      if (canExit(entity, state.entities, boardRows, boardCols)) {
        available.push(entity.id);
      }
    }
  }
  return available;
}

function sanitizeCoins(savedCoins: number): number {
  return Number.isFinite(savedCoins) ? savedCoins : 0;
}

export function buildInitialGameState(levelIndex: number, savedCoins = 0): GameState {
  const level = LEVELS[levelIndex];
  const entities = level.entities.map(e => ({ ...e, escaped: false }));
  const totalUnits = entities.filter(e => e.type === "unit").length;
  return {
    currentLevelIndex: levelIndex,
    lives: level.lives,
    coins: sanitizeCoins(savedCoins),
    escapedCount: 0,
    totalUnits,
    status: "playing",
    entities,
    lastBumpedEntityId: null,
    lastEscapedEntityId: null,
    coinsEarnedThisLevel: 0,
    timeRemaining: level.timeLimit,
    hintsUsed: 0,
    rotateCharges: 1,
    selectedTool: "none",
  };
}

export function buildNextLevelState(currentState: GameState, nextLevelIndex: number): GameState {
  const level = LEVELS[nextLevelIndex];
  const entities = level.entities.map(e => ({ ...e, escaped: false }));
  const totalUnits = entities.filter(e => e.type === "unit").length;
  return {
    currentLevelIndex: nextLevelIndex,
    lives: level.lives,
    coins: currentState.coins,
    escapedCount: 0,
    totalUnits,
    status: "playing",
    entities,
    lastBumpedEntityId: null,
    lastEscapedEntityId: null,
    coinsEarnedThisLevel: 0,
    timeRemaining: level.timeLimit,
    hintsUsed: 0,
    rotateCharges: 1,
    selectedTool: "none",
  };
}

export function resetLevel(state: GameState): GameState {
  const level = LEVELS[state.currentLevelIndex];
  const entities = level.entities.map(e => ({ ...e, escaped: false }));
  const totalUnits = entities.filter(e => e.type === "unit").length;
  return {
    currentLevelIndex: state.currentLevelIndex,
    lives: level.lives,
    coins: Math.max(0, state.coins - state.coinsEarnedThisLevel),
    escapedCount: 0,
    totalUnits,
    status: "playing",
    entities,
    lastBumpedEntityId: null,
    lastEscapedEntityId: null,
    coinsEarnedThisLevel: 0,
    timeRemaining: level.timeLimit,
    hintsUsed: 0,
    rotateCharges: 1,
    selectedTool: "none",
  };
}

function buildWinProgressSnapshot(
  state: GameState,
  nextCoins: number,
  savedProgress: TribeOutProgressSnapshot,
  stars: number
): TribeOutProgressSnapshot {
  const currentBest = savedProgress.levelStars[state.currentLevelIndex] || 0;
  return {
    coins: nextCoins,
    highestUnlockedLevel: Math.max(savedProgress.highestUnlockedLevel, state.currentLevelIndex + 1),
    currentLevelIndex: state.currentLevelIndex,
    levelStars: {
      ...savedProgress.levelStars,
      [state.currentLevelIndex]: Math.max(currentBest, stars),
    }
  };
}

export function applyTapUnit(
  unitId: string,
  state: GameState,
  savedProgress: TribeOutProgressSnapshot
): TribeOutTapResult {
  if (state.status !== "playing") {
    return { nextState: state, progressSnapshot: null };
  }

  const entity = state.entities.find(e => e.id === unitId);
  if (!entity || entity.type === "obstacle" || entity.escaped) {
    return { nextState: state, progressSnapshot: null };
  }

  const level = LEVELS[state.currentLevelIndex];

  if (canExit(entity, state.entities, level.boardRows, level.boardCols)) {
    const forwardCells = getForwardCellsUntilExit(entity, level.boardRows, level.boardCols);
    const pathCells = [...getOccupiedCells(entity), ...forwardCells];
    
    const activatedSwitches = new Set<string>();
    for (const e of state.entities) {
      if (e.type === "switch" && !e.activated) {
        const switchCells = getOccupiedCells(e);
        const overlap = switchCells.some(sc => pathCells.some(pc => pc.row === sc.row && pc.col === sc.col));
        if (overlap) {
          activatedSwitches.add(e.id);
        }
      }
    }
    
    const targetGateIds = new Set<string>();
    for (const swId of activatedSwitches) {
      const sw = state.entities.find(e => e.id === swId);
      if (sw && sw.targetId) targetGateIds.add(sw.targetId);
    }

    const newEntities = state.entities.map(e => {
      if (e.id === unitId) return { ...e, escaped: true };
      if (activatedSwitches.has(e.id)) return { ...e, activated: true };
      if (e.type === "gate" && targetGateIds.has(e.id)) return { ...e, open: true };
      return e;
    });
    
    const newEscapedCount = state.escapedCount + 1;
    const allEscaped = newEntities.filter(e => e.type === "unit").every(e => e.escaped);

    let bonusCoins = 0;
    let newStatus: GameState["status"] = "playing";
    let progressSnapshot: TribeOutProgressSnapshot | null = null;

    if (allEscaped) {
      newStatus = "won";
      
      let stars = 1;
      if (state.lives === level.lives) stars++;
      if (state.hintsUsed === 0 && (state.timeRemaining ?? 0) > 0) stars++;
      
      const previousStars = savedProgress.levelStars[state.currentLevelIndex] || 0;
      const isReplay = previousStars > 0;
      // if replay, we shouldn't farm bonus coins infinitely
      bonusCoins = isReplay ? 0 : (50 + stars * 20);
      const totalCoins = state.coins + (isReplay ? 0 : 10) + bonusCoins;

      progressSnapshot = buildWinProgressSnapshot(state, totalCoins, savedProgress, stars);
      
      return {
        nextState: {
          ...state,
          entities: newEntities,
          escapedCount: newEscapedCount,
          coins: totalCoins,
          coinsEarnedThisLevel: state.coinsEarnedThisLevel + (isReplay ? 0 : 10) + bonusCoins,
          status: newStatus,
          lastEscapedEntityId: unitId,
          lastBumpedEntityId: null,
          stars,
        },
        progressSnapshot,
      };
    }

    return {
      nextState: {
        ...state,
        entities: newEntities,
        escapedCount: newEscapedCount,
        coins: state.coins + 10 + bonusCoins,
        coinsEarnedThisLevel: state.coinsEarnedThisLevel + 10 + bonusCoins,
        status: newStatus,
        lastEscapedEntityId: unitId,
        lastBumpedEntityId: null,
      },
      progressSnapshot,
    };
  } else {
    const newLives = state.lives - 1;
    return {
      nextState: {
        ...state,
        lives: newLives,
        status: newLives <= 0 ? "lost" : "playing",
        lastBumpedEntityId: unitId,
        lastEscapedEntityId: null,
      },
      progressSnapshot: null,
    };
  }
}

export function applyRotateUnit(state: GameState, unitId: string): GameState {
  if (state.status !== "playing" || state.rotateCharges <= 0) return state;

  const newEntities = state.entities.map(e => {
    if (e.id === unitId && e.type === "unit" && !e.escaped) {
      const directions: ("up" | "right" | "down" | "left")[] = ["up", "right", "down", "left"];
      const currentIdx = directions.indexOf(e.direction!);
      const nextDir = directions[(currentIdx + 1) % 4];
      return { ...e, direction: nextDir };
    }
    return e;
  });

  return {
    ...state,
    entities: newEntities,
    rotateCharges: state.rotateCharges - 1,
    selectedTool: "none",
  };
}
