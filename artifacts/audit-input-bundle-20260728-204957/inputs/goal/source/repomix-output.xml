<file path="scripts/solver.ts">
import { LEVELS } from "../src/features/tribe-out/levels";
import { canExit } from "../src/features/tribe-out/gameLogic";
import type { TribeOutEntity } from "../src/features/tribe-out/types";

function solveLevel(level: typeof LEVELS[0]) {
  const { boardRows, boardCols, entities } = level;
  
  let stateEntities = JSON.parse(JSON.stringify(entities)) as TribeOutEntity[];
  let solved = false;
  let steps = 0;
  
  while (true) {
    let movedAny = false;
    
    // Simplistic solver without rotate for now, just finds any unit that can escape and escapes it
    for (const unit of stateEntities) {
      if (unit.type === "unit" && !unit.escaped) {
        if (canExit(unit, stateEntities, boardRows, boardCols)) {
          unit.escaped = true;
          movedAny = true;
          steps++;
          break; // break loop to restart check with updated occupancy
        }
      }
    }
    
    const remainingUnits = stateEntities.filter(e => e.type === "unit" && !e.escaped);
    if (remainingUnits.length === 0) {
      solved = true;
      break;
    }
    
    if (!movedAny) {
      break; // Stuck
    }
  }
  
  return {
    id: level.id,
    solved,
    units: entities.filter(e => e.type === "unit").length,
    steps,
  };
}

let unsolvable = 0;
for (const level of LEVELS) {
  if (level.id !== 22) continue; // JUST debug level 22
  const res = solveLevel(level);
  if (!res.solved) {
    if (level.id > 5) {
      console.log(`Level ${level.id} is NOT solvable!`);
      console.dir(level.entities, { depth: null });
      unsolvable++;
    }
  }
}

console.log(`Validation complete. Unsolvable auto-generated levels: ${unsolvable}`);
</file>

