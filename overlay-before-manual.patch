 }
+
+/* ══════════════════════════════════════════════════
+   END GAME OVERLAY  (WinOverlay / LoseOverlay)
+   ══════════════════════════════════════════════════
+
+   All asset PNGs share a 1536×1024 canvas.
+   Actual artwork alpha bounding boxes (alpha > 128):
+
+     khung.png      (139,200)→(1387,826)  1249×627  ratio 1.99  fill 49.8%
+     bangten.png    (143,337)→(1385,639)  1243×303  ratio 4.10  fill 23.9%
+     sao.png        (523,225)→(1004,690)   482×466  ratio 1.03  fill 14.3%
+     continue.png   (201,310)→(1332,673)  1132×364  ratio 3.11  fill 26.2%
+     again.png      (259,351)→(1278,633)  1020×283  ratio 3.60  fill 18.4%
+     decorate.png   (378,115)→(1039,816)   662×702  ratio 0.94  fill 29.5%
+     decorate2.png  (320,197)→(1201,752)   882×556  ratio 1.59  fill 31.2%
+
+   Parchment safe-area inside khung: L≈16.7% T≈24% R≈16.5% B≈26.7% of canvas.
+
+   Strategy: CSS crop wrappers with overflow:hidden + negative margins
+   to remove transparent canvas padding at render time.
+   ══════════════════════════════════════════════════ */
+
+/* Keyframes */
+@keyframes egOverlayIn {
+  0%   { opacity: 0; }
+  100% { opacity: 1; }
+}
+
+@keyframes egCardIn {
+  0%   { opacity: 0; transform: scale(0.82) translateY(32px); }
+  60%  { transform: scale(1.04) translateY(-6px); }
+  100% { opacity: 1; transform: scale(1) translateY(0); }
+}
+
+@keyframes egBannerIn {
+  0%   { opacity: 0; transform: translateX(-50%) translateY(-20px) scaleX(0.85); }
+  100% { opacity: 1; transform: translateX(-50%) translateY(0) scaleX(1); }
+}
+
+@keyframes egStarPop {
+  0%   { opacity: 0; transform: scale(0) rotate(-20deg); }
+  60%  { transform: scale(1.25) rotate(8deg); }
+  100% { opacity: 1; transform: scale(1) rotate(0deg); }
+}
+
+@keyframes egConfettiIn {
+  0%   { opacity: 0; transform: scale(0.6); }
+  100% { opacity: 1; transform: scale(1); }
+}
+
+/* ── Overlay backdrop — fixed full-screen ─────────── */
+.eg-overlay {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(18, 32, 12, 0.70);
+  backdrop-filter: blur(5px);
+  z-index: 100;
+  animation: egOverlayIn 0.22s ease forwards;
+  padding: 24px 16px;
+  box-sizing: border-box;
+}
+
+.eg-overlay--lose {
+  background: rgba(30, 18, 8, 0.72);
+}
+
+/* ── Card wrapper ─────────────────────────────────── */
+/* khung artwork = 81.3% of canvas width → 680px canvas ≈ 553px visible frame */
+.eg-card-wrap {
+  position: relative;
+  z-index: 2;
+  width: min(680px, calc(100vw - 32px));
+  max-height: calc(100vh - 48px);
+  animation: egCardIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+}
+
+/* Confetti burst — anchored to card, not viewport */
+.eg-confetti {
+  position: absolute;
+  bottom: -8%;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 85%;
+  pointer-events: none;
+  animation: egConfettiIn 0.5s 0.15s ease both;
+  z-index: 0;
+}
+
+/* ── Bamboo frame ─────────────────────────────────── */
+.eg-khung {
+  position: relative;
+  width: 100%;
+  margin-top: 28px; /* Space for banner on top */
+}
+
+/* Crop wrapper: clips transparent canvas padding around khung artwork.
+   khung alpha bbox: L=9.05% T=19.5% R=9.7% B=19.3% of canvas.
+   Negative margins pull content inward to hide transparent zones. */
+.eg-khung__crop {
+  overflow: hidden;
+  margin: -19.5% -9% -19.3% -9%;
+}
+
+.eg-khung__img {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+/* Content layer over the frame image.
+   Parchment safe-area measured at canvas coords L=16.7% T=24% R=16.5% B=26.7%.
+   After crop margins collapse the canvas, we must express these as percentage
+   of the CROPPED container (which represents the full canvas still in img flow).
+   Since crop uses negative margins on the img (not on this absolute parent),
+   the .eg-khung is still sized by the full canvas image.
+   So percentages are relative to full canvas. */
+.eg-khung__content {
+  position: absolute;
+  top: 27%;
+  left: 18%;
+  right: 18%;
+  bottom: 22%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+}
+
+/* ── Banner on top of frame ───────────────────────── */
+/* bangten alpha bbox: L=9.3% T=32.9% R=9.8% B=37.6% */
+.eg-banner {
+  position: absolute;
+  top: 6px;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 68%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  animation: egBannerIn 0.38s 0.18s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+  pointer-events: none;
+  z-index: 10;
+}
+
+.eg-banner__crop {
+  overflow: hidden;
+  margin: -32.9% -9.3% -37.6% -9.3%;
+  width: 100%;
+}
+
+.eg-banner__img {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.eg-banner__text {
+  position: absolute;
+  top: 44%;
+  left: 50%;
+  transform: translate(-50%, -50%);
+  font-size: clamp(18px, 3.5vw, 28px);
+  font-weight: 900;
+  color: #ffffff;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  text-shadow:
+    0 2px 0 rgba(25, 80, 25, 0.9),
+    0 4px 8px rgba(10, 50, 10, 0.4);
+  white-space: nowrap;
+}
+
+/* ── Win title (HOÀN THÀNH!) ──────────────────────── */
+.eg-win-title {
+  font-size: clamp(22px, 5vw, 38px);
+  font-weight: 900;
+  color: #7a4a1a;
+  text-transform: uppercase;
+  text-align: center;
+  margin-bottom: 2px;
+  line-height: 1.1;
+  text-shadow:
+    0 2px 0 rgba(255, 220, 150, 0.5),
+    0 4px 6px rgba(80, 30, 0, 0.2);
+}
+
+/* ── Lose title image ─────────────────────────────── */
+.eg-lose-title {
+  font-size: clamp(36px, 8vw, 56px);
+  font-weight: 900;
+  color: #ff3333;
+  text-transform: uppercase;
+  text-align: center;
+  margin-bottom: 8px;
+  -webkit-text-stroke: 1.5px #7a1000;
+  text-shadow:
+    0 2px 0 #ff8866,
+    0 5px 0 #881100,
+    0 6px 4px rgba(0,0,0,0.5);
+  font-family: inherit;
+}
+
+/* The "HẾT MẠNG!" banner wrapper — same pattern as .eg-banner */
+.eg-lose-banner {
+  position: absolute;
+  top: -14px;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 75%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  animation: egBannerIn 0.38s 0.1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+  pointer-events: none;
+  z-index: 10;
+}
+
+.eg-lose-title-img {
+  display: block;
+  width: 100%;
+  height: auto;
+  filter: drop-shadow(0 6px 14px rgba(0,0,0,0.45));
+}
+
+/* ── Subtitle ─────────────────────────────────────── */
+.eg-win-sub, .eg-lose-sub {
+  font-size: clamp(12px, 2.5vw, 17px);
+  font-weight: 700;
+  color: #7a4a1a;
+  text-align: center;
+  margin-bottom: 4px;
+  letter-spacing: 0.01em;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.eg-leaf-icon {
+  color: #65a12a;
+  font-size: 0.8em;
+}
+.eg-lose-sub .eg-leaf-icon {
+  color: #8c6a45;
+}
+
+/* ── Badge ────────────────────────────────────────── */
+.eg-badge {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  background: #fdf3d8;
+  border: 2px solid #d4a66a;
+  border-radius: 50px;
+  padding: 4px 16px 4px 6px;
+  font-weight: 700;
+  color: #7a4a1a;
+  box-shadow: inset 0 2px 4px rgba(255,255,255,0.8), 0 4px 6px rgba(0,0,0,0.15);
+  margin-bottom: 12px;
+  font-size: clamp(12px, 2.5vw, 16px);
+}
+
+.eg-badge__icon {
+  width: 32px;
+  height: 32px;
+  background: #eab76a;
+  border-radius: 50%;
+  border: 2px solid #b77935;
+  box-shadow: 0 2px 2px rgba(0,0,0,0.2);
+}
+
+/* ── Stars row ────────────────────────────────────── */
+.eg-stars {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: clamp(2px, 1.5vw, 10px);
+  margin: 4px 0 8px;
+}
+
+/* Star crop: sao artwork = 482×466 in 1536×1024 canvas (31.4% × 45.5%).
+   L=34% T=22% R=34.6% B=32.6% padding. Crop to show just the star. */
+.eg-star-crop {
+  width: clamp(52px, 10vw, 90px);
+  overflow: hidden;
+  margin: -22% -34% -32.6% -34%;
+  flex-shrink: 0;
+}
+
+.eg-star {
+  display: block;
+  width: 100%;
+  height: auto;
+  opacity: 0;
+  transform: scale(0) rotate(-20deg);
+  transition: none;
+  filter: drop-shadow(0 4px 6px rgba(180, 100, 0, 0.45));
+}
+
+.eg-star--in {
+  animation: egStarPop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+.eg-star--empty {
+  filter: grayscale(1) brightness(0.7) drop-shadow(0 2px 3px rgba(0,0,0,0.2));
+}
+
+/* ── Action buttons row ───────────────────────────── */
+.eg-actions {
+  display: flex;
+  flex-direction: row;
+  gap: clamp(6px, 2vw, 14px);
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  margin-top: 4px;
+}
+
+.eg-actions--vertical {
+  flex-direction: column;
+  gap: 10px;
+  margin-top: 8px;
+  align-items: center;
+}
+
+/* Image-backed button — no forced aspect ratio */
+.eg-btn {
+  position: relative;
+  flex: 1;
+  max-width: 240px;
+  min-width: 0;
+  padding: 0;
+  border: none;
+  background: transparent;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: transform 0.12s ease, filter 0.12s ease;
+}
+
+.eg-btn:hover:not(:disabled) {
+  transform: translateY(-2px) scale(1.04);
+  filter: brightness(1.08);
+}
+
+.eg-btn:active:not(:disabled) {
+  transform: translateY(2px) scale(0.97);
+  filter: brightness(0.96);
+}
+
+/* Lose screen buttons are wider */
+.eg-btn--lose {
+  max-width: 280px;
+  width: 80%;
+  aspect-ratio: 3.5 / 1;
+}
+
+/* Crop wrapper for button PNG — clips transparent padding.
+   continue.png artwork: L=13.1% T=30.3% R=13.3% B=34.2%
+   again.png artwork:    L=16.9% T=34.3% R=16.8% B=38.1% */
+.eg-btn__crop {
+  width: 100%;
+  overflow: hidden;
+  border-radius: 8px;
+}
+
+.eg-btn__crop--green {
+  margin: -30.3% -13.1% -34.2% -13.1%;
+}
+
+.eg-btn__crop--orange {
+  margin: -34.3% -16.9% -38.1% -16.8%;
+}
+
+.eg-btn__bg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.eg-btn__label {
+  position: absolute;
+  z-index: 1;
+  top: 50%;
+  left: 50%;
+  transform: translate(-50%, -55%);
+  font-size: clamp(13px, 2.8vw, 20px);
+  font-weight: 900;
+  letter-spacing: 0.02em;
+  white-space: nowrap;
+  line-height: 1;
+}
+
+.eg-btn__label--green {
+  color: #ffffff;
+  text-shadow:
+    0 2px 0 rgba(30, 90, 30, 0.9),
+    0 4px 8px rgba(15, 60, 15, 0.35);
+}
+
+.eg-btn__label--orange {
+  color: #ffffff;
+  text-shadow:
+    0 2px 0 rgba(120, 55, 0, 0.9),
+    0 4px 8px rgba(80, 35, 0, 0.35);
+}
+
+.eg-btn__label--white {
+  color: #ffffff;
+  text-shadow:
+    0 2px 0 rgba(150, 20, 0, 0.9),
+    0 4px 6px rgba(100, 10, 0, 0.5);
+}
+
+.eg-btn__label--brown {
+  color: #5a2c0a;
+  text-shadow: none;
+}
+
+/* ── Vine corner decorations ──────────────────────── */
+/* decorate.png artwork at (378,115)→(1039,816) = 662×702 in 1536×1024
+   L=24.6% T=11.2% R=32.4% B=20.3%
+   The artwork is an L-shaped vine positioned in the top-left quadrant. */
+.eg-decorate {
+  position: absolute;
+  width: 28%;
+  pointer-events: none;
+  z-index: 10;
+  overflow: hidden;
+}
+
+.eg-decorate__img {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.eg-decorate--tl {
+  top: 0;
+  left: -2%;
+  /* Crop right and bottom transparent padding */
+  margin: -11.2% -32.4% -20.3% -24.6%;
+}
+
+.eg-decorate--br {
+  bottom: 0;
+  right: -2%;
+  /* Flipped + crop */
+  margin: -11.2% -24.6% -20.3% -32.4%;
+}
+
+.eg-decorate--br .eg-decorate__img {
+  transform: scaleX(-1) scaleY(-1);
+}
+
+/* ══════════════════════════════════════════════════
+   PAUSE OVERLAY — Jungle style
+   ══════════════════════════════════════════════════ */
+
+.tribe-pause-panel--jungle {
+  position: relative;
+  display: flex;
+  width: min(480px, calc(100% - 24px));
+  min-height: 220px;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 24px;
+  padding: 32px 28px 28px;
+  /* Parchment/jungle style instead of white */
+  border: 4px solid #bc7924;
+  border-radius: 28px;
+  background: linear-gradient(180deg, #fde8b0 0%, #f5d48a 40%, #e6c06e 100%);
+  box-shadow:
+    inset 0 4px 0 rgba(255, 245, 200, 0.7),
+    0 8px 0 rgba(78, 43, 6, 0.75),
+    0 24px 54px rgba(42, 36, 24, 0.42);
+  box-sizing: border-box;
+  animation: tribeOverlayIn 0.38s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+.tribe-pause-panel__title--jungle {
+  margin: 0;
+  color: #5d2b0a;
+  font-size: clamp(26px, 5vw, 36px);
+  font-weight: 900;
+  line-height: 1;
+  letter-spacing: 0.03em;
+  text-transform: uppercase;
+  text-align: center;
+  text-shadow:
+    0 2px 0 rgba(255, 220, 150, 0.5),
+    0 4px 6px rgba(80, 30, 0, 0.18);
+}
+
+.tribe-pause-panel__buttons {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 16px;
+  width: 100%;
+}
+
+/* Pause buttons reuse EndGame button asset pattern */
+.tribe-pause-btn {
+  position: relative;
+  flex: 1;
+  max-width: 200px;
+  padding: 0;
+  border: none;
+  background: transparent;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: transform 0.12s ease, filter 0.12s ease;
+}
+
+.tribe-pause-btn:hover {
+  transform: translateY(-2px) scale(1.04);
+  filter: brightness(1.08);
+}
+
+.tribe-pause-btn:active {
+  transform: translateY(2px) scale(0.97);
+  filter: brightness(0.96);
+}
+
+.tribe-pause-btn:focus-visible {
+  outline: 3px solid #ffffff;
+  outline-offset: 3px;
+}
+
+.tribe-pause-btn__crop {
+  width: 100%;
+  overflow: hidden;
+  border-radius: 8px;
+}
+
+.tribe-pause-btn__crop--green {
+  margin: -30.3% -13.1% -34.2% -13.1%;
+}
+
+.tribe-pause-btn__crop--orange {
+  margin: -34.3% -16.9% -38.1% -16.8%;
+}
+
+.tribe-pause-btn__bg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.tribe-pause-btn__label {
+  position: absolute;
+  z-index: 1;
+  top: 50%;
+  left: 50%;
+  transform: translate(-50%, -55%);
+  font-size: clamp(14px, 3vw, 20px);
+  font-weight: 900;
+  letter-spacing: 0.02em;
+  white-space: nowrap;
+  line-height: 1;
+}
+
+.tribe-pause-btn__label--green {
+  color: #ffffff;
+  text-shadow:
+    0 2px 0 rgba(30, 90, 30, 0.9),
+    0 4px 8px rgba(15, 60, 15, 0.35);
+}
+
+.tribe-pause-btn__label--orange {
+  color: #ffffff;
+  text-shadow:
+    0 2px 0 rgba(120, 55, 0, 0.9),
+    0 4px 8px rgba(80, 35, 0, 0.35);
+}
+
+/* ── Responsive — End Game + Pause ────────────────── */
+@media (max-width: 480px) {
+  .eg-card-wrap {
+    width: calc(100vw - 20px);
+  }
+
+  .eg-banner {
+    width: 78%;
+  }
+
+  .eg-banner__text {
+    font-size: clamp(14px, 5vw, 22px);
+  }
+
+  .eg-actions {
+    gap: 6px;
+  }
+
+  .eg-win-title {
+    font-size: clamp(18px, 6vw, 28px);
+    margin-bottom: 2px;
+  }
+
+  .eg-win-sub {
+    font-size: clamp(11px, 3vw, 14px);
+  }
+
+  .eg-star-crop {
+    width: clamp(44px, 11vw, 70px);
+  }
+
+  .eg-stars {
+    margin: 2px 0 6px;
+  }
+
+  .eg-btn {
+    max-width: 180px;
+  }
+
+  .eg-btn__label {
+    font-size: clamp(11px, 3.5vw, 15px);
+  }
+
+  .eg-btn--lose {
+    max-width: 240px;
+    width: 85%;
+  }
+
+  .tribe-pause-panel--jungle {
+    width: min(360px, calc(100% - 16px));
+    min-height: 180px;
+    gap: 18px;
+    padding: 24px 18px 20px;
+    border-radius: 22px;
+  }
+
+  .tribe-pause-panel__title--jungle {
+    font-size: clamp(22px, 6vw, 30px);
+  }
+
+  .tribe-pause-panel__buttons {
+    gap: 10px;
+  }
+
+  .tribe-pause-btn {
+    max-width: 160px;
+  }
+
+  .tribe-pause-btn__label {
+    font-size: clamp(12px, 4vw, 16px);
+  }
+}
+
+@media (max-height: 600px) and (orientation: landscape) {
+  .eg-card-wrap {
+    width: min(520px, calc(100vw - 40px));
+  }
+
+  .eg-khung {
+    margin-top: 20px;
+  }
+
+  .eg-khung__content {
+    top: 26%;
+    bottom: 23%;
+  }
+
+  .eg-win-title {
+    font-size: clamp(18px, 4vw, 26px);
+    margin-bottom: 2px;
+  }
+
+  .eg-win-sub {
+    font-size: clamp(10px, 2vw, 13px);
+  }
+
+  .eg-star-crop {
+    width: clamp(36px, 8vw, 56px);
+  }
+
+  .eg-stars {
+    margin: 2px 0 4px;
+  }
+
+  .eg-banner {
+    top: 0;
+    width: 56%;
+  }
+
+  .eg-banner__text {
+    font-size: clamp(13px, 3vw, 20px);
+  }
+
+  .eg-btn {
+    max-width: 170px;
+  }
+
+  .eg-btn__label {
+    font-size: clamp(11px, 2.5vw, 15px);
+  }
+
+  .eg-actions {
+    gap: 8px;
+  }
+
+  .eg-actions--vertical {
+    gap: 6px;
+    margin-top: 4px;
+  }
+
+  .tribe-pause-panel--jungle {
+    width: min(380px, calc(100% - 16px));
+    min-height: 160px;
+    gap: 14px;
+    padding: 20px 16px 16px;
+    border-radius: 20px;
+  }
+
+  .tribe-pause-panel__title--jungle {
+    font-size: clamp(20px, 4vw, 28px);
+  }
+
+  .tribe-pause-btn {
+    max-width: 150px;
+  }
+
+  .tribe-pause-btn__label {
+    font-size: clamp(11px, 2.5vw, 15px);
+  }
+}
+
